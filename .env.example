# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.
# Aquí solo van los NOMBRES de las variables, sin valores.
# Las variables secretas NO llevan prefijo PUBLIC_ (ese prefijo las expone en el navegador).

# --- Base de datos (solo tienda, si se necesita) ---
DATABASE_URL=

# --- Pagos en sandbox (solo tienda) ---
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# --- Imágenes (solo para el script local de descarga) ---
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
THECATAPI_KEY=

# --- Formulario de contacto (si el servicio lo pide) ---
FORM_ENDPOINT=
