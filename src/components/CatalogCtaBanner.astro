---
import { Image } from 'astro:assets';
import imgBeagle from '../assets/banner-animals/banner-pet-beagle.jpg';
import imgCatHappy from '../assets/banner-animals/banner-pet-cat-happy.jpg';
import imgCorgi from '../assets/banner-animals/banner-pet-corgi.jpg';
import imgCatTabby from '../assets/banner-animals/banner-pet-cat-tabby.jpg';
---

<section
  id="cta-catalogo"
  class="w-full py-12 sm:py-16 lg:py-20 my-4 sm:my-8 bg-transparent overflow-hidden"
>
  <div
    class="w-full px-4 sm:px-8 md:px-12 lg:px-10 xl:px-16 2xl:px-24 flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-6 xl:gap-12"
  >
    {/* 1. Flanco Izquierdo: Dos arcos generosos (Beagle + Gato feliz) */}
    <div
      class="flex items-end justify-center lg:justify-start gap-3 sm:gap-5 md:gap-6 shrink-0 order-2 lg:order-1"
    >
      {/* Arco 1: Beagle cachorro */}
      <div
        class="w-28 sm:w-36 md:w-44 lg:w-44 xl:w-52 2xl:w-60 h-40 sm:h-52 md:h-64 lg:h-64 xl:h-76 2xl:h-84 rounded-t-full rounded-b-3xl overflow-hidden shadow-xs hover:shadow-lg hover:-translate-y-2 transition-all duration-300 border border-stone-200/60 dark:border-slate-800"
      >
        <Image
          src={imgBeagle}
          alt="Cachorro Beagle con orejas al viento"
          width={420}
          height={600}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      {/* Arco 2: Gato feliz relamiéndose */}
      <div
        class="w-28 sm:w-36 md:w-44 lg:w-44 xl:w-52 2xl:w-60 h-40 sm:h-52 md:h-64 lg:h-64 xl:h-76 2xl:h-84 rounded-t-full rounded-b-3xl overflow-hidden shadow-xs hover:shadow-lg hover:-translate-y-2 transition-all duration-300 border border-stone-200/60 dark:border-slate-800"
      >
        <Image
          src={imgCatHappy}
          alt="Gatito gris feliz relamiéndose"
          width={420}
          height={600}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    {
      /* 2. Centro: Mensaje emocional ampliado + Botón CTA con círculo blanco y flecha roja */
    }
    <div
      class="text-center max-w-lg lg:max-w-xl xl:max-w-2xl px-2 py-4 shrink order-1 lg:order-2 space-y-4 sm:space-y-5"
    >
      <h2
        class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl xl:text-5xl font-black text-stone-900 dark:text-white tracking-tight leading-tight"
      >
        Porque tus peluditos merecen lo mejor, siempre.
      </h2>
      <p
        class="text-xs sm:text-sm md:text-base lg:text-lg text-stone-600 dark:text-slate-300 max-w-md lg:max-w-lg mx-auto leading-relaxed"
      >
        Nutrición premium, juguetes, camas y accesorios seleccionados para
        cuidar su felicidad en cada etapa.
      </p>

      {/* Botón CTA destacado estilo píldora con flecha en círculo */}
      <div class="pt-2 sm:pt-4">
        <a
          href="/catalogo"
          class="inline-flex items-center gap-3 sm:gap-4 pl-7 sm:pl-8 pr-2.5 sm:pr-3 py-2.5 sm:py-3 rounded-full bg-brand-primary text-white font-extrabold text-sm sm:text-base lg:text-lg shadow-md hover:bg-rose-700 hover:shadow-xl hover:scale-104 transition-all duration-300 cursor-pointer group"
        >
          <span>Ver todo el catálogo</span>
          <span
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white text-brand-primary flex items-center justify-center font-black shadow-xs group-hover:translate-x-1 transition-transform"
            aria-hidden="true"
          >
            <svg
              class="w-4 h-4 sm:w-5 sm:h-5 stroke-current stroke-3 fill-none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>

    {
      /* 3. Flanco Derecho: Dos arcos generosos (Corgi sonriente + Gato atigrado) */
    }
    <div
      class="flex items-end justify-center lg:justify-end gap-3 sm:gap-5 md:gap-6 shrink-0 order-3"
    >
      {/* Arco 3: Corgi sonriente */}
      <div
        class="w-28 sm:w-36 md:w-44 lg:w-44 xl:w-52 2xl:w-60 h-40 sm:h-52 md:h-64 lg:h-64 xl:h-76 2xl:h-84 rounded-t-full rounded-b-3xl overflow-hidden shadow-xs hover:shadow-lg hover:-translate-y-2 transition-all duration-300 border border-stone-200/60 dark:border-slate-800"
      >
        <Image
          src={imgCorgi}
          alt="Perro Corgi sonriendo con pelaje dorado"
          width={420}
          height={600}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      {/* Arco 4: Gato atigrado de perfil */}
      <div
        class="w-28 sm:w-36 md:w-44 lg:w-44 xl:w-52 2xl:w-60 h-40 sm:h-52 md:h-64 lg:h-64 xl:h-76 2xl:h-84 rounded-t-full rounded-b-3xl overflow-hidden shadow-xs hover:shadow-lg hover:-translate-y-2 transition-all duration-300 border border-stone-200/60 dark:border-slate-800"
      >
        <Image
          src={imgCatTabby}
          alt="Gato atigrado mirando hacia el centro"
          width={420}
          height={600}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
