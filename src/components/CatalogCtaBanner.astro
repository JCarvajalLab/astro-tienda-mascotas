---
import { Image } from 'astro:assets';
import imgBeagle from '../assets/banner-animals/banner-pet-beagle.jpg';
import imgCatHappy from '../assets/banner-animals/banner-pet-cat-happy.jpg';
import imgCorgi from '../assets/banner-animals/banner-pet-corgi.jpg';
import imgCatTabby from '../assets/banner-animals/banner-pet-cat-tabby.jpg';
---

<section
  id="cta-catalogo"
  class="py-12 sm:py-16 my-6 bg-linear-to-b from-stone-50/60 via-white to-stone-50/40 overflow-hidden"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-6"
  >
    {/* 1. Flanco Izquierdo: Dos arcos (Beagle + Gato feliz) */}
    <div class="flex items-end justify-center gap-3 sm:gap-4 shrink-0 order-2 lg:order-1">
      {/* Arco 1: Beagle cachorro */}
      <div
        class="w-24 sm:w-28 md:w-32 lg:w-36 h-36 sm:h-44 md:h-48 lg:h-56 rounded-t-full rounded-b-2xl overflow-hidden shadow-xs hover:shadow-md hover:-translate-y-1.5 transition-all duration-300 border border-stone-200/60"
      >
        <Image
          src={imgBeagle}
          alt="Cachorro Beagle con orejas al viento"
          width={280}
          height={400}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      {/* Arco 2: Gato feliz relamiéndose */}
      <div
        class="w-24 sm:w-28 md:w-32 lg:w-36 h-36 sm:h-44 md:h-48 lg:h-56 rounded-t-full rounded-b-2xl overflow-hidden shadow-xs hover:shadow-md hover:-translate-y-1.5 transition-all duration-300 border border-stone-200/60"
      >
        <Image
          src={imgCatHappy}
          alt="Gatito gris feliz relamiéndose"
          width={280}
          height={400}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    {/* 2. Centro: Mensaje emocional + Botón CTA con círculo blanco y flecha roja */}
    <div class="text-center max-w-md px-2 py-2 shrink order-1 lg:order-2 space-y-4">
      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-stone-900 tracking-tight leading-tight"
      >
        Porque tus peluditos merecen lo mejor, siempre.
      </h2>
      <p class="text-xs sm:text-sm text-stone-500 max-w-sm mx-auto leading-relaxed">
        Nutrición premium, juguetes, camas y accesorios seleccionados para cuidar su felicidad en cada etapa.
      </p>

      {/* Botón CTA destacado estilo píldora con flecha en círculo */}
      <div class="pt-2">
        <a
          href="#ofertas"
          class="inline-flex items-center gap-3 pl-6 pr-2 py-2 rounded-full bg-brand-primary text-white font-extrabold text-sm sm:text-base shadow-md hover:bg-rose-700 hover:shadow-lg hover:scale-103 transition-all duration-300 cursor-pointer group"
        >
          <span>Ver todo el catálogo</span>
          <span
            class="w-8 h-8 rounded-full bg-white text-brand-primary flex items-center justify-center font-black shadow-xs group-hover:translate-x-0.5 transition-transform"
            aria-hidden="true"
          >
            <svg
              class="w-4 h-4 stroke-current stroke-3 fill-none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </span>
        </a>
      </div>
    </div>

    {/* 3. Flanco Derecho: Dos arcos (Corgi sonriente + Gato atigrado) */}
    <div class="flex items-end justify-center gap-3 sm:gap-4 shrink-0 order-3">
      {/* Arco 3: Corgi sonriente */}
      <div
        class="w-24 sm:w-28 md:w-32 lg:w-36 h-36 sm:h-44 md:h-48 lg:h-56 rounded-t-full rounded-b-2xl overflow-hidden shadow-xs hover:shadow-md hover:-translate-y-1.5 transition-all duration-300 border border-stone-200/60"
      >
        <Image
          src={imgCorgi}
          alt="Perro Corgi sonriendo con pelaje dorado"
          width={280}
          height={400}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      {/* Arco 4: Gato atigrado de perfil */}
      <div
        class="w-24 sm:w-28 md:w-32 lg:w-36 h-36 sm:h-44 md:h-48 lg:h-56 rounded-t-full rounded-b-2xl overflow-hidden shadow-xs hover:shadow-md hover:-translate-y-1.5 transition-all duration-300 border border-stone-200/60"
      >
        <Image
          src={imgCatTabby}
          alt="Gato atigrado mirando hacia el centro"
          width={280}
          height={400}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
