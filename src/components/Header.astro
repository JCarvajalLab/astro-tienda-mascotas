</header>

<!-- Script interactivo del Header (Selector de región / Comuna y cierre accesible) -->
<script>
  // Toggle del dropdown de comuna de Chile
  const regionBtn = document.getElementById('region-selector-btn');
  const regionDropdown = document.getElementById('region-dropdown');
  const selectedRegionText = document.getElementById('selected-region-text');
  const comunaButtons = document.querySelectorAll('.comuna-option-btn');

  // Recuperar comuna guardada o usar la inicial
  const savedComuna = localStorage.getItem('user_comuna');
  if (savedComuna && selectedRegionText) {
    selectedRegionText.textContent = savedComuna;
  }

  if (regionBtn && regionDropdown) {
    regionBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = regionBtn.getAttribute('aria-expanded') === 'true';
      regionBtn.setAttribute('aria-expanded', String(!isExpanded));
      regionDropdown.classList.toggle('hidden');
    });

    // Cerrar al hacer clic fuera
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (
        target instanceof Node &&
        !regionBtn.contains(target) &&
        !regionDropdown.contains(target)
      ) {
        regionDropdown.classList.add('hidden');
        regionBtn.setAttribute('aria-expanded', 'false');
      }
    });

    // Seleccionar comuna
    comunaButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const comuna = btn.getAttribute('data-comuna');
        if (comuna && selectedRegionText) {
          selectedRegionText.textContent = comuna;
          localStorage.setItem('user_comuna', comuna);
          regionDropdown.classList.add('hidden');
          regionBtn.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }
</script>
