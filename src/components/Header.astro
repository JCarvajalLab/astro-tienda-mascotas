const categoriasMenu = [
  {
    name: 'Mascotas',
    iconName: 'paw',
    href: '/categoria/mascotas',
    tagline: 'Nutrición y accesorios para cada etapa de su vida',
    destacado: {
      badge: 'Etapas de Vida',
      title: 'Especial Etapas de Vida',
      desc: 'Nutrición y bienestar diseñados a la medida de la edad y vitalidad de tu perro o gato.',
      cta: 'Ver Etapas',
      href: '/categoria/mascotas',
      image: packCachorro,
    },
    subcategorias: [
      {
        grupo: 'Perros por Etapa',
        items: [
          { label: 'Cachorros', desc: 'Nutrición y apego inicial', href: '/categoria/cachorros?pet=perros', icon: 'paw' },
          { label: 'Perros Adultos', desc: 'Energía y nutrición diaria', href: '/categoria/adultos?pet=perros', icon: 'bowl' },
          { label: 'Perros Senior (7+)', desc: 'Movilidad y cuidado articular', href: '/categoria/seniors?pet=perros', icon: 'heart' },
        ],
      },
      {
        grupo: 'Gatos por Etapa',
        items: [
          { label: 'Gatitos', desc: 'Crecimiento y primeras fórmulas', href: '/categoria/cachorros?pet=gatos', icon: 'paw' },
          { label: 'Gatos Adultos', desc: 'Esterilizados y peso óptimo', href: '/categoria/adultos?pet=gatos', icon: 'bowl' },
          { label: 'Gatos Senior (7+)', desc: 'Confort articular y descanso', href: '/categoria/seniors?pet=gatos', icon: 'heart' },
        ],
      },
    ],
  },
  {
    name: 'Perros',
    iconName: 'dog',
    href: '/categoria/perros',
    tagline: 'Alimentos premium, paseo seguro y descanso para tu perro',
    destacado: {
      badge: 'Hasta 32% OFF',
      title: 'Pack Bienvenida Cachorro',
