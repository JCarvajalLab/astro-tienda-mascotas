---

<header
  class="w-full bg-white dark:bg-stone-900 border-b border-stone-200 dark:border-stone-800 sticky top-0 z-50 shadow-xs transition-colors"
>
  <!-- NIVEL 1: Fila superior (Logo / Buscador / Comuna / Usuario / Carrito / Tema) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 sm:gap-6 py-3 sm:py-4">
      <!-- 1. Logo & Nombre -->
      <a
        href="/"
        class="flex items-center gap-2.5 shrink-0 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded-lg"
      >
        <span
          class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-tr from-orange-500 to-amber-400 flex items-center justify-center text-white shadow-md shadow-orange-500/20 group-hover:scale-105 transition-transform"
        >
          <svg
            class="w-6 h-6 fill-current"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12 8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-4.5 1a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm9 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM6 13a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm12 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm-6 1c-2.8 0-5 1.8-5 4.5 0 1.9 1.8 3.5 5 3.5s5-1.6 5-3.5c0-2.7-2.2-4.5-5-4.5Z"
            ></path>
          </svg>
        </span>
        <div class="flex flex-col">
          <span
            class="font-extrabold text-xl sm:text-2xl tracking-tight text-stone-900 dark:text-white leading-none"
          >
            Patitas<span class="text-orange-500 dark:text-orange-400"
              >&amp;Co.</span
            >
          </span>
          <span
            class="text-[10px] uppercase font-bold tracking-widest text-stone-400 dark:text-stone-500 mt-0.5"
          >
            Tienda de Mascotas
          </span>
        </div>
      </a>

      <!-- 2. Buscador de productos central -->
      <div class="hidden md:flex flex-1 max-w-xl mx-2">
        <form class="relative w-full" onsubmit="event.preventDefault();">
          <label for="site-search" class="sr-only"
            >Buscar alimentos, juguetes o accesorios</label
          >
          <input
            type="search"
            id="site-search"
            placeholder="Buscar alimento, snacks, rascadores, camas..."
            class="w-full pl-11 pr-24 py-2.5 rounded-full bg-stone-100 dark:bg-stone-800/80 border border-transparent focus:border-orange-400 dark:focus:border-orange-500 focus:bg-white dark:focus:bg-stone-800 text-stone-800 dark:text-stone-100 placeholder-stone-400 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/20 transition-all"
          />
          <div
            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
              ></path>
            </svg>
          </div>
          <button
            type="submit"
            class="absolute inset-y-1 right-1 px-4 rounded-full bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1 shadow-xs"
          >
            Buscar
          </button>
        </form>
      </div>

      <!-- Acciones de cabecera -->
      <div class="flex items-center gap-2 sm:gap-4 shrink-0">
        <!-- 3. Selección de Región / Comuna de Chile -->
        <div class="relative group hidden lg:block">
          <button
            type="button"
            id="region-selector-btn"
            class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-stone-200 dark:border-stone-700/80 hover:border-orange-300 dark:hover:border-orange-600/60 bg-stone-50/60 dark:bg-stone-800/50 hover:bg-white dark:hover:bg-stone-800 text-left transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <span class="text-orange-500 text-base">📍</span>
            <div class="flex flex-col">
              <span
                class="text-[10px] uppercase font-semibold text-stone-400 dark:text-stone-400 leading-none"
                >Enviar a</span
              >
              <span
                id="selected-region-text"
                class="text-xs font-bold text-stone-800 dark:text-stone-200 truncate max-w-[130px]"
              >
                Santiago - Providencia
              </span>
            </div>
            <svg
              class="w-3.5 h-3.5 text-stone-400 group-hover:text-orange-500 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m19 9-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown rápido de selección de comunas de Chile -->
          <div
            id="region-dropdown"
            class="hidden absolute right-0 mt-2 w-64 p-3 bg-white dark:bg-stone-800 rounded-2xl shadow-xl border border-stone-200 dark:border-stone-700 z-50 text-xs"
          >
            <p class="font-bold text-stone-900 dark:text-white mb-2">
              Selecciona tu comuna (Chile):
            </p>
            <div
              class="max-h-56 overflow-y-auto space-y-1 pr-1 custom-scrollbar"
            >
              {
                comunasChile.map((comuna) => (
                  <button
                    type="button"
                    data-comuna={comuna}
                    class="comuna-option-btn w-full text-left px-2.5 py-1.5 rounded-lg text-stone-700 dark:text-stone-200 hover:bg-orange-50 dark:hover:bg-orange-950/40 hover:text-orange-600 dark:hover:text-orange-400 transition-colors cursor-pointer flex items-center justify-between"
                  >
                    <span>{comuna}</span>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">
                      Envío 24h
                    </span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- 4. Iniciar sesión / Mi cuenta -->
        <a
          href="/#login"
          class="flex items-center gap-2 px-3 py-2 rounded-xl text-stone-700 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800 text-xs sm:text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500"
        >
          <svg
            class="w-5 h-5 text-stone-500 dark:text-stone-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
            ></path>
          </svg>
          <span class="hidden xl:inline">Iniciar sesión</span>
        </a>

        <!-- 5. Carrito de compras -->
        <button
          id="cart-button"
          type="button"
          aria-label="Ver carrito de compras"
          class="relative flex items-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 active:bg-orange-700 text-white font-bold text-xs sm:text-sm shadow-md shadow-orange-500/20 transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
            ></path>
          </svg>
          <span class="hidden sm:inline">Carrito</span>
          <span
            id="cart-count-badge"
            class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-extrabold leading-none text-orange-600 bg-white dark:bg-stone-900 rounded-full shadow-xs"
          >
            0
          </span>
        </button>

        <!-- 6. Modo claro / nocturno -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar tema de color"
          title="Modo claro / nocturno"
          class="p-2 sm:p-2.5 rounded-xl border border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 cursor-pointer"
        >
          <!-- Sol (visible en dark) -->
          <svg
            id="sun-icon"
            class="w-5 h-5 hidden dark:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Luna (visible en light) -->
          <svg
            id="moon-icon"
            class="w-5 h-5 block dark:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Buscador en móvil (visible solo en pantallas pequeñas) -->
    <div class="pb-3 md:hidden">
      <form class="relative w-full" onsubmit="event.preventDefault();">
        <label for="site-search-mobile" class="sr-only">Buscar productos</label>
        <input
          type="search"
          id="site-search-mobile"
          placeholder="Buscar alimento, juguetes, accesorios..."
          class="w-full pl-10 pr-20 py-2 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-800 dark:text-stone-100 text-xs focus:outline-none focus:ring-2 focus:ring-orange-500"
        />
        <div
          class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-stone-400"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
            ></path>
          </svg>
        </div>
        <button
          type="submit"
          class="absolute inset-y-1 right-1 px-3 rounded-lg bg-orange-500 text-white text-[11px] font-semibold"
        >
          Buscar
        </button>
      </form>
    </div>
  </div>

  <!-- NIVEL 2: Fila inferior (Categorías principales con Mega-Menú desplegable al hover) -->
  <nav
    class="bg-stone-50/90 dark:bg-stone-900/90 border-t border-stone-200/80 dark:border-stone-800/80 transition-colors"
    aria-label="Categorías de productos"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul
        class="flex items-center gap-1 sm:gap-2 overflow-x-auto py-1 scrollbar-none"
      >
        {
          categoriasMenu.map((cat) => (
            <li class="relative group/menu shrink-0">
              <a
                href={cat.href}
                class={`flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm font-semibold rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 ${
                  cat.isOffer
                    ? 'text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40'
                    : 'text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-white dark:hover:bg-stone-800'
                }`}
              >
                <span>{cat.icon}</span>
                <span>{cat.name}</span>
                <svg
                  class="w-3 h-3 text-stone-400 group-hover/menu:text-orange-500 group-hover/menu:rotate-180 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19 9-7 7-7-7"
                  />
                </svg>
              </a>

              <div class="invisible group-hover/menu:visible opacity-0 group-hover/menu:opacity-100 group-focus-within/menu:visible group-focus-within/menu:opacity-100 transition-all duration-200 transform translate-y-2 group-hover/menu:translate-y-0 absolute top-full left-0 w-80 sm:w-96 md:w-[480px] bg-white dark:bg-stone-900 rounded-2xl shadow-2xl border border-stone-200 dark:border-stone-700 p-5 z-50">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-stone-100 dark:border-stone-800">
                  <div class="flex items-center gap-2">
                    <span class="text-xl">{cat.icon}</span>
                    <span class="font-bold text-sm text-stone-900 dark:text-white">
                      Todo en {cat.name}
                    </span>
                  </div>
                  <a
                    href={cat.href}
                    class="text-xs font-semibold text-orange-600 dark:text-orange-400 hover:underline"
                  >
                    Ver todo →
                  </a>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  {cat.subcategorias.map((sub) => (
                    <div class="space-y-1.5">
                      <h4 class="text-xs font-extrabold uppercase tracking-wider text-orange-600 dark:text-orange-400">
                        {sub.grupo}
                      </h4>
                      <ul class="space-y-1">
                        {sub.items.map((item) => (
