                          </div>
                          <div class="space-y-1">
                            {sub.items.map((it) => (
                              <a
                                href={it.href}
                                class="p-2 rounded-xl hover:bg-rose-50/90 dark:hover:bg-[#4c111a]/40 border border-transparent hover:border-rose-100 dark:hover:border-[#4c111a]/60 transition-all group flex items-start gap-2.5"
                              >
                                <div class="w-7 h-7 rounded-lg bg-stone-100 dark:bg-[#27201c] group-hover:bg-rose-100 dark:group-hover:bg-[#4c111a]/60 text-stone-600 dark:text-[#e4dcd3] group-hover:text-rose-600 dark:group-hover:text-rose-300 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                                  {it.icon === 'bowl' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
