          { label: 'Torres Rascador Sisal', desc: 'Multinivel para afilar uñas', href: '/categoria/rascadores-camas', icon: 'bed' },
          { label: 'Fuentes de Agua Eléctricas', desc: 'Hidratación fresca continua', href: '/categoria/hidratacion', icon: 'tech' },
        ],
      },
    ],
  },
  {
    name: 'Accesorios',
    iconName: 'tennis',
    href: '/categoria/accesorios',
    tagline: 'Accesorios de paseo, confort y tecnología inteligente',
    destacado: {
      badge: 'Temporada',
      title: 'Pack Paseo Seguro & Aventura',
      desc: 'Arnés antitirones, correa reflectante y accesorios.',
      cta: 'Ver Accesorios',
      href: '/categoria/accesorios',
      image: packPaseo,
    },
    subcategorias: [
      {
        grupo: 'Paseo & Seguridad',
        items: [
          { label: 'Arneses Ergonómicos', desc: 'Ajuste antitirones transpirable', href: '/categoria/paseo-seguridad', icon: 'shield' },
          { label: 'Collares Reflectantes', desc: 'Seguridad en paseos nocturnos', href: '/categoria/paseo-seguridad', icon: 'sparkles' },
          { label: 'Mochilas Transportadoras', desc: 'Ventilación panorámica para viajes', href: '/categoria/viajes-paseo', icon: 'pack' },
        ],
      },
      {
        grupo: 'Confort & Smart Pet',
        items: [
          { label: 'Camas Viscoelásticas', desc: 'Alivio de presión y descanso', href: '/categoria/camas-confort', icon: 'bed' },
          { label: 'Comederos WiFi', desc: 'Porciones programables por app', href: '/categoria/smart-pet', icon: 'tech' },
          { label: 'Mantas Térmicas Sherpa', desc: 'Felpa térmica lavable', href: '/categoria/camas-confort', icon: 'sparkles' },
        ],
      },
    ],
  },
  {
