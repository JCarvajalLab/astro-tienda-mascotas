          'Areneros Cerrados',
          'Palas & Filtros',
        ],
      },
      {
        grupo: 'Rascadores & Camas',
        items: [
          'Torres Rascador Multinivel',
          'Hamacas para Ventana',
          'Camas Cueva Térmicas',
          'Postes de Sisal',
        ],
      },
      {
        grupo: 'Juegos & Bienestar',
        items: [
          'Cañas & Plumas',
          'Juguetes con Catnip',
          'Túneles Plegables',
          'Fuentes de Agua Eléctricas',
        ],
      },
    ],
  },
  {
    name: 'Accesorios',
    icon: '🎾',
    href: '/#accesorios',
    subcategorias: [
      {
        grupo: 'Camas & Descanso',
        items: [
          'Camas Viscoelásticas',
          'Mantas Térmicas',
          'Colchonetas Impermeables',
        ],
      },
      {
        grupo: 'Juguetes Interactivos',
        items: [
          'Dispensadores de Premios',
          'Puzzles de Inteligencia',
          'Lanzadores de Pelotas',
        ],
      },
      {
        grupo: 'Paseo & Ropa',
        items: [
          'Capas de Lluvia',
          'Chalecos de Invierno',
          'Botines Protectores',
          'Bandanas',
        ],
      },
      {
        grupo: 'Comederos & Viaje',
        items: [
          'Comederos Lentos Antivoracidad',
          'Fuentes de Agua',
          'Mochilas & Transportines',
          'Cinturones Auto',
        ],
      },
    ],
  },
  {
    name: 'Farmacia & Salud',
    icon: '🩺',
    href: '/#salud',
    subcategorias: [
      {
        grupo: 'Antiparasitarios',
        items: [
          'Pipetas Pulgas & Garrapatas',
          'Pastillas Masticables',
          'Collares Antiparasitarios',
        ],
      },
      {
        grupo: 'Suplementos',
        items: [
          'Omega 3 & Aceite de Salmón',
          'Condroprotectores Articulares',
          'Probióticos Digestivos',
        ],
      },
      {
        grupo: 'Cuidado Especial',
        items: [
          'Limpiadores Óticos',
          'Lágrimas Artificiales',
          'Sprays Cicatrizantes Naturales',
        ],
      },
    ],
  },
  {
    name: 'Pequeñas Mascotas',
    icon: '🐰',
    href: '/#pequenas-mascotas',
    subcategorias: [
