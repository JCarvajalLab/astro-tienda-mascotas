  {
    name: 'Perros',
    icon: '🐶',
    href: '/#perros',
    subcategorias: [
      {
        grupo: 'Alimentos & Snacks',
        items: [
          'Alimento Seco Premium',
          'Comida Húmeda & Latas',
          'Snacks Dentales',
          'Fórmulas Cachorros',
        ],
      },
      {
        grupo: 'Paseo & Accesorios',
        items: [
          'Arneses Antitirones',
          'Correas Extensibles',
          'Collares Reflectantes',
          'Bolsas Biodegradables',
        ],
      },
      {
        grupo: 'Descanso & Juguetes',
        items: [
          'Camas Ortopédicas',
          'Juguetes Mordedores KONG',
          'Pelotas & Cuerdas',
          'Casas de Exterior',
        ],
      },
      {
        grupo: 'Higiene & Salud',
        items: [
          'Shampoos Hipoalergénicos',
          'Antipulgas & Pipetas',
          'Cepillos & Cortauñas',
          'Cuidado Dental',
        ],
      },
    ],
  },
  {
    name: 'Gatos',
    icon: '🐱',
    href: '/#gatos',
    subcategorias: [
      {
        grupo: 'Alimentos',
        items: [
          'Alimento Seco Esterilizados',
          'Sobres & Paté',
          'Snacks Cremosos Churu',
          'Gatitos Kitten',
        ],
