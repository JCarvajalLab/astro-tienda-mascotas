        grupo: 'Conejos & Cobayas',
        items: [
          'Heno Festuca & Alfalfa',
          'Pienso Prensado',
          'Bebederos de Goteo',
          'Sustrato de Papel',
        ],
      },
      {
        grupo: 'Aves & Otros',
        items: [
          'Semillas & Mixturas',
