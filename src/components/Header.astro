                aria-haspopup="true"
              >
                {cat.iconName === 'paw' && (
                  <svg class="w-3.5 h-3.5 stroke-current stroke-2 shrink-0" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 14c-2.21 0-4 1.79-4 4 0 .55.45 1 1 1h6c.55 0 1-.45 1-1 0-2.21-1.79-4-4-4ZM7 11.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM10.5 7.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM13.5 7.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM17 11.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
                  </svg>
                )}
                {cat.iconName === 'dog' && (
                  <svg class="w-3.5 h-3.5 stroke-current stroke-2 shrink-0" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5h3m-6.75-6a4.5 4.5 0 1 1 9 0v3.75a2.25 2.25 0 0 1-2.25 2.25h-4.5A2.25 2.25 0 0 1 6.75 17.25V13.5ZM4.5 9.75l2.25 3.75m10.5-3.75 2.25 3.75" />
                  </svg>
                )}
                {cat.iconName === 'cat' && (
                  <svg class="w-3.5 h-3.5 stroke-current stroke-2 shrink-0" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6V6l-3.75 3h-4.5L6 6v6.75a6 6 0 0 0 6 6Z" />
                  </svg>
                )}
                {cat.iconName === 'tennis' && (
                  <svg class="w-3.5 h-3.5 stroke-current stroke-2 shrink-0" fill="none" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" />
                    <path stroke-linecap="round" d="M5.5 5.5a12 12 0 0 1 0 13M18.5 5.5a12 12 0 0 0 0 13" />
                  </svg>
                )}
                {cat.iconName === 'health' && (
                  <svg class="w-3.5 h-3.5 stroke-current stroke-2 shrink-0" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                )}
                {cat.iconName === 'flame' && (
                  <svg class="w-3.5 h-3.5 stroke-current stroke-2 shrink-0 text-rose-600" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
                  </svg>
                )}
                <span>{cat.name}</span>
                <svg
                  class={`nav-arrow w-3 h-3 transition-transform duration-200 ${currentStyle.navArrow}`}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19 9-7 7-7-7"
                  />
                </svg>
              </a>

              {/* Mega-Menú Desplegable: Vitrina Split con Micro-SVGs y Tarjeta Destacada */}
              <div
                class={`nav-dropdown absolute top-full ${
                  idx >= 3 ? 'right-0' : 'left-0'
                } pt-2 w-[620px] sm:w-[660px] md:w-[680px] z-50`}
              >
                <div class="bg-white dark:bg-[#1d1816] rounded-3xl shadow-2xl border border-stone-200/90 dark:border-[#2d2521] p-5 text-stone-900 dark:text-[#fbf6f0]">
                  {/* Encabezado del Dropdown */}
                  <div class="flex items-center justify-between pb-3 mb-4 border-b border-stone-100 dark:border-[#2d2521]">
                    <div>
                      <h4 class="text-sm font-black text-stone-900 dark:text-white leading-tight">
                        {cat.name}
                      </h4>
                      <p class="text-[11px] text-stone-400 dark:text-[#b0a297] font-medium">
                        {cat.tagline}
                      </p>
                    </div>
                    <a
                      href={cat.href}
                      class="text-xs font-bold text-rose-600 dark:text-rose-400 hover:text-rose-700 hover:underline flex items-center gap-1 group"
                    >
                      Ver todo en {cat.name} <span class="group-hover:translate-x-0.5 transition-transform">→</span>
                    </a>
                  </div>

                  {/* Grilla Split: 2 columnas de navegación + 1 columna de vitrina promocional */}
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                    {/* 2 Columnas de Subcategorías con Micro-SVGs */}
                    <div class="sm:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
                      {cat.subcategorias.map((sub) => (
                        <div class="space-y-2">
                          <div class="flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider text-rose-600 dark:text-rose-400 pl-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
