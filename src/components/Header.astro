                                    </svg>
                                  )}
                                  {it.icon === 'paw' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" />
                                    </svg>
                                  )}
                                  {it.icon === 'heart' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                                    </svg>
                                  )}
                                  {it.icon === 'shield' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                                    </svg>
                                  )}
                                  {it.icon === 'sparkles' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                                    </svg>
                                  )}
                                  {it.icon === 'bed' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                                    </svg>
                                  )}
                                  {it.icon === 'drop' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                                    </svg>
                                  )}
                                  {it.icon === 'pack' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                                    </svg>
                                  )}
                                  {it.icon === 'tech' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                                    </svg>
                                  )}
                                  {it.icon === 'tag' && (
                                    <svg class="w-3.5 h-3.5 stroke-current stroke-[1.75]" fill="none" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                                    </svg>
                                  )}
                                </div>
                                <div class="min-w-0">
                                  <span class="block text-xs font-bold text-stone-900 dark:text-slate-100 group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors leading-tight truncate">
                                    {it.label}
                                  </span>
                                  <span class="block text-[10px] text-stone-400 dark:text-slate-400 group-hover:text-stone-600 dark:group-hover:text-slate-300 transition-colors leading-tight truncate mt-0.5">
                                    {it.desc}
                                  </span>
                                </div>
                              </a>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>

                    {/* Columna Derecha: Tarjeta Promocional / Colección Estrella */}
                    <aside class="rounded-2xl bg-gradient-to-br from-rose-50 via-white to-amber-50/50 dark:from-[#1d1816] dark:via-[#27201c] dark:to-[#4c111a]/30 p-4 border border-rose-100 dark:border-[#2d2521] flex flex-col justify-between shadow-xs">
                      <div class="space-y-2.5">
                        <div class="relative overflow-hidden rounded-xl h-24 w-full bg-stone-100 dark:bg-[#27201c] shadow-inner">
                          <Image
                            src={cat.destacado.image}
                            alt={cat.destacado.title}
                            width={200}
                            height={150}
                            format="webp"
                            class="w-full h-full object-cover"
                          />
                          <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-rose-600 text-white font-black text-[9px] uppercase tracking-wider shadow">
                            {cat.destacado.badge}
                          </span>
                        </div>
                        <div>
                          <h5 class="text-xs font-black text-stone-900 dark:text-white leading-tight">
                            {cat.destacado.title}
                          </h5>
                          <p class="text-[11px] text-stone-600 dark:text-[#b0a297] leading-snug mt-1">
                            {cat.destacado.desc}
                          </p>
                        </div>
                      </div>

                      <div class="pt-3 border-t border-rose-100/80 dark:border-[#2d2521] mt-2">
                        <a
                          href={cat.destacado.href}
                          class="w-full py-2 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-all shadow-xs cursor-pointer"
                        >
                          <span>{cat.destacado.cta}</span>
                          <span class="text-xs">→</span>
                        </a>
                      </div>
                    </aside>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<!-- ========================================================
     VERSIÓN MÓVIL: BACKDROP Y DRAWER LATERAL (OFFCANVAS)
     ======================================================== -->
<!-- Fondo oscuro semitransparente -->
<div
  id="mobile-drawer-backdrop"
  class="fixed inset-0 bg-stone-950/60 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none md:hidden"
  aria-hidden="true"
></div>

<!-- Drawer lateral deslizante -->
<aside
  id="mobile-nav-drawer"
  class="fixed inset-y-0 left-0 w-[85%] max-w-sm bg-[#FAF7F2] dark:bg-[#141110] z-50 shadow-2xl flex flex-col transform -translate-x-full transition-transform duration-300 ease-in-out border-r border-[#E8E2D9] dark:border-[#2d2521] md:hidden"
  aria-label="Menú de navegación móvil"
  aria-hidden="true"
>
  <!-- Cabecera del Drawer -->
  <div class="p-4 bg-white dark:bg-[#1d1816] border-b border-[#E8E2D9] dark:border-[#2d2521] flex items-center justify-between shrink-0">
    <div class="flex items-center gap-2.5">
      <span class="w-9 h-9 rounded-xl flex items-center justify-center bg-brand-primary text-white shadow-xs">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-4.5 1a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm9 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM6 13a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm12 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm-6 1c-2.8 0-5 1.8-5 4.5 0 1.9 1.8 3.5 5 3.5s5-1.6 5-3.5c0-2.7-2.2-4.5-5-4.5Z" />
        </svg>
      </span>
      <div class="flex flex-col">
        <span class="font-extrabold text-lg text-stone-900 dark:text-white tracking-tight leading-none">
          Market<span class="text-brand-primary">-Pet</span>
        </span>
        <span class="text-[9px] uppercase font-bold tracking-widest text-stone-400 dark:text-[#b0a297] mt-0.5">
          Tu Tienda de Mascotas
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <!-- Botón Toggle Modo Nocturno (Móvil) -->
      <button
        type="button"
        class="theme-toggle-btn w-9 h-9 rounded-xl border border-stone-200 dark:border-[#2d2521] bg-stone-50 dark:bg-[#27201c] text-stone-700 dark:text-amber-400 hover:bg-stone-100 dark:hover:bg-[#382d27] flex items-center justify-center transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary shrink-0"
        aria-label="Cambiar tema de color"
        title="Alternar entre modo claro y nocturno"
      >
