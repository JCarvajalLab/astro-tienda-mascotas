    tagline: 'Suplementos articulares, dermocosmética y salud preventiva',
    destacado: {
      badge: 'Cuidado Vital',
      title: 'Suplemento Articular Senior',
      desc: 'Glucosamina pura con sabor a hígado para mascotas mayores.',
      cta: 'Ver Farmacia',
      href: '/categoria/farmacia-salud',
      image: packDescanso,
    },
    subcategorias: [
      {
        grupo: 'Suplementos & Articular',
        items: [
          { label: 'Glucosamina Articular', desc: 'Regeneración de cartílago 7+', href: '/categoria/suplementos', icon: 'heart' },
          { label: 'Omega 3 Aceite Salmón', desc: 'Salud de piel y pelaje brillante', href: '/categoria/suplementos', icon: 'drop' },
        ],
      },
      {
        grupo: 'Dermocosmética & Cuidado',
        items: [
          { label: 'Shampoos Hipoalergénicos', desc: 'Alivio de picazón con avena', href: '/categoria/dermocosmetica', icon: 'sparkles' },
          { label: 'Higiene & Cuidado Diario', desc: 'Cepillos y bienestar general', href: '/categoria/higiene-cuidados', icon: 'shield' },
        ],
      },
    ],
  },
  {
    name: 'Ofertas Flash',
    iconName: 'flame',
    href: '/categoria/ofertas',
    isOffer: true,
    tagline: 'Descuentos exclusivos y combos con ahorro garantizado',
    destacado: {
      badge: 'Hasta 32% OFF',
      title: 'Packs de Ahorro Mensual',
      desc: 'Combos inteligentes para abastecerte con el mejor precio.',
      cta: 'Ver Ofertas Flash',
      href: '/categoria/ofertas',
      image: packCachorro,
    },
    subcategorias: [
      {
        grupo: 'Packs de Ahorro',
        items: [
          { label: 'Packs Promocionales', desc: 'Hasta 32% OFF en combos de ahorro', href: '/categoria/packs-promocionales', icon: 'pack' },
          { label: 'Combos Cachorros', desc: 'Ahorro garantizado de bienvenida', href: '/categoria/packs-promocionales?q=cachorro', icon: 'paw' },
        ],
      },
      {
        grupo: 'Descuentos Especiales',
        items: [
          { label: 'Alimentos en Oferta', desc: 'Precios rebajados en marcas top', href: '/categoria/ofertas?q=alimento', icon: 'bowl' },
