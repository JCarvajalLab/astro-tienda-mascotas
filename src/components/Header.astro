      cta: 'Explorar Packs',
      href: '/categoria/packs-promocionales',
      image: packCachorro,
    },
    subcategorias: [
      {
        grupo: 'Alimentos & Nutrición',
        items: [
          { label: 'Alimento Seco Premium', desc: 'Salmón, Pollo y Fórmulas 7+', href: '/categoria/alimentos-perro', icon: 'bowl' },
          { label: 'Snacks Dentales & Premios', desc: 'Higiene bucal y clorofila', href: '/categoria/snacks-premios?pet=perros', icon: 'bone' },
          { label: 'Fórmulas Cachorros', desc: 'Crecimiento y defensas', href: '/categoria/cachorros?pet=perros', icon: 'paw' },
          { label: 'Nutrición Senior 7+', desc: 'Glucosamina y movilidad', href: '/categoria/seniors?pet=perros', icon: 'heart' },
        ],
      },
      {
        grupo: 'Paseo & Confort',
        items: [
          { label: 'Arneses Antitirones', desc: 'Ergonómicos y reflectantes', href: '/categoria/paseo-seguridad?pet=perros', icon: 'shield' },
          { label: 'Collares de Seguridad', desc: 'Alta visibilidad nocturna', href: '/categoria/paseo-seguridad', icon: 'sparkles' },
          { label: 'Camas Ortopédicas', desc: 'Memory foam viscoelástico', href: '/categoria/camas-confort', icon: 'bed' },
          { label: 'Shampoos Dermoprotectores', desc: 'Avena y extractos naturales', href: '/categoria/dermocosmetica', icon: 'drop' },
        ],
      },
    ],
  },
  {
    name: 'Gatos',
    iconName: 'cat',
    href: '/categoria/gatos',
    tagline: 'Nutrición felina, rascadores y confort para tu gato',
    destacado: {
      badge: 'Más Vendido',
      title: 'Pack Higiene Felina Total',
      desc: 'Arena bentonita blanca, pala recolectora y snack relajante.',
      cta: 'Ver Pack Felino',
      href: '/categoria/packs-promocionales',
      image: packGato,
    },
    subcategorias: [
      {
        grupo: 'Nutrición & Premios',
        items: [
          { label: 'Alimento Esterilizados', desc: 'Salud urinaria y peso óptimo', href: '/categoria/alimentos-gato', icon: 'bowl' },
          { label: 'Snacks Cremosos Churu', desc: 'Palatabilidad y premios', href: '/categoria/snacks-premios?pet=gatos', icon: 'heart' },
          { label: 'Fórmulas Gatitos', desc: 'Desarrollo y defensas', href: '/categoria/cachorros?pet=gatos', icon: 'paw' },
