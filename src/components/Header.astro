---
import { Image } from 'astro:assets';
import packCachorro from '../assets/products/pack-cachorro.jpg';
import packGato from '../assets/products/pack-gato.jpg';
import packDescanso from '../assets/products/pack-descanso.jpg';
import packPaseo from '../assets/products/pack-paseo.jpg';

