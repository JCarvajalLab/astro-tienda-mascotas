---
// Barra superior interactiva para probar las 3 paletas 60-30-10 en tiempo real
---

<div
  id="palette-switcher-bar"
  class="w-full bg-[#0F172A] text-stone-200 border-b border-stone-800 text-xs py-2 px-4 flex flex-wrap items-center justify-between gap-3 z-50 transition-colors shadow-sm"
>
  <div class="flex items-center gap-2">
    <span class="text-sm">📐</span>
    <span
      class="font-extrabold text-white uppercase tracking-wider text-[11px]"
    >
      Regla 60-30-10 con Rojo:
    </span>
    <span class="text-stone-400 hidden xl:inline">
      Compara las 3 paletas haciendo clic o cambiando de puerto
    </span>
  </div>

  <div class="flex items-center flex-wrap gap-2">
    <!-- Opción 1: Retail Carmín (Puerto 4321) -->
    <div class="inline-flex rounded-full shadow-xs">
      <button
        type="button"
        data-palette="retail"
        class="palette-btn px-3 py-1 rounded-l-full text-[11px] font-bold transition-all cursor-pointer flex items-center gap-2 border border-stone-700 bg-stone-800 text-stone-200 hover:border-rose-500"
      >
        <span class="flex items-center -space-x-1">
          <span
            class="w-3 h-3 rounded-full bg-[#F8FAFC] border border-stone-400"
            title="60% Blanco Slate"></span>
          <span
            class="w-3 h-3 rounded-full bg-[#0F172A] border border-stone-600"
            title="30% Pizarra Grafito"></span>
          <span
            class="w-3 h-3 rounded-full bg-[#E11D48]"
            title="10% Rojo Carmín"></span>
        </span>
        <span>1. Retail Carmín</span>
      </button>
      <a
        href="http://localhost:4321/"
        class="px-2 py-1 rounded-r-full text-[10px] font-semibold bg-stone-800 text-stone-400 hover:text-white border-y border-r border-stone-700 flex items-center"
        title="Abrir en puerto 4321"
      >
        :4321 ↗
      </a>
    </div>

    <!-- Opción 2: Nordic Paws (Puerto 4322) -->
    <div class="inline-flex rounded-full shadow-xs">
      <button
        type="button"
        data-palette="nordic"
        class="palette-btn px-3 py-1 rounded-l-full text-[11px] font-bold transition-all cursor-pointer flex items-center gap-2 border border-stone-700 bg-stone-800 text-stone-200 hover:border-red-500"
      >
        <span class="flex items-center -space-x-1">
          <span
            class="w-3 h-3 rounded-full bg-[#FBF9F5] border border-stone-300"
            title="60% Crema Avena"></span>
          <span
            class="w-3 h-3 rounded-full bg-[#1E2B37] border border-stone-600"
            title="30% Azul Petróleo"></span>
          <span class="w-3 h-3 rounded-full bg-[#D90429]" title="10% Rojo Rubí"
          ></span>
        </span>
        <span>2. Nordic Paws</span>
      </button>
      <a
        href="http://localhost:4322/"
        class="px-2 py-1 rounded-r-full text-[10px] font-semibold bg-stone-800 text-stone-400 hover:text-white border-y border-r border-stone-700 flex items-center"
        title="Abrir en puerto 4322"
      >
        :4322 ↗
      </a>
    </div>

    <!-- Opción 3: Salvia & Terracota (Puerto 4323) -->
    <div class="inline-flex rounded-full shadow-xs">
      <button
        type="button"
        data-palette="salvia"
        class="palette-btn px-3 py-1 rounded-l-full text-[11px] font-bold transition-all cursor-pointer flex items-center gap-2 border border-stone-700 bg-stone-800 text-stone-200 hover:border-orange-500"
      >
        <span class="flex items-center -space-x-1">
          <span
            class="w-3 h-3 rounded-full bg-[#F7F9F8] border border-stone-300"
            title="60% Lino Suave"></span>
          <span
            class="w-3 h-3 rounded-full bg-[#203A31] border border-stone-600"
            title="30% Salvia Botánico"></span>
          <span
            class="w-3 h-3 rounded-full bg-[#E0533C]"
            title="10% Rojo Terracota"></span>
        </span>
        <span>3. Salvia & Terracota</span>
      </button>
      <a
        href="http://localhost:4323/"
        class="px-2 py-1 rounded-r-full text-[10px] font-semibold bg-stone-800 text-stone-400 hover:text-white border-y border-r border-stone-700 flex items-center"
        title="Abrir en puerto 4323"
      >
        :4323 ↗
      </a>
    </div>
  </div>
</div>

<script>
  const paletteButtons = document.querySelectorAll('.palette-btn');

  function applyPalette(palette) {
    document.documentElement.setAttribute('data-palette', palette);
    localStorage.setItem('tienda_palette', palette);

    paletteButtons.forEach((btn) => {
      const p = btn.getAttribute('data-palette');
      if (p === palette) {
        btn.classList.add(
          'bg-white',
          'text-stone-900',
          'border-white',
          'shadow-xs'
        );
        btn.classList.remove('bg-stone-800', 'text-stone-200');
      } else {
        btn.classList.remove(
          'bg-white',
          'text-stone-900',
          'border-white',
          'shadow-xs'
        );
        btn.classList.add('bg-stone-800', 'text-stone-200');
      }
    });
  }

  // Detectar por puerto inicial o preferencia
  const port = window.location.port;
  let initial = 'retail';
  if (port === '4322') initial = 'nordic';
  else if (port === '4323') initial = 'salvia';
  else initial = localStorage.getItem('tienda_palette') || 'retail';

  applyPalette(initial);

  paletteButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const palette = btn.getAttribute('data-palette');
      if (palette) applyPalette(palette);
    });
  });
</script>
