---
import { Image } from 'astro:assets';

/**
 * Componente ProductSlider
 * Carrusel horizontal compacto de 5 productos por pantalla (con flechas derecha/izquierda).
 */
const {
  id = 'slider',
  title = 'Productos',
  badge = '',
  badgeColor = 'bg-rose-50 text-rose-600 border-rose-200',
  subtitle = '',
  products = [],
} = Astro.props;

function formatPrice(amount) {
  return `$${amount.toLocaleString('es-CL')}`;
}
---

<section
  id={id}
  class="py-10 sm:py-12 select-none"
  aria-label={title}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de la fila con flechas de navegación a la derecha -->
    <div
      class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-3"
    >
      <div>
        {
          badge && (
            <span
              class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider border mb-1.5 ${badgeColor}`}
            >
              {badge}
            </span>
          )
        }
        <h2
          class="text-xl sm:text-2xl lg:text-3xl font-black text-stone-900 tracking-tight"
        >
          {title}
        </h2>
        {
          subtitle && (
            <p class="text-xs sm:text-sm text-stone-500 mt-0.5">{subtitle}</p>
          )
        }
      </div>

      <!-- Flechas de navegación del carrusel -->
      <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
        <button
          type="button"
          data-slider-prev={id}
          aria-label={`Ver productos anteriores de ${title}`}
          class="w-9 h-9 rounded-full border border-stone-300 hover:border-stone-400 bg-white hover:bg-stone-100 text-stone-700 flex items-center justify-center transition-all cursor-pointer shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <svg
            class="w-4 h-4 stroke-current stroke-2"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <button
          type="button"
          data-slider-next={id}
          aria-label={`Ver más productos de ${title}`}
          class="w-9 h-9 rounded-full border border-stone-300 hover:border-stone-400 bg-white hover:bg-stone-100 text-stone-700 flex items-center justify-center transition-all cursor-pointer shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <svg
            class="w-4 h-4 stroke-current stroke-2"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Pista de productos (5 por pantalla en desktop) -->
    <div
      id={`track-${id}`}
      class="flex gap-3 sm:gap-4 overflow-x-auto scroll-smooth scrollbar-none snap-x snap-mandatory py-2 -mx-4 px-4 sm:mx-0 sm:px-0"
    >
      {
        products.map((prod) => (
          <article class="snap-start shrink-0 w-[calc(50%-6px)] sm:w-[calc(33.333%-11px)] md:w-[calc(25%-12px)] lg:w-[calc(20%-13px)] flex flex-col bg-white rounded-2xl border border-stone-200/90 hover:border-rose-400 hover:shadow-lg transition-all duration-200 group overflow-hidden">
            <a
              href={prod.slug ? `/producto/${prod.slug}` : `#${prod.id}`}
              class="relative aspect-square w-full bg-stone-50 overflow-hidden flex items-center justify-center block cursor-pointer"
            >
              {prod.badge && (
                <span
                  class={`absolute top-2 left-2 z-10 px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider shadow-xs ${prod.badgeColor || 'bg-rose-600 text-white'}`}
                >
                  {prod.badge}
                </span>
              )}

              <Image
                src={prod.image}
                alt={prod.imageAlt || prod.name}
                width={280}
                height={280}
                format="webp"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </a>

            <div class="p-3 sm:p-3.5 flex flex-col flex-1">
              <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400 mb-1 truncate">
                {prod.category}
              </span>

              <h3
                class="text-xs sm:text-sm font-bold text-stone-900 group-hover:text-rose-600 transition-colors line-clamp-2 leading-snug mb-2 flex-1"
                title={prod.name}
              >
                <a
                  href={prod.slug ? `/producto/${prod.slug}` : `#${prod.id}`}
                  class="hover:text-rose-600 transition-colors"
                >
                  {prod.name}
                </a>
              </h3>

              <div class="flex items-center gap-1 text-[11px] text-amber-500 mb-2">
                <span>★</span>
                <span class="font-bold text-stone-700">{prod.rating}</span>
                <span class="text-stone-400 text-[10px]">
                  ({prod.reviewsCount})
                </span>
              </div>

              <div class="pt-2 border-t border-stone-100 flex items-center justify-between gap-1 mt-auto">
                <div class="flex flex-col">
                  <span class="text-xs sm:text-sm font-black text-stone-900 leading-none">
                    {formatPrice(prod.price)}
                  </span>
                  {prod.originalPrice && (
                    <span class="text-[10px] text-stone-400 line-through mt-0.5 leading-none">
                      {formatPrice(prod.originalPrice)}
                    </span>
                  )}
                </div>

                <button
                  type="button"
                  data-add-to-cart
                  data-product-id={prod.id}
                  data-product-name={prod.name}
                  data-product-price={prod.price}
                  class="add-to-cart-btn p-2 rounded-xl bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white transition-all cursor-pointer shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500"
                  title="Agregar al carrito"
                  aria-label={`Agregar ${prod.name} al carrito`}
                >
                  <svg
                    class="w-4 h-4 stroke-current stroke-2"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 4.5v15m7.5-7.5h-15"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Script interactivo de desplazamiento para este slider -->
<script define:vars={{ id }}>
  const track = document.getElementById(`track-${id}`);
  const prevBtn = document.querySelector(`[data-slider-prev="${id}"]`);
  const nextBtn = document.querySelector(`[data-slider-next="${id}"]`);

  if (track && prevBtn && nextBtn) {
    const scrollStep = () => track.clientWidth * 0.85;

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -scrollStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: scrollStep(), behavior: 'smooth' });
    });
  }
</script>
