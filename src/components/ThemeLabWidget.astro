---
// Widget Flotante interactivo para probar paletas del modo nocturno (Awesome Design MD)
---

<aside
  id="theme-lab-widget"
  class="fixed bottom-4 right-4 z-50 select-none font-sans"
  aria-label="Laboratorio de Paletas de Modo Nocturno"
>
  <!-- Botón Píldora Minimizada (Visible por defecto o al colapsar) -->
  <button
    type="button"
    id="theme-lab-toggle-btn"
    class="flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-stone-900/90 dark:bg-slate-800/95 text-white shadow-xl border border-stone-700/80 hover:scale-104 active:scale-95 transition-all cursor-pointer backdrop-blur-md"
    aria-expanded="false"
    aria-controls="theme-lab-panel"
    title="Abrir Laboratorio de Paletas Nocturnas"
  >
    <span class="text-base">🎨</span>
    <span class="text-xs font-bold tracking-tight">Probar Modo Nocturno</span>
    <span
      id="theme-lab-current-badge"
      class="w-3.5 h-3.5 rounded-full border border-white/40 shadow-xs"
      style="background-color: #141110;"
    ></span>
  </button>

  <!-- Panel Desplegable Flotante -->
  <div
    id="theme-lab-panel"
    class="hidden mt-2 w-80 sm:w-92 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-stone-200/90 dark:border-slate-800 p-4 sm:p-5 text-stone-900 dark:text-slate-100 animate-in fade-in zoom-in-95 duration-150"
  >
    <!-- Encabezado del Panel -->
    <div class="flex items-start justify-between pb-3 mb-3 border-b border-stone-200/80 dark:border-slate-800">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded-md bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 font-extrabold text-[10px] uppercase tracking-wider border border-rose-200 dark:border-rose-900/40">
            Awesome Design MD
          </span>
        </div>
        <h4 class="text-sm font-black text-stone-900 dark:text-white mt-1 leading-tight">
          Paletas de Modo Nocturno
        </h4>
        <p class="text-[11px] text-stone-500 dark:text-slate-400 leading-snug mt-0.5">
          Alterna en tiempo real para ver fondos, tarjetas y contrastes.
        </p>
      </div>

      <button
        type="button"
        id="theme-lab-close-btn"
        aria-label="Minimizar panel"
        class="w-7 h-7 rounded-lg flex items-center justify-center text-stone-400 hover:text-stone-700 dark:hover:text-white hover:bg-stone-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      >
        ✕
      </button>
    </div>

    <!-- Switch General Modo Claro / Modo Oscuro -->
    <div class="flex items-center justify-between p-2.5 rounded-xl bg-stone-100/80 dark:bg-slate-800/80 mb-3 border border-stone-200/60 dark:border-slate-700/60">
      <div class="flex items-center gap-2 text-xs font-bold text-stone-800 dark:text-slate-200">
        <span id="theme-status-icon">🌙</span>
        <span id="theme-status-text">Modo Nocturno Activo</span>
      </div>
      <button
        type="button"
        id="theme-lab-mode-switch"
        class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer bg-stone-800 dark:bg-white text-white dark:text-stone-900 hover:opacity-90 shadow-2xs"
      >
        Cambiar
      </button>
    </div>

    <!-- Lista de 4 Paletas Nocturnas -->
    <div class="space-y-2">
      <span class="text-[10px] uppercase font-black tracking-wider text-stone-400 dark:text-slate-500 block px-1">
        Elige un Estilo Cromático:
      </span>

      <!-- 1. Midnight Slate (Default) -->
      <button
        type="button"
        data-variant="midnight-slate"
        class="theme-variant-btn w-full flex items-center justify-between p-2.5 rounded-2xl border text-left transition-all cursor-pointer group border-stone-200 dark:border-slate-700 hover:border-rose-400 dark:hover:border-rose-500 hover:bg-rose-50/40 dark:hover:bg-slate-800/60"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-xl border border-white/20 shadow-xs flex items-center justify-center shrink-0 overflow-hidden" style="background: linear-gradient(135deg, #090d16 50%, #0f172a 50%);">
            <span class="text-[10px]">🌑</span>
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-bold text-stone-900 dark:text-white leading-tight truncate">
              1. Midnight Slate
            </span>
            <span class="block text-[10px] text-stone-500 dark:text-slate-400 leading-none mt-0.5 truncate">
              Pizarra azulada (Actual / Tech)
            </span>
          </div>
        </div>
        <span class="theme-check-icon hidden text-xs font-black text-rose-600 dark:text-rose-400">✓</span>
      </button>

      <!-- 2. Warm Charcoal & Cacao (Cálido y orgánico - Recomendado) -->
      <button
        type="button"
        data-variant="warm-charcoal"
        class="theme-variant-btn w-full flex items-center justify-between p-2.5 rounded-2xl border text-left transition-all cursor-pointer group border-stone-200 dark:border-slate-700 hover:border-rose-400 dark:hover:border-rose-500 hover:bg-rose-50/40 dark:hover:bg-slate-800/60"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-xl border border-white/20 shadow-xs flex items-center justify-center shrink-0 overflow-hidden" style="background: linear-gradient(135deg, #141110 50%, #1d1816 50%);">
            <span class="text-[10px]">☕</span>
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-bold text-stone-900 dark:text-white leading-tight truncate flex items-center gap-1.5">
              <span>2. Warm Charcoal</span>
              <span class="text-[9px] px-1.5 py-0.2 rounded-md bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 font-extrabold uppercase">Oficial Market-Pet</span>
            </span>
            <span class="block text-[10px] text-stone-500 dark:text-slate-400 leading-none mt-0.5 truncate">
              Cacao & Café tostado (Cálido mascota)
            </span>
          </div>
        </div>
        <span class="theme-check-icon hidden text-xs font-black text-rose-600 dark:text-rose-400">✓</span>
      </button>

      <!-- 3. Forest Pine (Verde botánico) -->
      <button
        type="button"
        data-variant="forest-pine"
        class="theme-variant-btn w-full flex items-center justify-between p-2.5 rounded-2xl border text-left transition-all cursor-pointer group border-stone-200 dark:border-slate-700 hover:border-rose-400 dark:hover:border-rose-500 hover:bg-rose-50/40 dark:hover:bg-slate-800/60"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-xl border border-white/20 shadow-xs flex items-center justify-center shrink-0 overflow-hidden" style="background: linear-gradient(135deg, #09120e 50%, #111d16 50%);">
            <span class="text-[10px]">🌲</span>
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-bold text-stone-900 dark:text-white leading-tight truncate">
              3. Forest Pine
            </span>
            <span class="block text-[10px] text-stone-500 dark:text-slate-400 leading-none mt-0.5 truncate">
              Verde bosque nocturno & Naturaleza
            </span>
          </div>
        </div>
        <span class="theme-check-icon hidden text-xs font-black text-rose-600 dark:text-rose-400">✓</span>
      </button>

      <!-- 4. Pure Onyx OLED (Negro puro minimalista) -->
      <button
        type="button"
        data-variant="onyx-oled"
        class="theme-variant-btn w-full flex items-center justify-between p-2.5 rounded-2xl border text-left transition-all cursor-pointer group border-stone-200 dark:border-slate-700 hover:border-rose-400 dark:hover:border-rose-500 hover:bg-rose-50/40 dark:hover:bg-slate-800/60"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-xl border border-white/20 shadow-xs flex items-center justify-center shrink-0 overflow-hidden" style="background: linear-gradient(135deg, #000000 50%, #111111 50%);">
            <span class="text-[10px]">🖤</span>
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-bold text-stone-900 dark:text-white leading-tight truncate">
              4. Pure Onyx OLED
            </span>
            <span class="block text-[10px] text-stone-500 dark:text-slate-400 leading-none mt-0.5 truncate">
              Negro absoluto de alto contraste
            </span>
          </div>
        </div>
        <span class="theme-check-icon hidden text-xs font-black text-rose-600 dark:text-rose-400">✓</span>
      </button>
    </div>
  </div>
</aside>

<script>
  // Controlador cliente del Laboratorio de Temas (JavaScript nativo puro)
  const labToggleBtn = document.getElementById('theme-lab-toggle-btn');
  const labPanel = document.getElementById('theme-lab-panel');
  const labCloseBtn = document.getElementById('theme-lab-close-btn');
  const modeSwitchBtn = document.getElementById('theme-lab-mode-switch');
  const statusIcon = document.getElementById('theme-status-icon');
  const statusText = document.getElementById('theme-status-text');
  const currentBadge = document.getElementById('theme-lab-current-badge');
  const variantButtons = document.querySelectorAll('.theme-variant-btn');

  const variantColors = {
    'midnight-slate': '#090d16',
    'warm-charcoal': '#141110',
    'forest-pine': '#09120e',
    'onyx-oled': '#000000',
  };

  function updateLabUI() {
    const isDark = document.documentElement.classList.contains('dark');
    const currentVariant = document.documentElement.getAttribute('data-dark-theme') || 'warm-charcoal';

    if (statusIcon && statusText) {
      if (isDark) {
        statusIcon.textContent = '🌙';
        statusText.textContent = 'Modo Nocturno Activo';
        modeSwitchBtn && (modeSwitchBtn.textContent = 'Pasar a Claro');
      } else {
        statusIcon.textContent = '☀️';
        statusText.textContent = 'Modo Claro Activo';
        modeSwitchBtn && (modeSwitchBtn.textContent = 'Pasar a Oscuro');
      }
    }

    if (currentBadge) {
      currentBadge.style.backgroundColor = isDark ? (variantColors[currentVariant] || '#141110') : '#FAF7F2';
    }

    variantButtons.forEach((btn) => {
      const v = btn.getAttribute('data-variant');
      const check = btn.querySelector('.theme-check-icon');
      if (v === currentVariant) {
        btn.classList.add('border-rose-500', 'bg-rose-50/80', 'dark:bg-slate-800', 'ring-2', 'ring-rose-500/20');
        check?.classList.remove('hidden');
      } else {
        btn.classList.remove('border-rose-500', 'bg-rose-50/80', 'dark:bg-slate-800', 'ring-2', 'ring-rose-500/20');
        check?.classList.add('hidden');
      }
    });
  }

  function setVariant(variantId) {
    // Si no está en modo oscuro, activarlo automáticamente para ver el cambio
    if (!document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.add('dark');
      try {
        localStorage.setItem('theme', 'dark');
      } catch (_) {}
    }

    document.documentElement.setAttribute('data-dark-theme', variantId);
    try {
      localStorage.setItem('dark-theme-variant', variantId);
    } catch (_) {}

    updateLabUI();
  }

  // Toggle abrir / cerrar panel
  labToggleBtn?.addEventListener('click', () => {
    const isHidden = labPanel?.classList.contains('hidden');
    if (isHidden) {
      labPanel?.classList.remove('hidden');
      labToggleBtn?.setAttribute('aria-expanded', 'true');
    } else {
      labPanel?.classList.add('hidden');
      labToggleBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  labCloseBtn?.addEventListener('click', () => {
    labPanel?.classList.add('hidden');
    labToggleBtn?.setAttribute('aria-expanded', 'false');
  });

  // Switch modo claro / modo oscuro
  modeSwitchBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (_) {}
    updateLabUI();
  });

  // Selección de variante
  variantButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const v = btn.getAttribute('data-variant');
      if (v) setVariant(v);
    });
  });

  // Inicializar estado del laboratorio
  updateLabUI();
</script>
