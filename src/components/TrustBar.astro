---
/**
 * Barra de Beneficios y Confianza Comercial
 * Inspirada en la referencia de ecommerce de retail (Delivery gratis, express, retiro y asesoría)
 */
const beneficios = [
  {
    titulo: 'Delivery Gratis',
    subtitulo: 'Por compras sobre $29.990',
    icon: 'truck',
  },
  {
    titulo: 'Delivery Express',
    subtitulo: 'Envíos en 24 a 48 horas',
    icon: 'scooter',
  },
  {
    titulo: 'Retiro en Tienda',
    subtitulo: '¡100% Gratis en sucursales!',
    icon: 'store',
  },
  {
    titulo: 'Asesoría Especializada',
    subtitulo: 'Orientación veterinaria online',
    icon: 'support',
  },
];
---

<section
  class="bg-[#F5F0E8] dark:bg-[#0c121e] border-b border-[#E8E2D9] dark:border-slate-800/80 py-5 transition-colors"
  aria-label="Beneficios y garantías de compra"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 lg:gap-8 items-center"
    >
      {
        beneficios.map((b) => (
          <div class="flex items-center gap-3 sm:gap-3.5 group">
            <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-brand-primary dark:text-rose-400 flex items-center justify-center shrink-0 border border-rose-100 dark:border-rose-900/40 group-hover:scale-105 transition-transform duration-200">
              {b.icon === 'truck' && (
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 stroke-current stroke-2"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V18.75M14.25 7.5H4.5A2.25 2.25 0 0 0 2.25 9.75v5.625"
                  />
                </svg>
              )}
              {b.icon === 'scooter' && (
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 stroke-current stroke-2"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                  />
                </svg>
              )}
              {b.icon === 'store' && (
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 stroke-current stroke-2"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72m-13.5 8.25h4.5a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75z"
                  />
                </svg>
              )}
              {b.icon === 'support' && (
                <svg
                  class="w-5 h-5 sm:w-6 sm:h-6 stroke-current stroke-2"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3z"
                  />
                </svg>
              )}
            </div>
            <div>
              <p class="text-xs sm:text-sm font-black text-stone-900 dark:text-slate-100 leading-snug group-hover:text-brand-primary dark:group-hover:text-rose-400 transition-colors">
                {b.titulo}
              </p>
              <p class="text-[11px] sm:text-xs text-stone-500 dark:text-slate-400 font-medium leading-none mt-0.5">
                {b.subtitulo}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
