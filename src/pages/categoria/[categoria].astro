---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const allProducts = await getCollection('productos');

  const categoriesMap = {
    perros: {
      title: 'Productos para Perros',
      subtitle: 'Nutrición, camas ortopédicas, arneses y snacks para el mejor amigo del hogar',
      icon: '🐶',
      filter: (p) => p.data.petType === 'perros' || p.data.petType === 'todas',
    },
    gatos: {
      title: 'Productos para Gatos',
      subtitle: 'Alimento gourmet, rascadores, snacks cremosos y bienestar para tu felino',
      icon: '🐱',
      filter: (p) => p.data.petType === 'gatos' || p.data.petType === 'todas',
    },
    'alimentos-perro': {
      title: 'Alimentos para Perro',
      subtitle: 'Nutrición premium equilibrada con proteínas de alto valor biológico',
      icon: '🍖',
      filter: (p) => p.data.categorySlug === 'alimentos-perro',
    },
    'alimentos-gato': {
      title: 'Alimentos para Gato',
      subtitle: 'Fórmulas para esterilizados, control de peso y salud urinaria',
      icon: '🐟',
      filter: (p) => p.data.categorySlug === 'alimentos-gato',
    },
    'camas-confort': {
      title: 'Camas & Confort',
      subtitle: 'Camas viscoelásticas, mantas y descanso reparador para mascotas',
      icon: '🛏️',
      filter: (p) => p.data.categorySlug === 'camas-confort',
    },
    'rascadores-camas': {
      title: 'Rascadores & Torres',
      subtitle: 'Postes de sisal natural y torres de juego para proteger tus muebles',
      icon: '🪵',
      filter: (p) => p.data.categorySlug === 'rascadores-camas',
    },
    'snacks-premios': {
      title: 'Snacks & Premios',
      subtitle: 'Golosinas dentales, Churus cremosos y bocados 100% naturales',
      icon: '🦴',
      filter: (p) => p.data.categorySlug === 'snacks-premios',
    },
    'paseo-seguridad': {
      title: 'Paseo & Seguridad',
      subtitle: 'Arneses reflectantes, correas ergonómicas y accesorios de paseo',
      icon: '🦮',
      filter: (p) => p.data.categorySlug === 'paseo-seguridad',
    },
    'smart-pet': {
      title: 'Smart Pet & Tecnología',
      subtitle: 'Comederos automáticos WiFi, fuentes inteligentes y dispositivos modernos',
      icon: '📱',
      filter: (p) => p.data.categorySlug === 'smart-pet',
    },
    'viajes-paseo': {
      title: 'Viajes & Transporte',
      subtitle: 'Mochilas panorámicas, transportadoras y seguridad para salir de viaje',
      icon: '🎒',
      filter: (p) => p.data.categorySlug === 'viajes-paseo',
    },
    hidratacion: {
      title: 'Fuentes & Hidratación',
      subtitle: 'Bebederos automáticos recirculantes y filtros purificadores',
      icon: '💧',
      filter: (p) => p.data.categorySlug === 'hidratacion',
    },
    'packs-promocionales': {
      title: 'Packs Promocionales & Ahorro',
      subtitle: 'Combos inteligentes de bienvenida, higiene, paseo y confort para consentir a tu mascota con hasta 32% de ahorro',
      icon: '🎁',
      filter: (p) => p.data.categorySlug === 'packs-promocionales' || p.data.category.toLowerCase().includes('pack'),
    },
    'higiene-cuidados': {
      title: 'Higiene & Cuidados',
      subtitle: 'Arenas sanitarias de bentonita blanca, shampoos dermoprotectores y bienestar',
      icon: '🧼',
      filter: (p) => p.data.categorySlug === 'higiene-cuidados',
    },
    cachorros: {
      title: 'Especial Cachorros & Gatitos',
      subtitle: 'Nutrición para primeras etapas, juguetes de apego, mantas térmicas y combos de bienvenida para sus primeros pasos',
      icon: '🍼',
      filter: (p) => {
        const stage = p.data.lifeStage || '';
        const name = (p.data.name || '').toLowerCase();
        const slug = (p.data.slug || '').toLowerCase();
        return (
          stage === 'cachorros' ||
          name.includes('cachorro') ||
          name.includes('gatito') ||
          slug.includes('cachorro') ||
          slug.includes('manta-termica') ||
          slug.includes('pelota-interactiva') ||
          slug.includes('pack-bienvenida') ||
          slug.includes('pack-gato-confort') ||
          slug.includes('churu') ||
          slug.includes('shampoo')
        );
      },
    },
    adultos: {
      title: 'Especial Compañeros Adultos',
      subtitle: 'Nutrición balanceada premium, arneses ergonómicos, rascadores y accesorios para su mejor momento',
      icon: '🐕',
      filter: (p) => {
        const stage = p.data.lifeStage || '';
        const name = (p.data.name || '').toLowerCase();
        const catSlug = p.data.categorySlug || '';
        return (
          stage === 'adultos' ||
          name.includes('adulto') ||
          name.includes('esterilizado') ||
          catSlug === 'paseo-seguridad' ||
          catSlug === 'alimentos-perro' ||
          catSlug === 'alimentos-gato' ||
          catSlug === 'rascadores-camas'
        );
      },
    },
    seniors: {
      title: 'Especial Fiel Amigo Senior (7+)',
      subtitle: 'Suplementos articulares con glucosamina, camas ortopédicas memory foam y nutrición adaptada para su máxima comodidad',
      icon: '🤍',
      filter: (p) => {
        const stage = p.data.lifeStage || '';
        const name = (p.data.name || '').toLowerCase();
        const slug = (p.data.slug || '').toLowerCase();
        return (
          stage === 'seniors' ||
          name.includes('senior') ||
          name.includes('articular') ||
          name.includes('ortopédica') ||
          slug.includes('senior') ||
          slug.includes('cama-ortopedica') ||
          slug.includes('suplemento-articular') ||
          slug.includes('pack-descanso')
        );
      },
    },
    accesorios: {
      title: 'Accesorios para Mascotas',
      subtitle: 'Arneses ergonómicos, collares de seguridad, camas viscoelásticas, comederos WiFi y transportadoras de viaje',
      icon: '🎾',
      filter: (p) => {
        const catSlug = p.data.categorySlug || '';
        const catName = (p.data.category || '').toLowerCase();
        const accessorySlugs = [
          'paseo-seguridad',
          'camas-confort',
          'smart-pet',
          'viajes-paseo',
          'hidratacion',
          'rascadores-camas',
        ];
        return (
          accessorySlugs.includes(catSlug) ||
          catName.includes('accesorio') ||
          catName.includes('paseo') ||
          catName.includes('descanso') ||
          catName.includes('juguete') ||
          catName.includes('cama') ||
          catName.includes('smart')
        );
      },
    },
    'farmacia-salud': {
      title: 'Farmacia, Salud & Bienestar',
      subtitle: 'Suplementos articulares para seniors, shampoos hipoalergénicos con extracto de avena, cuidado dental e higiene',
      icon: '🩺',
      filter: (p) => {
        const catSlug = p.data.categorySlug || '';
        const catName = (p.data.category || '').toLowerCase();
        const pName = (p.data.name || '').toLowerCase();
        const pSlug = (p.data.slug || '').toLowerCase();
        return (
          catSlug === 'higiene-cuidados' ||
          catName.includes('farmacia') ||
          catName.includes('higiene') ||
          catName.includes('salud') ||
          catName.includes('dental') ||
          pName.includes('suplemento') ||
          pName.includes('articular') ||
          pName.includes('shampoo') ||
          pName.includes('dental') ||
          pSlug.includes('suplemento') ||
          pSlug.includes('shampoo') ||
          pSlug.includes('articular')
        );
      },
    },
    farmacia: {
      title: 'Farmacia, Salud & Bienestar',
      subtitle: 'Suplementos articulares para seniors, shampoos hipoalergénicos con extracto de avena, cuidado dental e higiene',
      icon: '🩺',
      filter: (p) => {
        const catSlug = p.data.categorySlug || '';
        const catName = (p.data.category || '').toLowerCase();
        const pName = (p.data.name || '').toLowerCase();
        const pSlug = (p.data.slug || '').toLowerCase();
        return (
          catSlug === 'higiene-cuidados' ||
          catName.includes('farmacia') ||
          catName.includes('higiene') ||
          catName.includes('salud') ||
          catName.includes('dental') ||
          pName.includes('suplemento') ||
          pName.includes('articular') ||
          pName.includes('shampoo') ||
          pName.includes('dental') ||
          pSlug.includes('suplemento') ||
          pSlug.includes('shampoo') ||
          pSlug.includes('articular')
        );
      },
    },
    suplementos: {
      title: 'Suplementos & Salud Articular',
      subtitle: 'Glucosamina pura con MSM, condroprotectores y suplementos articulares para vitalidad y movilidad',
      icon: '💊',
      filter: (p) => {
        const name = (p.data.name || '').toLowerCase();
        const slug = (p.data.slug || '').toLowerCase();
        return (
          name.includes('suplemento') ||
          name.includes('articular') ||
          name.includes('glucosamina') ||
          slug.includes('suplemento') ||
          slug.includes('articular')
        );
      },
    },
    dermocosmetica: {
      title: 'Dermocosmética & Cuidado de Piel',
      subtitle: 'Shampoos hipoalergénicos con extracto de avena, alivio de picazón y cuidado del pelaje',
      icon: '🧴',
      filter: (p) => {
        const name = (p.data.name || '').toLowerCase();
        const slug = (p.data.slug || '').toLowerCase();
        return name.includes('shampoo') || slug.includes('shampoo') || slug.includes('avena');
      },
    },
    ofertas: {
      title: 'Ofertas Flash & Descuentos',
      subtitle: 'Descuentos exclusivos de hasta 32% OFF en alimentos seleccionados, packs de bienvenida, accesorios y combos mensuales',
      icon: '🔥',
      filter: (p) => {
        const hasDiscount = Boolean(p.data.discount);
        const hasOriginalPrice = Boolean(p.data.originalPrice && p.data.originalPrice > p.data.price);
        const isPack = (p.data.category || '').toLowerCase().includes('pack') || p.data.categorySlug === 'packs-promocionales';
        const isOfferBadge = (p.data.badge || '').toLowerCase().includes('off') || (p.data.badge || '').toLowerCase().includes('oferta');
        return hasDiscount || hasOriginalPrice || isPack || isOfferBadge || p.data.isOffer === true;
      },
    },
    'ofertas-flash': {
      title: 'Ofertas Flash & Descuentos',
      subtitle: 'Descuentos exclusivos de hasta 32% OFF en alimentos seleccionados, packs de bienvenida, accesorios y combos mensuales',
      icon: '🔥',
      filter: (p) => {
        const hasDiscount = Boolean(p.data.discount);
        const hasOriginalPrice = Boolean(p.data.originalPrice && p.data.originalPrice > p.data.price);
        const isPack = (p.data.category || '').toLowerCase().includes('pack') || p.data.categorySlug === 'packs-promocionales';
        const isOfferBadge = (p.data.badge || '').toLowerCase().includes('off') || (p.data.badge || '').toLowerCase().includes('oferta');
        return hasDiscount || hasOriginalPrice || isPack || isOfferBadge || p.data.isOffer === true;
      },
    },
    mascotas: {
      title: 'Especial Etapas de Vida (Perros & Gatos)',
      subtitle: 'Nutrición, suplementación y cuidados seleccionados para cachorros, gatitos, adultos y seniors',
      icon: '🐾',
      filter: (p) => {
        const stage = p.data.lifeStage || '';
        const name = (p.data.name || '').toLowerCase();
        const slug = (p.data.slug || '').toLowerCase();
        return (
          stage === 'cachorros' ||
          stage === 'adultos' ||
          stage === 'seniors' ||
          name.includes('adulto') ||
          name.includes('senior') ||
          name.includes('cachorro') ||
          name.includes('gatito') ||
          name.includes('esterilizado') ||
          name.includes('articular') ||
          name.includes('ortopédica') ||
          slug.includes('senior') ||
          slug.includes('cachorro')
        );
      },
    },
  };

  return Object.entries(categoriesMap).map(([slug, meta]) => ({
    params: { categoria: slug },
    props: {
      slug,
      meta,
      products: allProducts.filter(meta.filter),
    },
  }));
}

const { slug, meta, products } = Astro.props;

function formatPrice(amount) {
  if (!amount) return '';
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0,
  }).format(amount);
}
---

<BaseLayout
  title={`${meta.title} | Market-Pet Chile`}
  description={meta.subtitle}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-rose-600 transition-colors">Inicio</a>
      <span>/</span>
      <a href="/catalogo" class="hover:text-rose-600 transition-colors">Catálogo</a>
      <span>/</span>
      <span class="text-stone-900 font-bold">{meta.title}</span>
    </nav>

    <!-- Banner Encabezado de la Categoría -->
    <div class="mb-8 p-6 sm:p-8 rounded-3xl bg-white border border-stone-200/80 shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-50 text-rose-600 border border-rose-200">
          <span>{meta.icon}</span>
          <span>CATEGORÍA DESTACADA</span>
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-stone-900 tracking-tight">
          {meta.title}
        </h1>
        <p class="text-xs sm:text-sm text-stone-600 max-w-xl leading-relaxed">
          {meta.subtitle}
        </p>
      </div>

      <div class="bg-[#FAF7F2] p-4 rounded-2xl border border-[#E8E2D9] text-center shrink-0 self-start md:self-auto min-w-[140px]">
        <span id="category-banner-count" class="block text-3xl font-black text-stone-900 leading-none">{products.length}</span>
        <span class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mt-1 block">
          Productos disponibles
        </span>
      </div>
    </div>

    {
      products.length > 0 && (
        <div class="mb-8 bg-white p-4 sm:p-5 rounded-2xl border border-stone-200/80 shadow-xs">
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative w-full flex-1">
              <label for="category-search-input" class="sr-only">Buscar en {meta.title}</label>
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
                </svg>
              </div>
              <input
                type="search"
                id="category-search-input"
                placeholder={`Buscar por nombre en ${meta.title} (ej. Salmón, Pack, Arnés)...`}
                class="w-full pl-10 pr-24 py-2.5 rounded-xl border border-stone-200 bg-stone-50/50 text-sm text-stone-800 placeholder-stone-400 focus:outline-none focus:border-rose-500 focus:bg-white focus:ring-2 focus:ring-rose-100 transition-all"
              />
              <button
                type="button"
                id="clear-category-search-btn"
                class="hidden absolute inset-y-1.5 right-2 px-2.5 rounded-lg text-xs font-semibold text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition-all cursor-pointer items-center"
              >
                ✕ Limpiar
              </button>
            </div>

            <div class="w-full sm:w-auto flex items-center justify-between sm:justify-end gap-2 shrink-0">
              <label for="category-sort-select" class="text-xs font-semibold text-stone-500 whitespace-nowrap">Ordenar por:</label>
              <select
                id="category-sort-select"
                class="px-3 py-2 bg-stone-50 border border-stone-200 rounded-xl text-xs font-bold text-stone-700 focus:outline-none focus:border-rose-400 cursor-pointer"
              >
                <option value="featured">Destacados</option>
                <option value="price-asc">Menor precio</option>
                <option value="price-desc">Mayor precio</option>
                <option value="rating">Mejor valorados</option>
              </select>
            </div>
          </div>

          <!-- Fila 2: Píldoras de Filtro Rápido por Mascota -->
          <div class="mt-3 pt-3 border-t border-stone-100 flex items-center gap-2 overflow-x-auto pb-1 text-xs">
            <span class="text-stone-400 font-bold uppercase text-[10px] tracking-wider shrink-0 mr-1">Filtrar:</span>
            <button
              type="button"
              class="category-pet-filter-btn px-3 py-1.5 rounded-xl font-bold transition-all cursor-pointer bg-rose-600 text-white shadow-xs"
              data-pet-filter="todos"
            >
              Todos
            </button>
            <button
              type="button"
              class="category-pet-filter-btn px-3 py-1.5 rounded-xl font-bold transition-all cursor-pointer bg-stone-100 text-stone-700 hover:bg-stone-200"
              data-pet-filter="perros"
            >
              🐶 Perros
            </button>
            <button
              type="button"
              class="category-pet-filter-btn px-3 py-1.5 rounded-xl font-bold transition-all cursor-pointer bg-stone-100 text-stone-700 hover:bg-stone-200"
              data-pet-filter="gatos"
            >
              🐱 Gatos
            </button>
          </div>

          <!-- Contador reactivo -->
          <div class="mt-3 pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
            <span>
              Mostrando <strong id="category-visible-count" class="text-stone-900 font-bold">{products.length}</strong> de <strong class="text-stone-900 font-bold">{products.length}</strong> productos
            </span>
            <a href="/catalogo" class="text-rose-600 hover:text-rose-700 font-bold hover:underline">
              Ver todo el catálogo →
            </a>
          </div>
        </div>
      )
    }

    <!-- Grilla de Productos de la Categoría -->
    {
      products.length > 0 ? (
        <>
          <div id="category-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            {products.map((prod) => (
              <article
                class="category-product-card flex flex-col bg-white rounded-2xl border border-stone-200/90 hover:border-rose-400 hover:shadow-lg transition-all duration-200 group overflow-hidden"
                data-name={prod.data.name}
                data-price={prod.data.price}
                data-rating={prod.data.rating}
                data-pet={prod.data.petType}
              >
                <a
                  href={`/producto/${prod.data.slug}`}
                  class="relative aspect-square w-full bg-stone-50 overflow-hidden flex items-center justify-center block cursor-pointer"
                >
                  {prod.data.badge && (
                    <span
                      class={`absolute top-2 left-2 z-10 px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider shadow-xs ${prod.data.badgeColor || 'bg-rose-600 text-white'}`}
                    >
                      {prod.data.badge}
                    </span>
                  )}

                  <Image
                    src={prod.data.image}
                    alt={prod.data.imageAlt || prod.data.name}
                    width={320}
                    height={320}
                    format="webp"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </a>

                <div class="p-3.5 sm:p-4 flex flex-col flex-1">
                  <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400 mb-1 truncate">
                    {prod.data.category}
                  </span>

                  <h2 class="text-xs sm:text-sm font-bold text-stone-900 group-hover:text-rose-600 transition-colors line-clamp-2 leading-snug mb-2 flex-1">
                    <a
                      href={`/producto/${prod.data.slug}`}
                      class="hover:text-rose-600 transition-colors"
                    >
                      {prod.data.name}
                    </a>
                  </h2>

                  <div class="flex items-center gap-1 text-[11px] text-amber-500 mb-2">
                    <span>★</span>
                    <span class="font-bold text-stone-700">{prod.data.rating}</span>
                    <span class="text-stone-400 text-[10px]">({prod.data.reviewsCount})</span>
                  </div>

                  <div class="pt-2.5 border-t border-stone-100 flex flex-col gap-2 mt-auto">
                    <div class="flex items-baseline justify-between gap-1">
                      <div class="flex flex-col">
                        <span class="text-sm sm:text-base font-black text-stone-900 leading-none">
                          {formatPrice(prod.data.price)}
                        </span>
                        {prod.data.originalPrice && (
                          <span class="text-[11px] text-stone-400 line-through mt-0.5 leading-none">
                            {formatPrice(prod.data.originalPrice)}
                          </span>
                        )}
                      </div>
                      {prod.data.discount && (
                        <span class="text-[10px] font-black text-rose-600 bg-rose-50 px-1.5 py-0.5 rounded">
                          {prod.data.discount}
                        </span>
                      )}
                    </div>

                    <button
                      type="button"
                      data-add-to-cart
                      data-product-id={prod.data.id}
                      data-product-name={prod.data.name}
                      data-product-price={prod.data.price}
                      class="add-to-cart-btn w-full py-2.5 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 active:scale-95 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500"
                      aria-label={`Añadir ${prod.data.name} al carrito`}
                    >
                      <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                        <path d="M2.25 2.25a.75.75 0 000 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 00-2.806 3.63c0 .414.336.75.75.75h14.5a.75.75 0 000-1.5H4.35a2.25 2.25 0 012.18-1.75h10.97a3 3 0 002.894-2.21l1.5-5.75a.75.75 0 00-.724-.94H5.614l-.45-1.688A1.875 1.875 0 003.386 2.25H2.25zM6.75 20.25a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zm9 0a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0z" />
                      </svg>
                      <span class="btn-text">Agregar al carrito</span>
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Estado Vacío cuando la búsqueda no arroja resultados en esta categoría -->
          <div
            id="category-no-results"
            class="hidden text-center py-16 bg-white rounded-3xl border border-stone-200/80 p-8 shadow-xs"
          >
            <div class="w-16 h-16 bg-rose-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl">
              🔍
            </div>
            <h3 class="text-lg font-black text-stone-900 mb-1">
              No encontramos productos coincidentes
            </h3>
            <p class="text-xs sm:text-sm text-stone-500 max-w-md mx-auto mb-6">
              No hay productos en esta categoría que coincidan con tu búsqueda. Prueba con otro término o explora el catálogo completo.
            </p>
            <div class="flex items-center justify-center gap-3">
              <button
                type="button"
                id="btn-category-reset"
                class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-xs transition-colors cursor-pointer"
              >
                Limpiar búsqueda
              </button>
              <a
                href="/catalogo"
                class="px-5 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold text-xs transition-colors"
              >
                Ver catálogo completo
              </a>
            </div>
          </div>
        </>
      ) : (
        <div class="text-center py-16 bg-white rounded-3xl border border-stone-200/80 p-8 shadow-xs">
          <span class="text-4xl">🐾</span>
          <h3 class="text-lg font-bold text-stone-900 mt-3">Pronto tendremos más productos aquí</h3>
          <p class="text-xs sm:text-sm text-stone-500 mt-1">Estamos renovando el stock de esta categoría.</p>
          <a
            href="/catalogo"
            class="mt-4 inline-block px-6 py-2.5 rounded-xl bg-rose-600 text-white font-bold text-xs hover:bg-rose-700 transition-colors"
          >
            Ver catálogo completo
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  // Barra de búsqueda, filtros rápidos por mascota y ordenamiento reactivo (JavaScript nativo)
  const searchInput = document.getElementById('category-search-input');
  const clearBtn = document.getElementById('clear-category-search-btn');
  const sortSelect = document.getElementById('category-sort-select');
  const petFilterButtons = document.querySelectorAll('.category-pet-filter-btn');
  const cards = Array.from(document.querySelectorAll('.category-product-card'));
  const grid = document.getElementById('category-products-grid');
  const noResults = document.getElementById('category-no-results');
  const visibleCount = document.getElementById('category-visible-count');
  const bannerCount = document.getElementById('category-banner-count');
  const resetBtn = document.getElementById('btn-category-reset');

  let searchQuery = '';
  let currentPetFilter = 'todos';

  function normalize(str) {
    if (!str) return '';
    return str
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function applyCategoryFilter() {
    const cleanQuery = normalize(searchQuery);

    let visibleCards = cards.filter((card) => {
      // 1. Filtrado por tipo de mascota (perros / gatos / todos)
      const cardPet = card.getAttribute('data-pet') || '';
      let matchesPet = true;
      if (currentPetFilter !== 'todos') {
        matchesPet = cardPet === currentPetFilter || cardPet === 'todas';
      }

      // 2. Filtrado por barra de búsqueda (nombre)
      let matchesSearch = true;
      if (cleanQuery) {
        const name = normalize(card.getAttribute('data-name') || '');
        matchesSearch = name.includes(cleanQuery);
      }

      return matchesPet && matchesSearch;
    });

    // Ordenamiento
    const sortVal = sortSelect?.value || 'featured';
    visibleCards.sort((a, b) => {
      const priceA = parseInt(a.getAttribute('data-price') || '0', 10);
      const priceB = parseInt(b.getAttribute('data-price') || '0', 10);
      const ratingA = parseFloat(a.getAttribute('data-rating') || '0');
      const ratingB = parseFloat(b.getAttribute('data-rating') || '0');

      if (sortVal === 'price-asc') return priceA - priceB;
      if (sortVal === 'price-desc') return priceB - priceA;
      if (sortVal === 'rating') return ratingB - ratingA;
      return 0;
    });

    cards.forEach((c) => (c.style.display = 'none'));
    visibleCards.forEach((c) => {
      c.style.display = 'flex';
      if (grid) grid.appendChild(c);
    });

    if (visibleCount) visibleCount.textContent = String(visibleCards.length);
    if (bannerCount) bannerCount.textContent = String(visibleCards.length);

    if (noResults && grid) {
      if (visibleCards.length === 0) {
        noResults.classList.remove('hidden');
        grid.classList.add('hidden');
      } else {
        noResults.classList.add('hidden');
        grid.classList.remove('hidden');
      }
    }
  }

  // Eventos de botones de filtro por tipo de mascota
  petFilterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      petFilterButtons.forEach((b) => {
        b.classList.remove('bg-rose-600', 'text-white', 'shadow-xs');
        b.classList.add('bg-stone-100', 'text-stone-700');
      });
      btn.classList.remove('bg-stone-100', 'text-stone-700');
      btn.classList.add('bg-rose-600', 'text-white', 'shadow-xs');

      currentPetFilter = btn.getAttribute('data-pet-filter') || 'todos';
      applyCategoryFilter();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value;
    if (clearBtn) {
      if (searchQuery.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    }
    applyCategoryFilter();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchQuery = '';
    }
    clearBtn.classList.add('hidden');
    applyCategoryFilter();
    searchInput?.focus();
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchQuery = '';
    }
    clearBtn?.classList.add('hidden');
    const todosBtn = document.querySelector('[data-pet-filter="todos"]');
    if (todosBtn) {
      todosBtn.click();
    } else {
      currentPetFilter = 'todos';
      applyCategoryFilter();
    }
  });

  sortSelect?.addEventListener('change', () => {
    applyCategoryFilter();
  });

  // Inicializar filtro de mascota y búsqueda desde parámetros URL si existen (ej. ?pet=perros o ?q=glucosamina)
  const urlParams = new URLSearchParams(window.location.search);
  const petParam = urlParams.get('pet') || urlParams.get('mascota') || urlParams.get('filtro');
  const queryParam = urlParams.get('q') || urlParams.get('search');

  if (queryParam && searchInput) {
    searchInput.value = queryParam;
    searchQuery = queryParam;
    clearBtn?.classList.remove('hidden');
  }

  if (petParam) {
    const targetPetBtn = document.querySelector(`[data-pet-filter="${petParam}"]`);
    if (targetPetBtn) {
      targetPetBtn.click();
    } else {
      applyCategoryFilter();
    }
  } else {
    applyCategoryFilter();
  }

  // Manejo accesible y claro al agregar al carrito en categorías (JavaScript nativo)
  document.querySelectorAll('.add-to-cart-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget;
      const textSpan = button.querySelector('.btn-text');
      const originalText = textSpan ? textSpan.textContent : 'Agregar al carrito';

      button.classList.add('!bg-emerald-600', 'scale-98');
      if (textSpan) textSpan.textContent = '¡Agregado!';

      setTimeout(() => {
        button.classList.remove('!bg-emerald-600', 'scale-98');
        if (textSpan) textSpan.textContent = originalText;
      }, 700);

      const badge = document.getElementById('cart-count-badge');
      if (badge) {
        const currentCount = parseInt(badge.textContent || '0', 10);
        badge.textContent = String(currentCount + 1);
        badge.classList.add('scale-125', '!bg-rose-600', '!text-white', 'transition-transform');
        setTimeout(() => {
          badge.classList.remove('scale-125', '!bg-rose-600', '!text-white');
        }, 400);
      }
    });
  });
</script>
