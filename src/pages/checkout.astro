---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Finalizar Compra Segura | Market-Pet Chile"
  description="Completa tu pedido de forma rápida y segura en Market-Pet. Despacho a todo Chile y múltiples medios de pago."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400 mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-rose-600 dark:hover:text-rose-400 transition-colors">Inicio</a>
      <span>/</span>
      <a href="/carrito" class="hover:text-rose-600 dark:hover:text-rose-400 transition-colors">Carrito</a>
      <span>/</span>
      <span class="text-stone-900 dark:text-white font-bold">Checkout Seguro</span>
    </nav>

    <!-- Stepper de 4 Pasos -->
    <div class="mb-8">
      <div class="bg-white dark:bg-[#1d1816] rounded-2xl p-4 sm:p-5 border border-stone-200/80 dark:border-[#2d2521] shadow-2xs">
        <div class="grid grid-cols-4 gap-2 text-center text-xs">
          <!-- Paso 1 -->
          <div id="step-nav-1" class="step-nav-item flex flex-col items-center gap-1.5 transition-all text-rose-600 dark:text-rose-400 font-extrabold cursor-pointer">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-black bg-rose-600 text-white shadow-xs">
              1
            </div>
            <span class="text-[11px] sm:text-xs">Identificación</span>
          </div>

          <!-- Paso 2 -->
          <div id="step-nav-2" class="step-nav-item flex flex-col items-center gap-1.5 transition-all text-stone-400 dark:text-stone-500 font-medium">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-black bg-stone-100 dark:bg-[#27201c] text-stone-500 dark:text-stone-400">
              2
            </div>
            <span class="text-[11px] sm:text-xs">Dirección</span>
          </div>

          <!-- Paso 3 -->
          <div id="step-nav-3" class="step-nav-item flex flex-col items-center gap-1.5 transition-all text-stone-400 dark:text-stone-500 font-medium">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-black bg-stone-100 dark:bg-[#27201c] text-stone-500 dark:text-stone-400">
              3
            </div>
            <span class="text-[11px] sm:text-xs">Despacho</span>
          </div>

          <!-- Paso 4 -->
          <div id="step-nav-4" class="step-nav-item flex flex-col items-center gap-1.5 transition-all text-stone-400 dark:text-stone-500 font-medium">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-black bg-stone-100 dark:bg-[#27201c] text-stone-500 dark:text-stone-400">
              4
            </div>
            <span class="text-[11px] sm:text-xs">Pago</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenedor Principal: 2 Columnas (Formularios y Resumen Siempre Visible) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Columna Izquierda: Pasos del Checkout (lg:col-span-7) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Contenedor de Pasos -->
        <div id="checkout-steps-container" class="bg-white dark:bg-[#1d1816] rounded-3xl p-6 sm:p-8 border border-stone-200/80 dark:border-[#2d2521] shadow-2xs">
          <!-- PASO 1: Identificación Priorizando Iniciar Sesión -->
          <section id="step-1" class="space-y-6">
            <!-- CASO A: Usuario ya autenticado -->
            <div id="step1-logged-view" class="hidden space-y-5">
              <div class="border-b border-stone-100 dark:border-[#2d2521] pb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block mb-1">
                  Paso 1 de 4 · Sesión Activa
                </span>
                <h2 class="text-xl font-black text-stone-900 dark:text-white">
                  ¡Hola de nuevo, <span id="step1-logged-user-name">Cliente</span>!
                </h2>
                <p class="text-xs text-stone-500 dark:text-[#b0a297] mt-0.5">
                  Confirmamos tus datos personales antes de ingresar la dirección de despacho.
                </p>
              </div>

              <div class="p-4 rounded-2xl bg-stone-50 dark:bg-[#141110] border border-stone-200/70 dark:border-[#2d2521] space-y-2 text-xs">
                <div class="flex items-center justify-between">
                  <span class="text-stone-500 dark:text-[#b0a297]">Cuenta activa:</span>
                  <strong id="step1-logged-email-text" class="text-stone-900 dark:text-white font-bold">usuario@correo.cl</strong>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-stone-500 dark:text-[#b0a297]">Nombre de contacto:</span>
                  <span id="step1-logged-name-text" class="text-stone-900 dark:text-white font-bold">Nombre</span>
                </div>
              </div>

              <!-- RUT o DNI para emisión de boleta -->
              <form id="form-step-1-logged" novalidate class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="step1-logged-rut" class="block text-xs font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                      RUT o DNI (para boleta electrónica) *
                    </label>
                    <input
                      type="text"
                      id="step1-logged-rut"
                      placeholder="12.345.678-9"
                      class="w-full px-3.5 py-2.5 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-stone-50/50 dark:bg-[#141110] text-stone-900 dark:text-white placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-500"
                    />
                    <p id="err-step1-logged-rut" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
                  </div>
                  <div>
                    <label for="step1-logged-phone" class="block text-xs font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                      Teléfono móvil de contacto *
                    </label>
                    <input
                      type="tel"
                      id="step1-logged-phone"
                      placeholder="+56 9 8765 4321"
                      class="w-full px-3.5 py-2.5 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-stone-50/50 dark:bg-[#141110] text-stone-900 dark:text-white placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-500"
                    />
                    <p id="err-step1-logged-phone" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
                  </div>
                </div>

                <div class="pt-2 flex items-center justify-between">
                  <a
                    href="/auth/login?redirect=/checkout"
                    class="text-xs font-bold text-stone-500 hover:text-stone-900 dark:hover:text-white underline"
                  >
                    ¿No eres tú? Cambiar de cuenta
                  </a>
                  <button
                    type="submit"
                    class="px-6 py-3.5 rounded-xl bg-rose-600 hover:bg-rose-700 active:scale-98 text-white font-extrabold text-xs shadow-md transition-all cursor-pointer flex items-center gap-2"
                  >
                    <span>Continuar a Dirección de Envío</span>
                    <svg class="w-4 h-4 stroke-current stroke-2" fill="none" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </button>
                </div>
              </form>
            </div>

            <!-- CASO B: Usuario NO autenticado (Prioriza Iniciar Sesión y Redirigir a Crear Cuenta) -->
            <div id="step1-guest-view" class="space-y-6">
              <div class="border-b border-stone-100 dark:border-[#2d2521] pb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 block mb-1">
                  Paso 1 de 4
                </span>
                <h2 class="text-xl font-black text-stone-900 dark:text-white">
                  Identifícate para continuar tu compra
                </h2>
                <p class="text-xs text-stone-500 dark:text-[#b0a297] mt-0.5">
                  Inicia sesión con tu cuenta de Market-Pet o regístrate para continuar tu pedido.
                </p>
              </div>

              <!-- Banner Especial: Sesión de Prueba / Demo Ficticia -->
              <div class="p-4 rounded-2xl bg-amber-50/80 dark:bg-[#141110] border border-amber-200/80 dark:border-[#382d27] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 stroke-current stroke-2 shrink-0" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693l-1.57-.393m15.6 0l1.106 4.423A1.5 1.5 0 0119.48 21.5H4.52a1.5 1.5 0 01-1.456-1.777l1.106-4.423" />
                  </svg>
                  <span class="text-stone-700 dark:text-stone-300">
                    ¿Quieres probar la tienda? Inicia sesión con 1 clic usando una <strong>cuenta de prueba con datos ficticios</strong>.
                  </span>
                </div>
                <button
                  type="button"
                  id="btn-load-demo-session"
                  class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 active:scale-95 text-white font-extrabold text-xs shadow-xs transition-all shrink-0 cursor-pointer flex items-center justify-center gap-1.5"
                >
                  <span>Cargar Sesión Demo</span>
                  <svg class="w-3.5 h-3.5 stroke-current stroke-2" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </button>
              </div>

              <!-- Bloque Prioritario: Iniciar Sesión Rápido -->
              <div class="p-5 rounded-2xl bg-stone-50/70 dark:bg-[#141110] border border-stone-200/80 dark:border-[#2d2521] space-y-4">
                <div class="flex items-center gap-2 text-xs font-extrabold text-stone-900 dark:text-white">
                  <svg class="w-4 h-4 text-rose-600 dark:text-rose-400 stroke-current stroke-2" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                  </svg>
                  <span>Iniciar Sesión en Market-Pet</span>
                </div>

                <form id="form-step1-fast-login" novalidate class="space-y-3">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label for="step1-login-email" class="block text-[11px] font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                        Correo Electrónico *
                      </label>
                      <input
                        type="email"
                        id="step1-login-email"
                        placeholder="ejemplo@correo.cl"
                        class="w-full px-3.5 py-2 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-white dark:bg-[#1d1816] text-stone-900 dark:text-white placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-500"
                      />
                      <p id="err-step1-login-email" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
                    </div>

                    <div>
                      <label for="step1-login-pass" class="block text-[11px] font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                        Contraseña *
                      </label>
                      <div class="relative">
                        <input
                          type="password"
                          id="step1-login-pass"
                          placeholder="Tu contraseña"
                          class="w-full px-3.5 py-2 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-white dark:bg-[#1d1816] text-stone-900 dark:text-white placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-500 pr-9"
                        />
                        <button
                          type="button"
                          id="toggle-step1-pass"
                          aria-label="Ver contraseña"
                          class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 cursor-pointer"
                        >
                          <svg id="icon-step1-eye" class="w-4 h-4 stroke-current stroke-2" fill="none" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          <svg id="icon-step1-eye-off" class="w-4 h-4 stroke-current stroke-2 hidden" fill="none" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                          </svg>
                        </button>
                      </div>
                      <p id="err-step1-login-pass" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
                    </div>
                  </div>

                  <div class="pt-1 flex items-center justify-between">
                    <span class="text-[11px] text-stone-500 dark:text-[#b0a297]">
                      Ingresa para continuar de inmediato.
                    </span>
                    <button
                      type="submit"
                      class="px-5 py-2.5 rounded-xl bg-stone-900 hover:bg-black dark:bg-stone-100 dark:hover:bg-white text-white dark:text-stone-900 font-extrabold text-xs transition-colors cursor-pointer"
                    >
                      Iniciar Sesión
                    </button>
                  </div>
                </form>
              </div>

              <!-- Bloque: ¿No tienes cuenta? -> Redirige a Crear Cuenta -->
              <div class="p-5 rounded-2xl border-2 border-dashed border-stone-200 dark:border-[#382d27] text-center space-y-2.5">
                <span class="text-xs font-bold text-stone-700 dark:text-[#fbf6f0] block">
                  ¿Aún no tienes una cuenta en Market-Pet?
                </span>
                <p class="text-xs text-stone-500 dark:text-[#b0a297] max-w-sm mx-auto">
                  Crea tu cuenta en 1 minuto para guardar tus direcciones, acumular puntos y continuar tu compra.
                </p>
                <a
                  href="/auth/login?tab=register&redirect=/checkout"
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-rose-600 hover:bg-rose-700 active:scale-98 text-white font-black text-xs shadow-md transition-all cursor-pointer"
                >
                  <span>Crear Cuenta</span>
                  <svg class="w-4 h-4 stroke-current stroke-2" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </section>

          <!-- PASO 2: Dirección y Comuna de Despacho -->
          <section id="step-2" class="space-y-6 hidden">
            <div class="border-b border-stone-100 dark:border-[#2d2521] pb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 block mb-1">
                Paso 2 de 4
              </span>
              <h2 class="text-xl font-black text-stone-900 dark:text-white">
                Dirección de Despacho
              </h2>
              <p class="text-xs text-stone-500 dark:text-[#b0a297] mt-0.5">
                Ingresa la ubicación exacta donde recibirás los artículos para tus mascotas en Chile.
              </p>
            </div>

            <form id="form-step-2" novalidate class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="step2-region" class="block text-xs font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                    Región *
                  </label>
                  <select
                    id="step2-region"
                    class="w-full px-3.5 py-2.5 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-stone-50/50 dark:bg-[#141110] text-stone-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500"
                  >
                    <option value="metropolitana">Región Metropolitana de Santiago</option>
                    <option value="valparaiso">Región de Valparaíso</option>
                    <option value="biobio">Región del Biobío</option>
                    <option value="coquimbo">Región de Coquimbo</option>
                    <option value="otra">Otra Región de Chile</option>
                  </select>
                </div>
                <div>
                  <label for="step2-comuna" class="block text-xs font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                    Comuna de Entrega *
                  </label>
                  <select
                    id="step2-comuna"
                    class="w-full px-3.5 py-2.5 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-stone-50/50 dark:bg-[#141110] text-stone-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500"
                  >
                    <option value="Providencia">Providencia</option>
                    <option value="Las Condes">Las Condes</option>
                    <option value="Santiago Centro">Santiago Centro</option>
                    <option value="Ñuñoa">Ñuñoa</option>
                    <option value="Vitacura">Vitacura</option>
                    <option value="La Reina">La Reina</option>
                    <option value="Maipú">Maipú</option>
                    <option value="La Florida">La Florida</option>
                    <option value="Viña del Mar">Viña del Mar</option>
                    <option value="Concepción">Concepción</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-2">
                  <label for="step2-address" class="block text-xs font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                    Calle y Número *
                  </label>
                  <input
                    type="text"
                    id="step2-address"
                    placeholder="Ej. Av. Pedro de Valdivia 1234"
                    class="w-full px-3.5 py-2.5 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-stone-50/50 dark:bg-[#141110] text-stone-900 dark:text-white placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-500"
                  />
                  <p id="err-step2-address" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
                </div>
                <div>
                  <label for="step2-dept" class="block text-xs font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                    Depto / Casa (Opcional)
                  </label>
                  <input
                    type="text"
                    id="step2-dept"
                    placeholder="Ej. Depto 402"
                    class="w-full px-3.5 py-2.5 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-stone-50/50 dark:bg-[#141110] text-stone-900 dark:text-white placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-500"
                  />
                </div>
              </div>

              <div>
                <label for="step2-notes" class="block text-xs font-bold text-stone-700 dark:text-[#fbf6f0] mb-1">
                  Instrucciones o Referencias para el Repartidor
                </label>
                <input
                  type="text"
                  id="step2-notes"
                  placeholder="Ej. Dejar con conserje, portón verde, llamar al llegar..."
                  class="w-full px-3.5 py-2.5 rounded-xl text-xs border border-stone-300 dark:border-[#382d27] bg-stone-50/50 dark:bg-[#141110] text-stone-900 dark:text-white placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-500"
                />
              </div>

              <div class="pt-4 flex items-center justify-between">
                <button
                  type="button"
                  id="btn-back-to-step-1"
                  class="px-5 py-3 rounded-xl border border-stone-200 dark:border-[#382d27] bg-white dark:bg-[#141110] text-stone-700 dark:text-stone-300 hover:bg-stone-50 font-bold text-xs transition-colors cursor-pointer"
                >
                  ← Volver a Datos
                </button>
                <button
                  type="submit"
                  class="px-6 py-3.5 rounded-xl bg-rose-600 hover:bg-rose-700 active:scale-98 text-white font-extrabold text-xs shadow-md transition-all cursor-pointer flex items-center gap-2"
                >
                  <span>Continuar a Despacho</span>
                  <svg class="w-4 h-4 stroke-current stroke-2" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </button>
              </div>
            </form>
          </section>

          <!-- PASO 3: Método de Envío -->
          <section id="step-3" class="space-y-6 hidden">
            <div class="border-b border-stone-100 dark:border-[#2d2521] pb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 block mb-1">
                Paso 3 de 4
              </span>
              <h2 class="text-xl font-black text-stone-900 dark:text-white">
                Elige tu Método de Entrega
              </h2>
              <p class="text-xs text-stone-500 dark:text-[#b0a297] mt-0.5">
                Selecciona la velocidad de despacho que mejor se adapte a tus necesidades.
              </p>
            </div>

            <form id="form-step-3" class="space-y-3">
              <!-- Opción 1: Estándar -->
              <label class="shipping-option flex items-center justify-between p-4 rounded-2xl border-2 border-rose-600 bg-rose-50/20 dark:bg-rose-950/20 cursor-pointer transition-all">
                <div class="flex items-center gap-3">
                  <input
                    type="radio"
                    name="shipping-method"
                    value="standard"
                    checked
                    class="h-4 w-4 text-rose-600 focus:ring-rose-500"
                  />
                  <div>
                    <span class="text-xs sm:text-sm font-bold text-stone-900 dark:text-white flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-stone-700 dark:text-stone-300 stroke-current stroke-2 shrink-0" fill="none" viewBox="0 0 24 24">
