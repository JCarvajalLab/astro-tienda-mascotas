<script>
  // Control del Flujo Multi-Paso de Checkout con Prioridad de Inicio de Sesión (JavaScript Nativo Puro)
  const CART_KEY = 'market_pet_cart';
  const FREE_SHIPPING_THRESHOLD = 25000;
  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  let currentStep = 1;
  let selectedShippingMethod = 'standard';
  let selectedPaymentMethod = 'webpay';
  let appliedCoupon = null;
  let orderData = {
    nombre: '',
    rut: '',
    email: '',
    telefono: '',
    region: 'metropolitana',
    comuna: 'Providencia',
    direccion: '',
    depto: '',
    notas: '',
  };

  function formatCLP(amount) {
    return new Intl.NumberFormat('es-CL', {
      style: 'currency',
      currency: 'CLP',
      maximumFractionDigits: 0,
    }).format(amount);
  }

  function getCart() {
    try {
      const stored = localStorage.getItem(CART_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch {
      return [];
    }
  }

  function setCheckoutError(fieldId, errId, message) {
    const input = document.getElementById(fieldId);
    const err = document.getElementById(errId);
    if (input) {
      if (message) {
        input.classList.add('border-rose-500', 'focus:ring-rose-500');
        input.classList.remove('border-stone-300', 'dark:border-[#382d27]');
      } else {
        input.classList.remove('border-rose-500');
        input.classList.add('border-stone-300', 'dark:border-[#382d27]');
      }
    }
    if (err) {
      if (message) {
        err.textContent = message;
        err.classList.remove('hidden');
      } else {
        err.textContent = '';
        err.classList.add('hidden');
      }
    }
  }

  function calculateShippingCost(subtotal) {
    if (selectedShippingMethod === 'pickup') return 0;
    if (selectedShippingMethod === 'express') return 5990;
    return subtotal >= FREE_SHIPPING_THRESHOLD ? 0 : 3990;
  }

  function renderCheckoutSummary() {
    const cart = getCart();
    const itemsList = document.getElementById('checkout-items-list');
    const badgeEl = document.getElementById('checkout-summary-badge');
    const subtotalEl = document.getElementById('checkout-subtotal-val');
    const shippingEl = document.getElementById('checkout-shipping-val');
    const discountRow = document.getElementById('checkout-discount-row');
    const discountVal = document.getElementById('checkout-discount-val');
    const totalEl = document.getElementById('checkout-total-val');
    const standardPriceEl = document.getElementById('shipping-opt-standard-price');
    const confirmBtn = document.getElementById('btn-confirm-payment');

    const totalQty = cart.reduce((acc, it) => acc + it.quantity, 0);
    const subtotal = cart.reduce((acc, it) => acc + it.price * it.quantity, 0);
    const shippingCost = calculateShippingCost(subtotal);

    let couponDiscount = 0;
    const couponRow = document.getElementById('checkout-coupon-row');
    const couponLabel = document.getElementById('checkout-coupon-label');
    const couponVal = document.getElementById('checkout-coupon-val');
    if (appliedCoupon) {
      couponDiscount = Math.round(subtotal * (appliedCoupon.percent / 100));
      if (couponRow && couponVal && couponLabel) {
        couponRow.classList.remove('hidden');
        couponLabel.textContent = `Cupón ${appliedCoupon.code} (-${appliedCoupon.percent}%)`;
        couponVal.textContent = `-${formatCLP(couponDiscount)}`;
      }
    } else if (couponRow) {
      couponRow.classList.add('hidden');
    }

    let discount = 0;
    if (selectedPaymentMethod === 'transfer') {
      discount = Math.round((subtotal - couponDiscount) * 0.05);
    }

    const total = Math.max(0, subtotal - couponDiscount - discount + (cart.length > 0 ? shippingCost : 0));

    if (badgeEl) badgeEl.textContent = `${totalQty} artículos`;
    if (subtotalEl) subtotalEl.textContent = formatCLP(subtotal);

    if (standardPriceEl) {
      standardPriceEl.textContent = subtotal >= FREE_SHIPPING_THRESHOLD ? '¡GRATIS!' : '$3.990';
    }

    if (discountRow && discountVal) {
      if (discount > 0) {
        discountRow.classList.remove('hidden');
        discountVal.textContent = `-${formatCLP(discount)}`;
      } else {
        discountRow.classList.add('hidden');
      }
    }

    if (shippingEl) {
      if (shippingCost === 0) {
        shippingEl.textContent = '¡GRATIS!';
        shippingEl.className = 'font-black text-emerald-600 dark:text-emerald-400';
      } else {
        shippingEl.textContent = formatCLP(shippingCost);
        shippingEl.className = 'font-bold text-stone-900 dark:text-white';
      }
    }

    if (totalEl) totalEl.textContent = formatCLP(total);

    if (confirmBtn) {
      const paymentName = selectedPaymentMethod === 'transfer' ? 'Transferencia' : selectedPaymentMethod === 'mercadopago' ? 'Mercado Pago' : 'Webpay';
      confirmBtn.innerHTML = `<span>Pagar ${formatCLP(total)} con ${paymentName}</span><svg class="w-4 h-4 stroke-current stroke-2" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>`;
    }

    if (itemsList) {
      itemsList.replaceChildren();

      if (cart.length === 0) {
        const li = document.createElement('li');
        li.className = 'py-4 text-center text-xs text-stone-400';
        li.textContent = 'No hay productos en el carrito. ';
        const link = document.createElement('a');
        link.href = '/catalogo';
        link.className = 'text-rose-600 dark:text-rose-400 font-bold underline';
        link.textContent = 'Ir a comprar';
        li.appendChild(link);
        itemsList.appendChild(li);
        return;
      }

      cart.forEach((it) => {
        const li = document.createElement('li');
        li.className = 'py-3 flex items-center justify-between gap-3';

        const left = document.createElement('div');
        left.className = 'flex items-center gap-3 min-w-0';

        const imgWrap = document.createElement('div');
        imgWrap.className = 'w-12 h-12 rounded-xl bg-stone-100 dark:bg-[#27201c] p-1 border border-stone-200/60 dark:border-[#382d27] shrink-0 overflow-hidden';
        const img = document.createElement('img');
        img.src = it.image || '/favicon.svg';
        img.alt = it.name;
        img.className = 'w-full h-full object-cover rounded-lg';
        imgWrap.appendChild(img);

        const info = document.createElement('div');
        info.className = 'min-w-0';
        const name = document.createElement('h4');
        name.className = 'text-xs font-bold text-stone-900 dark:text-white line-clamp-1 truncate';
        name.textContent = it.name;
        const qty = document.createElement('span');
        qty.className = 'text-[11px] text-stone-500 dark:text-[#b0a297]';
        qty.textContent = `Cant: ${it.quantity} × ${formatCLP(it.price)}`;

        info.appendChild(name);
        info.appendChild(qty);
        left.appendChild(imgWrap);
        left.appendChild(info);

        const right = document.createElement('span');
        right.className = 'text-xs font-black text-stone-900 dark:text-white shrink-0';
        right.textContent = formatCLP(it.price * it.quantity);

        li.appendChild(left);
        li.appendChild(right);
        itemsList.appendChild(li);
      });
    }
  }

  function setStep(step) {
    currentStep = step;

    ['step-1', 'step-2', 'step-3', 'step-4'].forEach((id, idx) => {
      const el = document.getElementById(id);
      if (idx + 1 === step) {
        el?.classList.remove('hidden');
      } else {
        el?.classList.add('hidden');
      }
    });

    for (let i = 1; i <= 4; i++) {
      const navItem = document.getElementById(`step-nav-${i}`);
      const circle = navItem?.querySelector('div');
      if (!navItem || !circle) continue;

      if (i < step) {
        navItem.className = 'step-nav-item flex flex-col items-center gap-1.5 transition-all text-emerald-600 dark:text-emerald-400 font-bold cursor-pointer';
        circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-black bg-emerald-500 text-white shadow-xs';
        circle.textContent = '✓';
      } else if (i === step) {
        navItem.className = 'step-nav-item flex flex-col items-center gap-1.5 transition-all text-rose-600 dark:text-rose-400 font-extrabold';
        circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-black bg-rose-600 text-white shadow-xs';
        circle.textContent = String(i);
      } else {
        navItem.className = 'step-nav-item flex flex-col items-center gap-1.5 transition-all text-stone-400 dark:text-stone-500 font-medium';
        circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-black bg-stone-100 dark:bg-[#27201c] text-stone-500 dark:text-stone-400';
        circle.textContent = String(i);
      }
    }

    renderCheckoutSummary();
    window.scrollTo({ top: 120, behavior: 'smooth' });
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderCheckoutSummary();

    // Detección de sesión activa
    let loggedUser = null;
    try {
      const storedUser = localStorage.getItem('market_pet_user');
      if (storedUser) {
        loggedUser = JSON.parse(storedUser);
      }
    } catch {
      loggedUser = null;
    }

    const step1LoggedView = document.getElementById('step1-logged-view');
    const step1GuestView = document.getElementById('step1-guest-view');

    if (loggedUser && loggedUser.nombre) {
      step1LoggedView?.classList.remove('hidden');
      step1GuestView?.classList.add('hidden');

      const nameDisplay = document.getElementById('step1-logged-user-name');
      const nameText = document.getElementById('step1-logged-name-text');
      const emailText = document.getElementById('step1-logged-email-text');
      const phoneInput = document.getElementById('step1-logged-phone');

      if (nameDisplay) nameDisplay.textContent = loggedUser.nombre;
      if (nameText) nameText.textContent = loggedUser.nombre;
      if (emailText) emailText.textContent = loggedUser.email || '';
      if (phoneInput && loggedUser.telefono) phoneInput.value = loggedUser.telefono;

      orderData.nombre = loggedUser.nombre;
      orderData.email = loggedUser.email || '';
      orderData.telefono = loggedUser.telefono || '';
    } else {
      step1LoggedView?.classList.add('hidden');
      step1GuestView?.classList.remove('hidden');
    }

    // Toggle de contraseña en login rápido
    const togglePassBtn = document.getElementById('toggle-step1-pass');
    const passInput = document.getElementById('step1-login-pass');
    const eyeOpen = document.getElementById('icon-step1-eye');
    const eyeOff = document.getElementById('icon-step1-eye-off');

    togglePassBtn?.addEventListener('click', () => {
      if (!passInput) return;
      const isPass = passInput.type === 'password';
      passInput.type = isPass ? 'text' : 'password';
      if (isPass) {
        eyeOpen?.classList.add('hidden');
        eyeOff?.classList.remove('hidden');
      } else {
        eyeOpen?.classList.remove('hidden');
        eyeOff?.classList.add('hidden');
      }
    });

    // 1A. Iniciar Sesión Rápido en Checkout
    const fastLoginForm = document.getElementById('form-step1-fast-login');
    fastLoginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      let hasError = false;

      const email = document.getElementById('step1-login-email')?.value.trim();
      const pass = document.getElementById('step1-login-pass')?.value;

      if (!email || !EMAIL_REGEX.test(email)) {
        setCheckoutError('step1-login-email', 'err-step1-login-email', 'Ingresa un correo electrónico válido');
        hasError = true;
      } else {
        setCheckoutError('step1-login-email', 'err-step1-login-email', '');
      }

      if (!pass || pass.length < 6) {
        setCheckoutError('step1-login-pass', 'err-step1-login-pass', 'Ingresa tu contraseña (mínimo 6 caracteres)');
        hasError = true;
      } else {
        setCheckoutError('step1-login-pass', 'err-step1-login-pass', '');
      }

      if (hasError) return;

      const name = email.split('@')[0] || 'Cliente';
      const capitalized = name.charAt(0).toUpperCase() + name.slice(1);

      const userObj = {
        nombre: capitalized,
        email: email,
        logueado: true,
        fecha: new Date().toISOString(),
      };

      localStorage.setItem('market_pet_user', JSON.stringify(userObj));
      orderData.nombre = capitalized;
      orderData.email = email;

      setStep(2);
    });

    // 1B. Continuar desde usuario logueado
    const loggedForm = document.getElementById('form-step-1-logged');
    loggedForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      let hasError = false;

      const rut = document.getElementById('step1-logged-rut')?.value.trim();
      const phone = document.getElementById('step1-logged-phone')?.value.trim();

      if (!rut || rut.length < 7) {
        setCheckoutError('step1-logged-rut', 'err-step1-logged-rut', 'Ingresa un RUT o DNI válido');
        hasError = true;
      } else {
        setCheckoutError('step1-logged-rut', 'err-step1-logged-rut', '');
      }

      const cleanPhone = (phone || '').replace(/[^0-9]/g, '');
      if (!phone || cleanPhone.length < 8) {
        setCheckoutError('step1-logged-phone', 'err-step1-logged-phone', 'Ingresa un teléfono válido');
        hasError = true;
      } else {
        setCheckoutError('step1-logged-phone', 'err-step1-logged-phone', '');
      }

      if (hasError) return;

      orderData.rut = rut;
      orderData.telefono = phone;
      setStep(2);
    });

    // 1C. Cargar Sesión Demo con Datos Ficticios (1 Clic)
    const demoBtn = document.getElementById('btn-load-demo-session');
    demoBtn?.addEventListener('click', () => {
      const demoUser = {
        nombre: 'Constanza Silva Morales',
        email: 'constanza.demo@marketpet.cl',
        rut: '18.765.432-1',
        telefono: '+56 9 8765 4321',
        region: 'metropolitana',
        comuna: 'Providencia',
        direccion: 'Av. Providencia 1234',
        depto: 'Depto 502',
        notas: 'Dejar en conserjería con don Carlos',
        logueado: true,
      };

      localStorage.setItem('market_pet_user', JSON.stringify(demoUser));

      if (getCart().length === 0) {
        const demoItems = [
          {
            id: 'alimento-premium-adulto-salmon-3kg',
            name: 'Alimento Premium Perro Adulto Salmón 3kg',
            price: 24990,
            quantity: 1,
            image: '/favicon.svg',
          },
          {
            id: 'arnes-ergonomico-reflectante',
            name: 'Arnés Ergonómico Reflectante',
            price: 14990,
            quantity: 1,
            image: '/favicon.svg',
          },
        ];
        localStorage.setItem(CART_KEY, JSON.stringify(demoItems));
        window.dispatchEvent(new CustomEvent('cart-updated', { detail: { cart: demoItems } }));
      }

      orderData = { ...orderData, ...demoUser };

      const rutInput = document.getElementById('step1-logged-rut');
      const phoneInput = document.getElementById('step1-logged-phone');
      if (rutInput) rutInput.value = demoUser.rut;
      if (phoneInput) phoneInput.value = demoUser.telefono;

      const addrInput = document.getElementById('step2-address');
      const deptInput = document.getElementById('step2-dept');
      const notesInput = document.getElementById('step2-notes');
      const comunaSelect = document.getElementById('step2-comuna');
      if (addrInput) addrInput.value = demoUser.direccion;
      if (deptInput) deptInput.value = demoUser.depto;
      if (notesInput) notesInput.value = demoUser.notas;
      if (comunaSelect) comunaSelect.value = demoUser.comuna;

      const nameDisplay = document.getElementById('step1-logged-user-name');
      const nameText = document.getElementById('step1-logged-name-text');
      const emailText = document.getElementById('step1-logged-email-text');
      step1LoggedView?.classList.remove('hidden');
      step1GuestView?.classList.add('hidden');
      if (nameDisplay) nameDisplay.textContent = demoUser.nombre;
      if (nameText) nameText.textContent = demoUser.nombre;
      if (emailText) emailText.textContent = demoUser.email;

      setStep(2);
    });

    // 1D. Formulario de Cupón de Descuento (En Pantalla Actual de Checkout y Pago)
    const couponForm = document.getElementById('checkout-coupon-form');
    const couponInput = document.getElementById('checkout-coupon-input');
    const couponFeedback = document.getElementById('checkout-coupon-feedback');

    couponForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = (couponInput?.value || '').trim().toUpperCase();
      if (!code) {
        if (couponFeedback) {
          couponFeedback.textContent = 'Ingresa un código de cupón';
          couponFeedback.className = 'text-[11px] font-bold text-rose-600 dark:text-rose-400 mt-1 block';
          couponFeedback.classList.remove('hidden');
        }
        return;
      }

      if (code === 'MASCOTA10' || code === 'MARKET10') {
        appliedCoupon = { code, percent: 10 };
        if (couponFeedback) {
          couponFeedback.textContent = `✓ ¡Cupón ${code} aplicado (-10%)!`;
          couponFeedback.className = 'text-[11px] font-bold text-emerald-600 dark:text-emerald-400 mt-1 block';
          couponFeedback.classList.remove('hidden');
        }
      } else if (code === 'SUPERPET15') {
        appliedCoupon = { code, percent: 15 };
        if (couponFeedback) {
          couponFeedback.textContent = `✓ ¡Cupón ${code} aplicado (-15%)!`;
          couponFeedback.className = 'text-[11px] font-bold text-emerald-600 dark:text-emerald-400 mt-1 block';
          couponFeedback.classList.remove('hidden');
        }
      } else {
        appliedCoupon = null;
        if (couponFeedback) {
          couponFeedback.textContent = '✕ Código de descuento no válido o expirado';
          couponFeedback.className = 'text-[11px] font-bold text-rose-600 dark:text-rose-400 mt-1 block';
          couponFeedback.classList.remove('hidden');
        }
      }
      renderCheckoutSummary();
    });

    // Paso 2: Dirección y Comuna
    const form2 = document.getElementById('form-step-2');
    form2?.addEventListener('submit', (e) => {
      e.preventDefault();
      let hasError = false;

      const address = document.getElementById('step2-address')?.value.trim();
      if (!address || address.length < 5) {
        setCheckoutError('step2-address', 'err-step2-address', 'Ingresa la calle y numeración de entrega');
        hasError = true;
      } else {
        setCheckoutError('step2-address', 'err-step2-address', '');
      }

      if (hasError) return;

      orderData.region = document.getElementById('step2-region')?.value;
      orderData.comuna = document.getElementById('step2-comuna')?.value;
      orderData.direccion = address;
      orderData.depto = document.getElementById('step2-dept')?.value.trim();
      orderData.notas = document.getElementById('step2-notes')?.value.trim();

      setStep(3);
    });

    document.getElementById('btn-back-to-step-1')?.addEventListener('click', () => setStep(1));

    // Paso 3: Método de Entrega
    const form3 = document.getElementById('form-step-3');
    form3?.addEventListener('submit', (e) => {
      e.preventDefault();
      const selected = document.querySelector('input[name="shipping-method"]:checked');
      if (selected) {
        selectedShippingMethod = selected.value;
      }
      setStep(4);
    });

    document.getElementById('btn-back-to-step-2')?.addEventListener('click', () => setStep(2));

    document.querySelectorAll('input[name="shipping-method"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        selectedShippingMethod = e.target.value;
        document.querySelectorAll('.shipping-option').forEach((lbl) => {
          lbl.className = 'shipping-option flex items-center justify-between p-4 rounded-2xl border border-stone-200 dark:border-[#382d27] bg-white dark:bg-[#141110] cursor-pointer transition-all';
        });
        const parent = e.target.closest('label');
        if (parent) {
          parent.className = 'shipping-option flex items-center justify-between p-4 rounded-2xl border-2 border-rose-600 bg-rose-50/20 dark:bg-rose-950/20 cursor-pointer transition-all';
        }
        renderCheckoutSummary();
      });
    });

    // Paso 4: Medio de Pago
    document.querySelectorAll('input[name="payment-method"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        selectedPaymentMethod = e.target.value;
        document.querySelectorAll('.payment-option').forEach((lbl) => {
          lbl.className = 'payment-option flex items-center justify-between p-4 rounded-2xl border border-stone-200 dark:border-[#382d27] bg-white dark:bg-[#141110] cursor-pointer transition-all';
        });
        const parent = e.target.closest('label');
        if (parent) {
          parent.className = 'payment-option flex items-center justify-between p-4 rounded-2xl border-2 border-rose-600 bg-rose-50/20 dark:bg-rose-950/20 cursor-pointer transition-all';
        }
        renderCheckoutSummary();
      });
    });

    document.getElementById('btn-back-to-step-3')?.addEventListener('click', () => setStep(3));

    // Stepper navegable
    document.getElementById('step-nav-1')?.addEventListener('click', () => {
      if (currentStep > 1) setStep(1);
    });
    document.getElementById('step-nav-2')?.addEventListener('click', () => {
      if (currentStep > 2) setStep(2);
    });
    document.getElementById('step-nav-3')?.addEventListener('click', () => {
      if (currentStep > 3) setStep(3);
    });

    // Confirmación y Pago
    const form4 = document.getElementById('form-step-4');
    form4?.addEventListener('submit', (e) => {
      e.preventDefault();
      const cart = getCart();
      if (cart.length === 0) {
        alert('Tu carrito está vacío. Agrega productos antes de confirmar el pago.');
        window.location.href = '/catalogo';
        return;
      }

      const confirmBtn = document.getElementById('btn-confirm-payment');
      if (confirmBtn) {
        confirmBtn.innerHTML = '<span>Procesando pago seguro...</span>';
        confirmBtn.setAttribute('disabled', 'true');
      }

      setTimeout(() => {
        const orderId = `#MP-2026-${Math.floor(1000 + Math.random() * 9000)}`;
        const totalText = document.getElementById('checkout-total-val')?.textContent || '$0';

        document.getElementById('checkout-steps-container')?.classList.add('hidden');
        const successView = document.getElementById('checkout-success-view');
        successView?.classList.remove('hidden');

        const successOrderId = document.getElementById('success-order-id');
        const successName = document.getElementById('success-name');
        const successComuna = document.getElementById('success-comuna');
        const successShipping = document.getElementById('success-shipping');
        const successTotal = document.getElementById('success-total');

        if (successOrderId) successOrderId.textContent = orderId;
        if (successName) successName.textContent = orderData.nombre || 'Cliente';
        if (successComuna) successComuna.textContent = orderData.comuna || 'Providencia';
        if (successShipping) {
          successShipping.textContent = selectedShippingMethod === 'express' ? 'Despacho Express Mismo Día' : selectedShippingMethod === 'pickup' ? 'Retiro en Tienda' : 'Despacho Estándar';
        }
        if (successTotal) successTotal.textContent = totalText;

        try {
          localStorage.removeItem(CART_KEY);
          window.dispatchEvent(new Event('storage'));
          window.dispatchEvent(new CustomEvent('cart-updated', { detail: { cart: [] } }));
        } catch {
          // Ignorar
        }

        renderCheckoutSummary();
        window.scrollTo({ top: 80, behavior: 'smooth' });
      }, 1100);
    });
  });
</script>
