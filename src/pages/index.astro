---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import CircularCategories from '../components/CircularCategories.astro';

// Modelo de datos inicial para productos destacados (establece la estructura que usará Content Collections en Fase 2)
const productosDestacados = [
  {
    id: 'prod-01',
    name: 'Alimento Premium Salmón & Arroz Integral 3kg',
    category: 'Perros',
    price: 24990,
    originalPrice: 28990,
    rating: 4.9,
    reviewsCount: 38,
    badge: 'Más Vendido',
    badgeColor: 'bg-amber-100 text-amber-900',
    stock: 14,
    description:
      'Fórmula hipoalergénica con Omega 3 y 6 para pelaje brillante y digestión óptima.',
    icon: '🐶',
  },
  {
    id: 'prod-02',
    name: 'Torre Rascador Multinivel con Hamaca y Juguete',
    category: 'Gatos',
    price: 34990,
    originalPrice: 39990,
    rating: 4.8,
    reviewsCount: 24,
    badge: 'Oferta Especial',
    badgeColor: 'bg-rose-100 text-rose-900',
    stock: 6,
    description:
      'Postes forrados en sisal natural resistente, base acolchada y estructura ultra estable.',
    icon: '🐱',
  },
  {
    id: 'prod-03',
    name: 'Cama Ortopédica Viscoelástica Memory Foam',
    category: 'Descanso',
    price: 29990,
    originalPrice: null,
    rating: 5.0,
    reviewsCount: 19,
    badge: 'Recomendado Vet',
    badgeColor: 'bg-emerald-100 text-emerald-900',
    stock: 9,
    description:
      'Alivia la presión articular de tu mascota. Funda lavable y base impermeable antideslizante.',
    icon: '🛏️',
  },
  {
    id: 'prod-04',
    name: 'Fuente de Agua Silenciosa con Filtro Activo 2L',
    category: 'Accesorios',
    price: 19990,
    originalPrice: 22990,
    rating: 4.7,
    reviewsCount: 52,
    badge: 'Top Hidratación',
    badgeColor: 'bg-sky-100 text-sky-900',
    stock: 12,
    description:
      'Agua corriente siempre limpia y oxigenada para estimular la ingesta hídrica diaria.',
    icon: '💧',
  },
  {
    id: 'prod-05',
    name: 'Pack Snacks Dentales Naturales Sin Granos',
    category: 'Snacks',
    price: 8990,
    originalPrice: null,
    rating: 4.9,
    reviewsCount: 45,
    badge: '100% Natural',
    badgeColor: 'bg-emerald-100 text-emerald-900',
    stock: 25,
    description:
      'Reduce sarro y placa bacteriana con menta orgánica y espirulina. Apto perros y cachorros.',
    icon: '🦴',
  },
  {
    id: 'prod-06',
    name: 'Arnés Ergonómico Antitirones Reflectante',
    category: 'Paseo',
    price: 16990,
    originalPrice: 19990,
    rating: 4.8,
    reviewsCount: 31,
    badge: 'Seguridad',
    badgeColor: 'bg-amber-100 text-amber-900',
    stock: 4,
    description:
      'Distribuye la presión de forma uniforme en el pecho para paseos seguros y sin ahogos.',
    icon: '🐕',
  },
];

function formatPrice(amount) {
  return `$${amount.toLocaleString('es-CL')}`;
}
---

<BaseLayout>
  <!-- 1. Hero Carousel estilo Bootstrap 5.3 adaptado a retail moderno de mascotas (Made in Germany, Catit, Packs) -->
  <Carousel />

  <!-- 2. Categorías Circulares estilo Headings de Bootstrap Carousel y tienda chilena de mascotas -->
  <CircularCategories />

  <!-- CATÁLOGO DESTACADO -->
  <section
    id="destacados"
    class="py-14 bg-stone-50/70 border-y border-stone-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4"
      >
        <div>
          <span
            class="text-xs uppercase tracking-widest font-extrabold text-brand-primary"
          >
            Los preferidos en Chile
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-stone-900 mt-1">
            Productos Destacados
          </h2>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-medium text-stone-500">
            Precios en Pesos Chilenos ($ CLP) con IVA incluido
          </span>
        </div>
      </div>

      <!-- Grid de productos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          productosDestacados.map((item) => (
            <article class="flex flex-col rounded-2xl bg-white border border-stone-200 shadow-xs hover:shadow-xl hover:border-brand-primary transition-all duration-300 group">
              <div class="p-4 pb-0 flex items-center justify-between">
                <span
                  class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${item.badgeColor}`}
                >
                  {item.badge}
                </span>
                <span class="text-xs text-stone-500 font-medium">
                  {item.stock > 0
                    ? item.stock < 8
                      ? `¡Solo ${item.stock} en stock!`
                      : 'En Stock'
                    : 'Agotado'}
                </span>
              </div>

              <div class="h-44 flex items-center justify-center p-6 group-hover:scale-105 transition-transform duration-300">
                <div class="w-24 h-24 rounded-2xl bg-brand-light shadow-xs flex items-center justify-center text-5xl">
                  {item.icon}
                </div>
              </div>

              <div class="p-5 pt-0 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <div class="flex items-center gap-1.5 text-xs text-amber-500">
                    <span>★</span>
                    <span class="font-bold text-stone-800">{item.rating}</span>
                    <span class="text-stone-400">
                      ({item.reviewsCount} opiniones)
                    </span>
                  </div>

                  <p class="text-[11px] uppercase tracking-wider font-bold text-stone-400">
                    {item.category}
                  </p>

                  <h3 class="font-bold text-stone-900 text-base leading-snug group-hover:text-brand-primary transition-colors">
                    {item.name}
                  </h3>

                  <p class="text-xs text-stone-600 line-clamp-2 leading-relaxed">
                    {item.description}
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-stone-100 flex items-center justify-between gap-3">
                  <div class="flex flex-col">
                    <span class="text-xl font-extrabold text-stone-900">
                      {formatPrice(item.price)}
                    </span>
                    {item.originalPrice && (
                      <span class="text-xs text-stone-400 line-through">
                        {formatPrice(item.originalPrice)}
                      </span>
                    )}
                  </div>

                  <button
                    type="button"
                    data-product-id={item.id}
                    data-product-name={item.name}
                    data-product-price={item.price}
                    class="add-to-cart-btn px-4 py-2.5 rounded-xl bg-brand-primary text-white text-xs font-bold shadow-xs transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 cursor-pointer hover:opacity-95"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4v16m8-8H4"
                      />
                    </svg>
                    <span>Agregar</span>
                  </button>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GARANTÍAS / BENEFICIOS -->
  <section
    id="beneficios"
    class="py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-brand-light text-brand-primary flex items-center justify-center font-bold text-xl"
        >
          🚚
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Despachos Express en Chile
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          Envíos a domicilio en 24 a 48 horas en Santiago y regiones principales
          con número de seguimiento en línea.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl"
        >
          🛡️
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Garantía de Satisfacción
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          ¿No era la talla o sabor adecuado? Tienes 30 días para cambios y
          devoluciones sencillas sin preguntas incómodas.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold text-xl"
        >
          🩺
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Asesoría Nutricional & Vet
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          Nuestro equipo te orienta para elegir el alimento y dosis adecuada
          según la edad, peso y necesidades de tu mascota.
        </p>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER / CLUB -->
  <section class="py-14 bg-stone-900 text-white border-t border-stone-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span
        class="inline-block px-3 py-1 rounded-full bg-brand-primary/20 text-white text-xs font-semibold"
      >
        Club Patitas & Co.
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        15% de descuento en tu primera compra
      </h2>
      <p
        class="text-stone-400 text-xs sm:text-sm max-w-lg mx-auto leading-relaxed"
      >
        Únete gratis y recibe promociones exclusivas, consejos de nutrición y
        recordatorios de desparasitación para tus mascotas.
      </p>

      <form
        id="newsletter-form"
        class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto pt-2"
        onsubmit="event.preventDefault();"
      >
        <label for="newsletter-email" class="sr-only">Correo electrónico</label>
        <input
          type="email"
          id="newsletter-email"
          required
          placeholder="tu@correo.cl"
          class="flex-1 px-4 py-2.5 rounded-xl bg-stone-800 border border-stone-700 text-white placeholder-stone-400 text-xs focus:outline-none focus:ring-2 focus:ring-stone-500"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-xl bg-brand-primary text-white font-bold text-xs transition-colors cursor-pointer hover:opacity-95"
        >
          Suscribirme
        </button>
      </form>
    </div>
  </section>

  <!-- Script cliente para añadir al carrito -->
  <script>
    const buttons = document.querySelectorAll('.add-to-cart-btn');
    const badge = document.getElementById('cart-count-badge');
    let totalItems = 0;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        totalItems += 1;
        if (badge) {
          badge.textContent = String(totalItems);
          badge.classList.add('scale-125');
          setTimeout(() => badge.classList.remove('scale-125'), 200);
        }
      });
    });
  </script>
</BaseLayout>
