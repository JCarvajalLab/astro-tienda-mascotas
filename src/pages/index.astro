---
import BaseLayout from '../layouts/BaseLayout.astro';

// Modelo de datos inicial para productos destacados (establece la estructura que usará Content Collections en Fase 2)
const productosDestacados = [
  {
    id: 'prod-01',
    name: 'Alimento Premium Salmón & Arroz Integral 3kg',
    category: 'Perros',
    price: 24990,
    originalPrice: 28990,
    rating: 4.9,
    reviewsCount: 38,
    badge: 'Más Vendido',
    badgeColor: 'bg-amber-100 text-amber-900',
    stock: 14,
    description:
      'Fórmula hipoalergénica con Omega 3 y 6 para pelaje brillante y digestión óptima.',
    icon: '🐶',
  },
  {
    id: 'prod-02',
    name: 'Torre Rascador Multinivel con Hamaca y Juguete',
    category: 'Gatos',
    price: 34990,
    originalPrice: 39990,
    rating: 4.8,
    reviewsCount: 24,
    badge: 'Oferta Especial',
    badgeColor: 'bg-rose-100 text-rose-900',
    stock: 6,
    description:
      'Postes forrados en sisal natural resistente, base acolchada y estructura ultra estable.',
    icon: '🐱',
  },
  {
    id: 'prod-03',
    name: 'Cama Ortopédica Viscoelástica Memory Foam',
    category: 'Descanso',
    price: 29990,
    originalPrice: null,
    rating: 5.0,
    reviewsCount: 19,
    badge: 'Recomendado Vet',
    badgeColor: 'bg-emerald-100 text-emerald-900',
    stock: 9,
    description:
      'Alivia la presión articular de tu mascota. Funda lavable y base impermeable antideslizante.',
    icon: '🛏️',
  },
  {
    id: 'prod-04',
    name: 'Fuente de Agua Silenciosa con Filtro Activo 2L',
    category: 'Accesorios',
    price: 19990,
    originalPrice: 22990,
    rating: 4.7,
    reviewsCount: 52,
    badge: 'Top Hidratación',
    badgeColor: 'bg-sky-100 text-sky-900',
    stock: 12,
    description:
      'Agua corriente siempre limpia y oxigenada para estimular la ingesta hídrica diaria.',
    icon: '💧',
  },
  {
    id: 'prod-05',
    name: 'Pack Snacks Dentales Naturales Sin Granos',
    category: 'Snacks',
    price: 8990,
    originalPrice: null,
    rating: 4.9,
    reviewsCount: 45,
    badge: '100% Natural',
    badgeColor: 'bg-emerald-100 text-emerald-900',
    stock: 25,
    description:
      'Reduce sarro y placa bacteriana con menta orgánica y espirulina. Apto perros y cachorros.',
    icon: '🦴',
  },
  {
    id: 'prod-06',
    name: 'Arnés Ergonómico Antitirones Reflectante',
    category: 'Paseo',
    price: 16990,
    originalPrice: 19990,
    rating: 4.8,
    reviewsCount: 31,
    badge: 'Seguridad',
    badgeColor: 'bg-amber-100 text-amber-900',
    stock: 4,
    description:
      'Distribuye la presión de forma uniforme en el pecho para paseos seguros y sin ahogos.',
    icon: '🐕',
  },
];

const categorias = [
  {
    title: 'Perros',
    subtitle: 'Nutrición, paseos y confort',
    icon: '🐶',
    count: '120+ productos',
    href: '#perros',
    border: 'hover:border-amber-400',
  },
  {
    title: 'Gatos',
    subtitle: 'Rascadores, arenas y delicias',
    icon: '🐱',
    count: '95+ productos',
    href: '#gatos',
    border: 'hover:border-rose-400',
  },
  {
    title: 'Accesorios & Confort',
    subtitle: 'Camas, juguetes y comederos',
    icon: '🎾',
    count: '70+ productos',
    href: '#accesorios',
    border: 'hover:border-amber-400',
  },
  {
    title: 'Salud & Higiene',
    subtitle: 'Antipulgas, aseo y vitaminas',
    icon: '🩺',
    count: '60+ productos',
    href: '#salud',
    border: 'hover:border-emerald-400',
  },
];

function formatPrice(amount) {
  return `$${amount.toLocaleString('es-CL')}`;
}
---

<BaseLayout>
  <!-- HERO SECTION EN MODO CLARO RADIANTE Y CÁLIDO -->
  <section
    class="relative overflow-hidden bg-brand-light/60 py-12 sm:py-20 border-b border-stone-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
      >
        <!-- Texto del Hero -->
        <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-stone-200/90 text-stone-800 text-xs sm:text-sm font-bold shadow-xs"
          >
            <span
              class="flex h-2.5 w-2.5 rounded-full bg-brand-primary animate-pulse"
            ></span>
            <span>🇨🇱 Despacho a todo Chile • Envíos gratis sobre $29.990</span>
          </div>

          <h1
            class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-stone-900 leading-[1.12]"
          >
            Todo para tu mascota, con la <span
              class="text-brand-primary underline decoration-stone-300 decoration-wavy decoration-2"
              >calidad y rapidez</span
            > que merecen.
          </h1>

          <p
            class="text-sm sm:text-base lg:text-lg text-stone-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal"
          >
            Encuentra alimentos premium, arenas sanitarias, rascadores y
            farmacia veterinaria con envíos directo a tu comuna en 24 a 48
            horas.
          </p>

          <!-- Acciones principales -->
          <div
            class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-2"
          >
            <a
              href="#destacados"
              class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-brand-primary text-white font-bold text-sm sm:text-base shadow-lg shadow-black/10 transition-all cursor-pointer hover:opacity-95"
            >
              Explorar Catálogo
            </a>
            <button
              type="button"
              onclick="if(window.openRegionModal) window.openRegionModal();"
              class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white text-stone-800 border border-stone-200 hover:bg-stone-50 font-semibold text-sm sm:text-base transition-colors cursor-pointer"
            >
              📍 Configurar mi Comuna
            </button>
          </div>

          <!-- Badges de confianza -->
          <div
            class="grid grid-cols-3 gap-3 pt-6 border-t border-stone-200 max-w-lg mx-auto lg:mx-0 text-left"
          >
            <div>
              <p class="font-extrabold text-base sm:text-lg text-stone-900">
                100% Original
              </p>
              <p class="text-xs text-stone-500">Marcas garantizadas</p>
            </div>
            <div>
              <p class="font-extrabold text-base sm:text-lg text-stone-900">
                24/48 Horas
              </p>
              <p class="text-xs text-stone-500">Despacho en Chile</p>
            </div>
            <div>
              <p class="font-extrabold text-base sm:text-lg text-stone-900">
                +5.000
              </p>
              <p class="text-xs text-stone-500">Clientes felices</p>
            </div>
          </div>
        </div>

        <!-- Tarjeta Visual / Hero Card -->
        <div class="lg:col-span-5 flex justify-center">
          <div
            class="w-full max-w-md p-6 sm:p-7 rounded-3xl bg-white border border-stone-200 shadow-xl shadow-black/5 relative overflow-hidden"
          >
            <div class="flex items-center justify-between mb-4">
              <span
                class="text-xs uppercase tracking-wider font-extrabold text-brand-primary"
              >
                ⭐ Oferta de la Semana
              </span>
              <span
                class="px-2.5 py-1 rounded-full bg-rose-600 text-white text-xs font-bold"
              >
                -20% OFF
              </span>
            </div>
            <div class="py-6 flex justify-center items-center">
              <div
                class="w-28 h-28 rounded-3xl bg-brand-light flex items-center justify-center text-6xl shadow-inner"
              >
                🐾
              </div>
            </div>
            <div class="space-y-2">
              <h2
                class="text-lg sm:text-xl font-bold text-stone-900 leading-snug"
              >
                Combo Ahorro: Rascador + Cama Viscoelástica
              </h2>
              <p class="text-xs text-stone-600 leading-relaxed">
                Descanso superior y entretenimiento para gatos y perros
                pequeños. Incluye juguete de regalo.
              </p>
              <div
                class="flex items-baseline justify-between pt-3 border-t border-stone-100"
              >
                <div>
                  <span class="text-2xl font-black text-stone-900">$39.990</span
                  >
                  <span class="text-xs line-through text-stone-400 ml-2"
                    >$49.990</span
                  >
                </div>
                <button
                  type="button"
                  class="add-to-cart-btn px-4 py-2 rounded-xl bg-brand-primary text-white text-xs font-bold shadow-sm transition-colors cursor-pointer hover:opacity-95"
                  data-product-id="hero-pack"
                  data-product-name="Combo Ahorro Rascador + Cama"
                  data-product-price="39990"
                >
                  Agregar al Carrito
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORÍAS PRINCIPALES -->
  <section
    id="categorias"
    class="py-14 sm:py-18 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white"
  >
    <div
      class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4"
    >
      <div>
        <h2
          class="text-xs uppercase tracking-widest font-extrabold text-brand-primary mb-1"
        >
          Navegación por Mascota
        </h2>
        <p class="text-2xl sm:text-3xl font-black text-stone-900">
          Categorías Destacadas
        </p>
      </div>
      <p class="text-xs sm:text-sm text-stone-500 max-w-md">
        Selecciona la sección adecuada para ver alimentos formulados, accesorios
        a medida y productos veterinarios.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        categorias.map((cat) => (
          <a
            href={cat.href}
            class={`group p-5 rounded-2xl bg-white border border-stone-200 ${cat.border} shadow-xs hover:shadow-lg transition-all duration-200 hover:-translate-y-1 block`}
          >
            <div class="w-12 h-12 rounded-xl bg-brand-light flex items-center justify-center text-3xl mb-3 group-hover:scale-110 transition-transform">
              {cat.icon}
            </div>
            <h3 class="text-base font-bold text-stone-900 mb-0.5 group-hover:text-brand-primary transition-colors">
              {cat.title}
            </h3>
            <p class="text-xs text-stone-500 mb-3">{cat.subtitle}</p>
            <div class="flex items-center justify-between text-xs font-semibold text-stone-600">
              <span>{cat.count}</span>
              <span class="text-brand-primary group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CATÁLOGO DESTACADO -->
  <section
    id="destacados"
    class="py-14 bg-stone-50/70 border-y border-stone-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4"
      >
        <div>
          <span
            class="text-xs uppercase tracking-widest font-extrabold text-brand-primary"
          >
            Los preferidos en Chile
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-stone-900 mt-1">
            Productos Destacados
          </h2>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-medium text-stone-500">
            Precios en Pesos Chilenos ($ CLP) con IVA incluido
          </span>
        </div>
      </div>

      <!-- Grid de productos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          productosDestacados.map((item) => (
            <article class="flex flex-col rounded-2xl bg-white border border-stone-200 shadow-xs hover:shadow-xl hover:border-brand-primary transition-all duration-300 group">
              <div class="p-4 pb-0 flex items-center justify-between">
                <span
                  class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${item.badgeColor}`}
                >
                  {item.badge}
                </span>
                <span class="text-xs text-stone-500 font-medium">
                  {item.stock > 0
                    ? item.stock < 8
                      ? `¡Solo ${item.stock} en stock!`
                      : 'En Stock'
                    : 'Agotado'}
                </span>
              </div>

              <div class="h-44 flex items-center justify-center p-6 group-hover:scale-105 transition-transform duration-300">
                <div class="w-24 h-24 rounded-2xl bg-brand-light shadow-xs flex items-center justify-center text-5xl">
                  {item.icon}
                </div>
              </div>

              <div class="p-5 pt-0 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <div class="flex items-center gap-1.5 text-xs text-amber-500">
                    <span>★</span>
                    <span class="font-bold text-stone-800">{item.rating}</span>
                    <span class="text-stone-400">
                      ({item.reviewsCount} opiniones)
                    </span>
                  </div>

                  <p class="text-[11px] uppercase tracking-wider font-bold text-stone-400">
                    {item.category}
                  </p>

                  <h3 class="font-bold text-stone-900 text-base leading-snug group-hover:text-brand-primary transition-colors">
                    {item.name}
                  </h3>

                  <p class="text-xs text-stone-600 line-clamp-2 leading-relaxed">
                    {item.description}
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-stone-100 flex items-center justify-between gap-3">
                  <div class="flex flex-col">
                    <span class="text-xl font-extrabold text-stone-900">
                      {formatPrice(item.price)}
                    </span>
                    {item.originalPrice && (
                      <span class="text-xs text-stone-400 line-through">
                        {formatPrice(item.originalPrice)}
                      </span>
                    )}
                  </div>

                  <button
                    type="button"
                    data-product-id={item.id}
                    data-product-name={item.name}
                    data-product-price={item.price}
                    class="add-to-cart-btn px-4 py-2.5 rounded-xl bg-brand-primary text-white text-xs font-bold shadow-xs transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 cursor-pointer hover:opacity-95"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4v16m8-8H4"
                      />
                    </svg>
                    <span>Agregar</span>
                  </button>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GARANTÍAS / BENEFICIOS -->
  <section
    id="beneficios"
    class="py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-brand-light text-brand-primary flex items-center justify-center font-bold text-xl"
        >
          🚚
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Despachos Express en Chile
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          Envíos a domicilio en 24 a 48 horas en Santiago y regiones principales
          con número de seguimiento en línea.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl"
        >
          🛡️
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Garantía de Satisfacción
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          ¿No era la talla o sabor adecuado? Tienes 30 días para cambios y
          devoluciones sencillas sin preguntas incómodas.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold text-xl"
        >
          🩺
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Asesoría Nutricional & Vet
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          Nuestro equipo te orienta para elegir el alimento y dosis adecuada
          según la edad, peso y necesidades de tu mascota.
        </p>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER / CLUB -->
  <section class="py-14 bg-stone-900 text-white border-t border-stone-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span
        class="inline-block px-3 py-1 rounded-full bg-brand-primary/20 text-white text-xs font-semibold"
      >
        Club Patitas & Co.
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        15% de descuento en tu primera compra
      </h2>
      <p
        class="text-stone-400 text-xs sm:text-sm max-w-lg mx-auto leading-relaxed"
      >
        Únete gratis y recibe promociones exclusivas, consejos de nutrición y
        recordatorios de desparasitación para tus mascotas.
      </p>

      <form
        id="newsletter-form"
        class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto pt-2"
        onsubmit="event.preventDefault();"
      >
        <label for="newsletter-email" class="sr-only">Correo electrónico</label>
        <input
          type="email"
          id="newsletter-email"
          required
          placeholder="tu@correo.cl"
          class="flex-1 px-4 py-2.5 rounded-xl bg-stone-800 border border-stone-700 text-white placeholder-stone-400 text-xs focus:outline-none focus:ring-2 focus:ring-stone-500"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-xl bg-brand-primary text-white font-bold text-xs transition-colors cursor-pointer hover:opacity-95"
        >
          Suscribirme
        </button>
      </form>
    </div>
  </section>

  <!-- Script cliente para añadir al carrito -->
  <script>
    const buttons = document.querySelectorAll('.add-to-cart-btn');
    const badge = document.getElementById('cart-count-badge');
    let totalItems = 0;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        totalItems += 1;
        if (badge) {
          badge.textContent = String(totalItems);
          badge.classList.add('scale-125');
          setTimeout(() => badge.classList.remove('scale-125'), 200);
        }
      });
    });
  </script>
</BaseLayout>
