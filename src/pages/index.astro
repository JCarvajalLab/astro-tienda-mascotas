---
import BaseLayout from '../layouts/BaseLayout.astro';

// Modelo de datos inicial para productos destacados (establece la estructura que usará Content Collections en Fase 2)
const productosDestacados = [
  {
    id: 'prod-01',
    name: 'Alimento Premium Salmón & Arroz Integral 3kg',
    category: 'Perros',
    price: 24990,
    originalPrice: 28990,
    rating: 4.9,
    reviewsCount: 38,
    badge: 'Más Vendido',
    badgeColor:
      'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300',
    stock: 14,
    description:
      'Fórmula hipoalergénica con Omega 3 y 6 para pelaje brillante y digestión óptima.',
    icon: '🐶',
  },
  {
    id: 'prod-02',
    name: 'Torre Rascador Multinivel con Hamaca y Juguete',
    category: 'Gatos',
    price: 34990,
    originalPrice: 39990,
    rating: 4.8,
    reviewsCount: 24,
    badge: 'Oferta Especial',
    badgeColor:
      'bg-orange-100 text-orange-800 dark:bg-orange-950 dark:text-orange-300',
    stock: 6,
    description:
      'Postes forrados en sisal natural resistente, base acolchada y estructura ultra estable.',
    icon: '🐱',
  },
  {
    id: 'prod-03',
    name: 'Cama Ortopédica Viscoelástica Memory Foam',
    category: 'Descanso',
    price: 29990,
    originalPrice: null,
    rating: 5.0,
    reviewsCount: 19,
    badge: 'Recomendado Vet',
    badgeColor:
      'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
    stock: 9,
    description:
      'Alivia la presión articular de tu mascota. Funda lavable y base impermeable antideslizante.',
    icon: '🛏️',
  },
  {
    id: 'prod-04',
    name: 'Fuente de Agua Silenciosa con Filtro Activo 2L',
    category: 'Accesorios',
    price: 19990,
    originalPrice: 22990,
    rating: 4.7,
    reviewsCount: 52,
    badge: 'Top Hidratación',
    badgeColor: 'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300',
    stock: 12,
    description:
      'Agua corriente siempre limpia y oxigenada para estimular la ingesta hídrica diaria.',
    icon: '💧',
  },
  {
    id: 'prod-05',
    name: 'Pack Snacks Dentales Naturales Sin Granos',
    category: 'Snacks',
    price: 8990,
    originalPrice: null,
    rating: 4.9,
    reviewsCount: 45,
    badge: '100% Natural',
    badgeColor:
      'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
    stock: 25,
    description:
      'Reduce sarro y placa bacteriana con menta orgánica y espirulina. Apto perros y cachorros.',
    icon: '🦴',
  },
  {
    id: 'prod-06',
    name: 'Arnés Ergonómico Antitirones Reflectante',
    category: 'Paseo',
    price: 16990,
    originalPrice: 19990,
    rating: 4.8,
    reviewsCount: 31,
    badge: 'Seguridad',
    badgeColor:
      'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300',
    stock: 4,
    description:
      'Distribuye la presión de forma uniforme en el pecho para paseos seguros y sin ahogos.',
    icon: '🐕',
  },
];

const categorias = [
  {
    title: 'Perros',
    subtitle: 'Nutrición, paseos y diversión',
    icon: '🐶',
    count: '120+ productos',
    href: '#perros',
    gradient:
      'from-amber-500/10 to-orange-500/10 border-amber-200 dark:border-amber-900/50',
  },
  {
    title: 'Gatos',
    subtitle: 'Rascadores, arenas y juguetes',
    icon: '🐱',
    count: '95+ productos',
    href: '#gatos',
    gradient:
      'from-orange-500/10 to-rose-500/10 border-orange-200 dark:border-orange-900/50',
  },
  {
    title: 'Aves & Pequeños',
    subtitle: 'Jaulas, alimento y heno fresco',
    icon: '🐰',
    count: '40+ productos',
    href: '#pequenos',
    gradient:
      'from-emerald-500/10 to-teal-500/10 border-emerald-200 dark:border-emerald-900/50',
  },
  {
    title: 'Salud & Cuidado',
    subtitle: 'Higiene, antipulgas y vitaminas',
    icon: '🩺',
    count: '60+ productos',
    href: '#salud',
    gradient:
      'from-sky-500/10 to-blue-500/10 border-sky-200 dark:border-sky-900/50',
  },
];

function formatPrice(amount) {
  return `$${amount.toLocaleString('es-CL')}`;
}
---

<BaseLayout>
  <!-- HERO SECTION -->
  <section
    class="relative overflow-hidden bg-gradient-to-b from-amber-50/60 via-white to-stone-50 dark:from-stone-900 dark:via-stone-900/80 dark:to-stone-950 py-16 sm:py-24 border-b border-stone-200/60 dark:border-stone-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Texto del Hero -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 dark:bg-amber-950/70 border border-amber-200 dark:border-amber-800/60 text-amber-900 dark:text-amber-200 text-xs sm:text-sm font-semibold shadow-xs"
          >
            <span class="flex h-2 w-2 rounded-full bg-amber-500 animate-pulse"
            ></span>
            <span>Envíos gratis en compras sobre $29.990</span>
          </div>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-stone-900 dark:text-white leading-[1.12]"
          >
            Todo lo que tu mascota necesita para vivir <span
              class="bg-gradient-to-r from-amber-600 to-orange-500 bg-clip-text text-transparent"
              >feliz y sana</span
            >.
          </h1>

          <p
            class="text-base sm:text-lg text-stone-600 dark:text-stone-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal"
          >
            Alimentos seleccionados, accesorios ergonómicos y juguetes
            interactivos diseñados para el bienestar integral de perros, gatos y
            pequeñas mascotas.
          </p>

          <!-- Acciones principales -->
          <div
            class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-2"
          >
            <a
              href="#destacados"
              class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white font-semibold text-base shadow-lg shadow-amber-600/25 hover:shadow-amber-600/35 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 cursor-pointer"
            >
              Ver Catálogo Completo
            </a>
            <a
              href="#ofertas"
              class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white dark:bg-stone-800 text-stone-800 dark:text-stone-100 border border-stone-300 dark:border-stone-700 hover:bg-stone-100 dark:hover:bg-stone-700 font-semibold text-base transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 cursor-pointer"
            >
              Ofertas de la Semana
            </a>
          </div>

          <!-- Badges de confianza -->
          <div
            class="grid grid-cols-3 gap-4 pt-6 border-t border-stone-200/80 dark:border-stone-800/80 max-w-lg mx-auto lg:mx-0 text-left"
          >
            <div>
              <p
                class="font-extrabold text-lg sm:text-xl text-stone-900 dark:text-white"
              >
                100%
              </p>
              <p class="text-xs text-stone-500 dark:text-stone-400">
                Nutrición garantizada
              </p>
            </div>
            <div>
              <p
                class="font-extrabold text-lg sm:text-xl text-stone-900 dark:text-white"
              >
                24/48h
              </p>
              <p class="text-xs text-stone-500 dark:text-stone-400">
                Entrega rápida
              </p>
            </div>
            <div>
              <p
                class="font-extrabold text-lg sm:text-xl text-stone-900 dark:text-white"
              >
                +5.000
              </p>
              <p class="text-xs text-stone-500 dark:text-stone-400">
                Huellitas felices
              </p>
            </div>
          </div>
        </div>

        <!-- Tarjeta Visual / Hero Card -->
        <div class="lg:col-span-5 flex justify-center">
          <div
            class="w-full max-w-md p-6 sm:p-8 rounded-3xl bg-gradient-to-tr from-amber-500/10 via-orange-500/10 to-stone-100 dark:to-stone-800/60 border border-amber-200/70 dark:border-amber-900/40 shadow-xl relative overflow-hidden backdrop-blur-sm"
          >
            <div class="flex items-center justify-between mb-4">
              <span
                class="text-xs uppercase tracking-wider font-bold text-amber-700 dark:text-amber-400"
                >Producto del Mes</span
              >
              <span
                class="px-2.5 py-1 rounded-full bg-emerald-500 text-white text-xs font-semibold"
                >15% OFF</span
              >
            </div>
            <div class="py-8 flex justify-center items-center">
              <div
                class="w-32 h-32 rounded-3xl bg-amber-500/20 dark:bg-amber-500/10 flex items-center justify-center text-6xl shadow-inner animate-bounce"
              >
                🐾
              </div>
            </div>
            <div class="space-y-2">
              <h2 class="text-xl font-bold text-stone-900 dark:text-white">
                Pack Bienestar & Confort Total
              </h2>
              <p class="text-xs text-stone-600 dark:text-stone-300">
                Incluye cama ortopédica viscoelástica + dispensador interactivo
                y snack dental.
              </p>
              <div
                class="flex items-baseline justify-between pt-3 border-t border-stone-200 dark:border-stone-700"
              >
                <div>
                  <span
                    class="text-2xl font-extrabold text-stone-900 dark:text-white"
                    >$39.990</span
                  >
                  <span class="text-xs line-through text-stone-400 ml-2"
                    >$46.990</span
                  >
                </div>
                <button
                  type="button"
                  class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold transition-colors cursor-pointer"
                >
                  Lo quiero
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORÍAS -->
  <section
    id="categorias"
    class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
  >
    <div
      class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4"
    >
      <div>
        <h2
          class="text-xs uppercase tracking-widest font-bold text-amber-600 dark:text-amber-400 mb-2"
        >
          Explora por mascota
        </h2>
        <p
          class="text-2xl sm:text-3xl font-extrabold text-stone-900 dark:text-white"
        >
          Categorías Populares
        </p>
      </div>
      <p class="text-sm text-stone-500 dark:text-stone-400 max-w-md">
        Encuentra rápidamente productos especialmente formulados y dimensionados
        según el tipo y tamaño de tu compañero.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        categorias.map((cat) => (
          <a
            href={cat.href}
            class={`group p-6 rounded-2xl bg-white dark:bg-stone-900 border ${cat.gradient} hover:shadow-lg transition-all duration-300 hover:-translate-y-1 block`}
          >
            <div class="w-14 h-14 rounded-2xl bg-stone-100 dark:bg-stone-800 flex items-center justify-center text-3xl mb-4 group-hover:scale-110 transition-transform">
              {cat.icon}
            </div>
            <h3 class="text-lg font-bold text-stone-900 dark:text-white mb-1 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
              {cat.title}
            </h3>
            <p class="text-xs text-stone-500 dark:text-stone-400 mb-3">
              {cat.subtitle}
            </p>
            <div class="flex items-center justify-between text-xs font-medium text-stone-600 dark:text-stone-300">
              <span>{cat.count}</span>
              <span class="text-amber-600 dark:text-amber-400 group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CATÁLOGO DESTACADO -->
  <section
    id="destacados"
    class="py-16 bg-white dark:bg-stone-900/50 border-y border-stone-200/80 dark:border-stone-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4"
      >
        <div>
          <span
            class="text-xs uppercase tracking-widest font-bold text-amber-600 dark:text-amber-400"
            >Favoritos de la comunidad</span
          >
          <h2
            class="text-2xl sm:text-3xl font-extrabold text-stone-900 dark:text-white mt-1"
          >
            Productos Destacados
          </h2>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-medium text-stone-500 dark:text-stone-400"
            >Mostrando 6 productos base</span
          >
        </div>
      </div>

      <!-- Grid de productos -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
      >
        {
          productosDestacados.map((item) => (
            <article class="flex flex-col rounded-2xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 overflow-hidden hover:shadow-xl hover:border-amber-300 dark:hover:border-amber-700 transition-all duration-300 group">
              <div class="p-4 pb-0 flex items-center justify-between">
                <span
                  class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${item.badgeColor}`}
                >
                  {item.badge}
                </span>
                <span class="text-xs text-stone-500 dark:text-stone-400 font-medium">
                  {item.stock > 0
                    ? item.stock < 8
                      ? `¡Solo ${item.stock} disponibles!`
                      : 'En Stock'
                    : 'Agotado'}
                </span>
              </div>

              <div class="h-44 flex items-center justify-center p-6 group-hover:scale-105 transition-transform duration-300">
                <div class="w-24 h-24 rounded-2xl bg-white dark:bg-stone-800 shadow-sm flex items-center justify-center text-5xl">
                  {item.icon}
                </div>
              </div>

              <div class="p-5 pt-0 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <div class="flex items-center gap-1.5 text-xs text-amber-500">
                    <span>★</span>
                    <span class="font-bold text-stone-800 dark:text-stone-200">
                      {item.rating}
                    </span>
                    <span class="text-stone-400">
                      ({item.reviewsCount} opiniones)
                    </span>
                  </div>

                  <p class="text-[11px] uppercase tracking-wider font-semibold text-stone-500 dark:text-stone-400">
                    {item.category}
                  </p>

                  <h3 class="font-bold text-stone-900 dark:text-white text-base leading-snug group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                    {item.name}
                  </h3>

                  <p class="text-xs text-stone-600 dark:text-stone-400 line-clamp-2 leading-relaxed">
                    {item.description}
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between gap-3">
                  <div class="flex flex-col">
                    <span class="text-xl font-extrabold text-stone-900 dark:text-white">
                      {formatPrice(item.price)}
                    </span>
                    {item.originalPrice && (
                      <span class="text-xs text-stone-400 line-through">
                        {formatPrice(item.originalPrice)}
                      </span>
                    )}
                  </div>

                  <button
                    type="button"
                    data-product-id={item.id}
                    data-product-name={item.name}
                    data-product-price={item.price}
                    class="add-to-cart-btn px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white text-xs font-bold shadow-sm transition-all flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 cursor-pointer"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4v16m8-8H4"
                      />
                    </svg>
                    <span>Agregar</span>
                  </button>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GARANTÍAS / BENEFICIOS -->
  <section id="beneficios" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div
        class="p-6 rounded-2xl bg-amber-50/50 dark:bg-stone-900 border border-amber-200/60 dark:border-stone-800 space-y-3"
      >
        <div
          class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold"
        >
          🚚
        </div>
        <h3 class="text-lg font-bold text-stone-900 dark:text-white">
          Despachos Express
        </h3>
        <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed">
          Recibe tus pedidos en 24 a 48 horas hábiles en las principales
          ciudades, con seguimiento en línea en tiempo real.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-amber-50/50 dark:bg-stone-900 border border-amber-200/60 dark:border-stone-800 space-y-3"
      >
        <div
          class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold"
        >
          🛡️
        </div>
        <h3 class="text-lg font-bold text-stone-900 dark:text-white">
          Garantía de Satisfacción
        </h3>
        <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed">
          ¿A tu mascota no le gustó el tamaño o textura? Tienes 30 días para
          cambios y devoluciones sin complicaciones.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-amber-50/50 dark:bg-stone-900 border border-amber-200/60 dark:border-stone-800 space-y-3"
      >
        <div
          class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold"
        >
          💬
        </div>
        <h3 class="text-lg font-bold text-stone-900 dark:text-white">
          Asesoría con Expertos
        </h3>
        <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed">
          Resolvemos tus consultas sobre porciones, dietas especiales y
          recomendaciones de juguetes para cada edad.
        </p>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER / CLUB -->
  <section
    class="py-16 bg-stone-900 text-white dark:bg-stone-950 border-t border-stone-800"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span
        class="inline-block px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold"
      >
        Únete al Club Patitas
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Recibe un 15% de descuento en tu primera compra
      </h2>
      <p class="text-stone-400 text-sm max-w-xl mx-auto leading-relaxed">
        Suscríbete para recibir ofertas exclusivas, consejos veterinarios y
        novedades sobre el cuidado de tu mascota.
      </p>

      <form
        id="newsletter-form"
        class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto pt-2"
        onsubmit="event.preventDefault();"
      >
        <label for="newsletter-email" class="sr-only">Correo electrónico</label>
        <input
          type="email"
          id="newsletter-email"
          required
          placeholder="tu@correo.com"
          class="flex-1 px-4 py-3 rounded-xl bg-stone-800 border border-stone-700 text-white placeholder-stone-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        />
        <button
          type="submit"
          class="px-6 py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-sm transition-colors cursor-pointer"
        >
          Suscribirme
        </button>
      </form>
    </div>
  </section>

  <!-- Script cliente para añadir al carrito de forma inmediata en Fase 1 -->
  <script>
    const buttons = document.querySelectorAll('.add-to-cart-btn');
    const badge = document.getElementById('cart-count-badge');
    let totalItems = 0;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        totalItems += 1;
        if (badge) {
          badge.textContent = String(totalItems);
          badge.classList.add('scale-125');
          setTimeout(() => badge.classList.remove('scale-125'), 200);
        }
      });
    });
  </script>
</BaseLayout>
