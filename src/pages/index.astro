---

<BaseLayout>
  <!-- 1. Hero Carousel estilo Bootstrap 5.3 adaptado a retail moderno de mascotas (Made in Germany, Catit, Packs) -->
  <Carousel />

  <!-- 2. Barra de Confianza y Beneficios Comerciales (Delivery Gratis, Express, Retiro, Asesoría) -->
  <TrustBar />

  <!-- 3. Categorías Circulares con fotografías realistas de productos sin textos de relleno -->
  <CircularCategories />

  <!-- 4. Fila 1: Productos en Oferta (5 por pantalla, compactos, con flecha a la derecha para ver 5 más) -->
  <ProductSlider
    id="ofertas"
    title="Productos en Oferta"
    badge="🔥 OFERTAS FLASH"
    badgeColor="bg-rose-50 text-rose-600 border-rose-200"
    subtitle="Precios rebajados por tiempo limitado con despacho en 24 a 48h en Chile"
    products={productosOfertas}
  />

  <!-- 5. Banners Especiales por Etapa de Vida (Cachorros y Gatitos, Adultos, Seniors) -->
  <LifeStageBanners />

  <!-- 6. Fila 2: Novedades (5 por pantalla, compactos, con flecha a la derecha para ver 5 más) -->
  <ProductSlider
    id="novedades"
    title="Novedades de la Semana"
    badge="✨ RECIÉN LLEGADOS"
    badgeColor="bg-amber-50 text-amber-700 border-amber-200"
    subtitle="Lo último en nutrición, accesorios y tecnología para consentir a tu mascota"
    products={productosNovedades}
  />

  <!-- GARANTÍAS / BENEFICIOS ADICIONALES -->
  <section
    id="beneficios"
    class="py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-brand-light text-brand-primary flex items-center justify-center font-bold text-xl"
        >
          🚚
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Despachos Express en Chile
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          Envíos a domicilio en 24 a 48 horas en Santiago y regiones principales
          con número de seguimiento en línea.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-brand-light text-brand-primary flex items-center justify-center font-bold text-xl"
        >
          🔒
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Pagos 100% Seguros en CLP
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          Transbank Webpay Plus, tarjetas de crédito, débito y transferencias
          bancarias con cifrado SSL de extremo a extremo.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-3 shadow-xs"
      >
        <div
          class="w-10 h-10 rounded-xl bg-brand-light text-brand-primary flex items-center justify-center font-bold text-xl"
        >
          ⭐
        </div>
        <h3 class="text-base font-bold text-stone-900">
          Garantía de Satisfacción
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          30 días de garantía para cambios o devoluciones fáciles si tu mascota
          no queda 100% satisfecha con su producto.
        </p>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER / CLUB DE MASCOTAS -->
  <section class="py-14 bg-brand-primary text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span
        class="inline-block px-3 py-1 rounded-full bg-white/20 text-xs font-semibold uppercase tracking-wider backdrop-blur-xs"
      >
        Club Market-Pet
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Únete y obtén $5.000 de descuento en tu primera compra
      </h2>
      <p class="text-sm text-white/90 max-w-xl mx-auto leading-relaxed">
        Recibe promociones exclusivas, consejos de veterinarios expertos y
        novedades para el cuidado de tu mascota.
      </p>

      <form
        class="pt-2 flex flex-col sm:flex-row gap-2 max-w-md mx-auto"
        onsubmit="event.preventDefault(); alert('¡Gracias por unirte al Club Market-Pet! Revisa tu correo con tu cupón.');"
      >
        <label for="newsletter-email" class="sr-only">Correo electrónico</label>
        <input
          type="email"
          id="newsletter-email"
          required
          placeholder="tu-correo@ejemplo.cl"
          class="flex-1 px-4 py-3 rounded-xl bg-white text-stone-900 placeholder-stone-400 text-sm focus:outline-none focus:ring-2 focus:ring-white"
        />
        <button
          type="submit"
          class="px-6 py-3 rounded-xl bg-stone-900 text-white text-sm font-bold shadow-md hover:bg-stone-800 transition-colors cursor-pointer"
        >
          Suscribirme
        </button>
      </form>
      <p class="text-[11px] text-white/70">
        Respetamos tu privacidad. Puedes darte de baja en cualquier momento con
        un clic.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Manejo de clicks en botones de agregar al carrito con feedback visual
  document.querySelectorAll('.add-to-cart-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget;
      const productName = button.getAttribute('data-product-name');

      // Animación en el botón
      button.classList.add('scale-95', '!bg-emerald-600', '!text-white');
      setTimeout(() => {
        button.classList.remove('scale-95', '!bg-emerald-600', '!text-white');
      }, 350);

      // Incrementar contador visual del carrito en el Header
      const badge = document.getElementById('cart-count-badge');
      if (badge) {
        const currentCount = parseInt(badge.textContent || '0', 10);
        badge.textContent = String(currentCount + 1);
        badge.classList.add(
          'scale-125',
          '!bg-rose-600',
          '!text-white',
          'transition-transform'
        );
        setTimeout(() => {
          badge.classList.remove('scale-125', '!bg-rose-600', '!text-white');
        }, 400);
      }
    });
  });
</script>
