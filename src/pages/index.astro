---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import TrustBar from '../components/TrustBar.astro';
import CircularCategories from '../components/CircularCategories.astro';
import ProductSlider from '../components/ProductSlider.astro';
import LifeStageBanners from '../components/LifeStageBanners.astro';
import CatalogCtaBanner from '../components/CatalogCtaBanner.astro';
import ClubNewsletter from '../components/ClubNewsletter.astro';
import { getCollection } from 'astro:content';

// Obtención dinámica del catálogo desde Content Collections (Fase 2)
const allProducts = await getCollection('productos');

// Catálogo 1: Productos en Oferta
const productosOfertas = allProducts
  .filter((p) => p.data.isOffer)
  .map((p) => ({
    id: p.data.id,
    slug: p.data.slug,
    name: p.data.name,
    category: p.data.category,
    price: p.data.price,
    originalPrice: p.data.originalPrice,
    rating: p.data.rating,
    reviewsCount: p.data.reviewsCount,
    badge: p.data.badge,
    badgeColor: p.data.badgeColor,
    image: p.data.image,
    imageAlt: p.data.imageAlt,
  }));

// Catálogo 2: Novedades & Esenciales de la Semana
const productosNovedades = allProducts
  .filter((p) => p.data.isNew || !p.data.isOffer)
  .map((p) => ({
    id: p.data.id,
    slug: p.data.slug,
    name: p.data.name,
    category: p.data.category,
    price: p.data.price,
    originalPrice: p.data.originalPrice,
    rating: p.data.rating,
    reviewsCount: p.data.reviewsCount,
    badge: p.data.isNew ? '✨ NUEVO' : p.data.badge || '',
    badgeColor: p.data.isNew
      ? 'bg-emerald-600 text-white'
      : p.data.badgeColor || 'bg-stone-800 text-white',
    image: p.data.image,
    imageAlt: p.data.imageAlt,
  }));
---

<BaseLayout>
  <!-- 1. Hero Carousel estilo Bootstrap 5.3 adaptado a retail moderno de mascotas (Made in Germany, Catit, Packs) -->
  <Carousel />

  <!-- 2. Barra de Confianza y Beneficios Comerciales (Delivery Gratis, Express, Retiro, Asesoría) -->
  <TrustBar />

  <!-- 3. Categorías Circulares con fotografías realistas de productos sin textos de relleno -->
  <CircularCategories />

  <!-- 4. Fila 1: Productos en Oferta (5 por pantalla, compactos, con flecha a la derecha para ver 5 más) -->
  <ProductSlider
    id="ofertas"
    title="Productos en Oferta"
    badge="🔥 OFERTAS FLASH"
    badgeColor="bg-rose-50 text-rose-600 border-rose-200"
    subtitle="Precios rebajados por tiempo limitado con despacho en 24 a 48h en Chile"
    products={productosOfertas}
  />

  <!-- 5. Banners Especiales por Etapa de Vida (Cachorros y Gatitos, Adultos, Seniors) -->
  <LifeStageBanners />

  <!-- 6. Fila 2: Novedades (5 por pantalla, compactos, con flecha a la derecha para ver 5 más) -->
  <ProductSlider
    id="novedades"
    title="Novedades de la Semana"
    badge="✨ RECIÉN LLEGADOS"
    badgeColor="bg-amber-50 text-amber-700 border-amber-200"
    subtitle="Lo último en nutrición, accesorios y tecnología para consentir a tu mascota"
    products={productosNovedades}
  />

  <!-- 7. Banner Emocional de Llamado al Catálogo con Arcos de Mascotas -->
  <CatalogCtaBanner />

  <!-- 8. Tarjeta VIP Club Market-Pet (Newsletter con Cupón de $5.000) -->
  <ClubNewsletter />
</BaseLayout>
