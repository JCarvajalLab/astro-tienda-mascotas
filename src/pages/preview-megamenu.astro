---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import packCachorro from '../assets/products/pack-cachorro.jpg';
import packDescanso from '../assets/products/pack-descanso.jpg';
import alimentoPerro from '../assets/products/alimento-perro.jpg';

// Datos limpios sin emojis
const subcatsPerros = [
  {
    grupo: 'Alimentos & Nutrición',
    items: [
      {
        label: 'Alimento Seco Premium',
        desc: 'Salmón, Pollo y Fórmulas 7+',
        href: '/categoria/alimentos-perro',
        icon: 'bowl',
      },
      {
        label: 'Snacks Dentales & Premios',
        desc: 'Higiene bucal y clorofila',
        href: '/categoria/snacks-premios',
        icon: 'bone',
      },
      {
        label: 'Fórmulas Cachorros Puppy',
        desc: 'Crecimiento y defensas',
        href: '/categoria/cachorros',
        icon: 'paw',
      },
      {
        label: 'Nutrición Senior Articular 7+',
        desc: 'Glucosamina y movilidad',
        href: '/categoria/seniors',
        icon: 'heart',
      },
    ],
  },
  {
    grupo: 'Paseo, Confort & Higiene',
    items: [
      {
        label: 'Arneses Antitirones',
        desc: 'Ergonómicos y reflectantes',
        href: '/categoria/paseo-seguridad',
        icon: 'shield',
      },
      {
        label: 'Collares Reflectantes',
        desc: 'Alta visibilidad nocturna',
        href: '/categoria/paseo-seguridad',
        icon: 'sparkles',
      },
      {
        label: 'Camas Ortopédicas',
        desc: 'Memory foam viscoelástico',
        href: '/categoria/camas-confort',
        icon: 'bed',
      },
      {
        label: 'Shampoos Dermoprotectores',
        desc: 'Avena y extractos naturales',
        href: '/categoria/higiene-cuidados',
        icon: 'drop',
      },
    ],
  },
];
---

<BaseLayout
  title="Laboratorio de Mega-Menús (Sin Emojis) | Market-Pet"
  description="Comparativa de diseño para el Mega-Menú de subcategorías: Tipografía Limpia vs Iconos Vectoriales SVG sutiles."
  hideHeader={true}
>
  <!-- Barra de control superior fija -->
  <aside
    class="sticky top-0 z-50 bg-stone-900 text-white border-b border-stone-800 shadow-xl backdrop-blur-md bg-opacity-95"
  >
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3"
    >
      <div class="flex items-center gap-3">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-rose-600 text-white font-black text-xs"
        >
          UX
        </span>
        <div>
          <h1
            class="text-xs sm:text-sm font-bold tracking-tight text-white flex items-center gap-2"
          >
            Laboratorio: Mega-Menú Split sin Emojis
            <span
              class="text-[10px] bg-rose-950 text-rose-300 border border-rose-800/80 px-2 py-0.5 rounded-full font-semibold"
            >
              Edición Profesional
            </span>
          </h1>
          <p class="text-[11px] text-stone-400">
            Diseño sobrio de alta gama: Tipografía Limpia vs Micro-SVGs
            Monocromáticos.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="#opcion-1a"
          class="px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-xs font-semibold text-stone-200 transition-colors"
        >
          1A: Tipografía Limpia
        </a>
        <a
          href="#opcion-1b"
          class="px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-xs font-semibold text-stone-200 transition-colors"
        >
          1B: Con Micro-SVGs
        </a>
        <a
          href="/"
          class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-xs font-bold text-white transition-colors"
        >
          Volver a la Home
        </a>
      </div>
    </div>
  </aside>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    <!-- Intro informativa -->
    <header class="text-center max-w-3xl mx-auto space-y-3">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-bold"
      >
        <span>Diseño Profesional de Retail</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tight">
        Mega-Menú Vitrina Split: Eliminación total de Emojis
      </h2>
      <p class="text-sm text-stone-600 leading-relaxed">
        El abuso de emojis infantiles genera sensación de "plantilla genérica o
        IA". Al reemplazarlos por <strong
          >tipografía con jerarquía editorial nítida</strong
        > o
        <strong>iconos vectoriales lineales SVG monocromáticos</strong>, la
        tienda adquiere un porte de marca oficial, sobria y premium.
      </p>
    </header>

    <!-- ========================================================================= -->
    <!-- OPCIÓN 1A: TIPOGRAFÍA LIMPIA (CERO ICONOS, MÁXIMA ELEGANCIA) -->
    <!-- ========================================================================= -->
    <section id="opcion-1a" class="scroll-mt-24 space-y-6">
      <div class="border-l-4 border-rose-600 pl-4 py-1">
        <div class="flex items-center gap-2">
          <span
            class="px-2.5 py-0.5 rounded-md bg-rose-600 text-white text-[11px] font-black uppercase tracking-wider"
          >
            Opción 1A · Recomendada
          </span>
          <span class="text-xs font-semibold text-stone-500">
            Tipografía Editorial Limpia (Estilo Apple / Nike / Zara)
          </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-stone-900 mt-1">
          Tipografía Pura con Micro-indicador Hover (Sin Iconos)
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 mt-1 max-w-4xl">
          <strong>Concepto:</strong> Cero iconos. La jerarquía la define la tipografía:
          kickers en tracking abierto, títulos nítidos y subtítulos sutiles. Al pasar
          el cursor, la tarjeta se ilumina en un suave tono biscuit/rose y aparece
          una flecha sutil (<span class="text-rose-600 font-bold">→</span>)
          indicando acción.
        </p>
      </div>

      <!-- Barra de navegación simulada con hover interactivo para 1A -->
      <div
        class="bg-[#FAF7F2] p-4 rounded-2xl border border-stone-200/80 shadow-sm"
      >
        <div
          class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-2 flex items-center justify-between"
        >
          <span
            >Prueba interactiva (Pasa el cursor por "Perros" o "Mascotas"):</span
          >
          <span class="text-rose-600 text-[10px]">Hover activo ↓</span>
        </div>
        <nav
          class="bg-white/80 backdrop-blur rounded-xl border border-stone-200 px-4 py-2 flex items-center gap-4"
        >
          <div class="relative nav-demo-item">
            <button
              class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-rose-600 bg-rose-50 rounded-lg"
            >
              Perros <span class="text-[10px] text-rose-500">▾</span>
            </button>
            <div
              class="nav-demo-dropdown absolute top-full left-0 pt-2 z-30 hidden"
            >
              <!-- Dropdown interactivo 1A -->
              <div
                class="w-[640px] bg-white rounded-3xl shadow-2xl border border-stone-200/90 p-5 grid grid-cols-3 gap-5 text-stone-900"
              >
                <div class="col-span-2 space-y-4">
                  <div
                    class="flex items-center justify-between pb-2 border-b border-stone-100"
                  >
                    <div>
                      <span
                        class="text-xs font-black text-stone-900 block leading-tight"
                        >Mundo Perros</span
                      >
                      <span class="text-[10px] text-stone-400"
                        >Nutrición y equipamiento diario</span
                      >
                    </div>
                    <a
                      href="/categoria/perros"
                      class="text-xs font-bold text-rose-600 hover:underline"
                      >Ver todo →</a
                    >
                  </div>

                  <div class="grid grid-cols-2 gap-4">
                    {
                      subcatsPerros.map((col) => (
                        <div class="space-y-1.5">
                          <span class="text-[10px] font-black uppercase tracking-wider text-rose-600 block pl-1">
                            {col.grupo}
                          </span>
                          <div class="space-y-1">
                            {col.items.map((it) => (
                              <a
                                href={it.href}
                                class="p-2 rounded-xl hover:bg-rose-50/80 transition-all group flex items-center justify-between block"
                              >
                                <div class="min-w-0 pr-2">
                                  <span class="block text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors leading-tight truncate">
                                    {it.label}
                                  </span>
                                  <span class="block text-[10px] text-stone-400 group-hover:text-stone-600 transition-colors leading-tight truncate mt-0.5">
                                    {it.desc}
                                  </span>
                                </div>
                                <span class="text-xs font-bold text-rose-500 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all shrink-0">
                                  →
                                </span>
                              </a>
                            ))}
                          </div>
                        </div>
                      ))
                    }
                  </div>
                </div>

                <!-- Columna derecha promocional sin emojis -->
                <div
                  class="bg-gradient-to-br from-rose-50 via-white to-amber-50/50 rounded-2xl p-4 border border-rose-100 flex flex-col justify-between"
                >
                  <div class="space-y-2.5">
                    <div
                      class="relative overflow-hidden rounded-xl h-24 w-full bg-stone-100 shadow-inner"
                    >
                      <Image
                        src={packCachorro}
                        alt="Pack Destacado"
                        width={200}
                        height={150}
                        format="webp"
                        class="w-full h-full object-cover"
                      />
                      <span
                        class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-rose-600 text-white font-black text-[9px] uppercase tracking-wider shadow"
                      >
                        Hasta 32% OFF
                      </span>
                    </div>
                    <div>
                      <h5
                        class="text-xs font-black text-stone-900 leading-tight"
                      >
                        Pack Bienvenida Cachorro
                      </h5>
                      <p class="text-[11px] text-stone-600 leading-snug mt-1">
                        Nutrición adaptada, plato antivoracidad y manta de
                        apego.
                      </p>
                    </div>
                  </div>
                  <a
                    href="/categoria/packs-promocionales"
                    class="mt-3 w-full py-1.5 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center justify-center gap-1 transition-colors"
                  >
                    Explorar Packs <span>→</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <span
            class="text-xs font-semibold text-stone-700 hover:text-stone-900 cursor-pointer"
            >Mascotas</span
          >
          <span
            class="text-xs font-semibold text-stone-700 hover:text-stone-900 cursor-pointer"
            >Gatos</span
          >
          <span
            class="text-xs font-semibold text-stone-700 hover:text-stone-900 cursor-pointer"
            >Accesorios</span
          >
          <span
            class="text-xs font-semibold text-stone-700 hover:text-stone-900 cursor-pointer"
            >Farmacia & Salud</span
          >
          <span
            class="text-xs font-bold text-rose-600 hover:text-rose-700 cursor-pointer"
            >Ofertas Flash</span
          >
        </nav>
      </div>

      <!-- Vista Estática Abierta de Opción 1A -->
      <div
        class="bg-gradient-to-b from-stone-50 to-stone-100/70 p-6 sm:p-8 rounded-3xl border border-stone-200"
      >
        <div class="flex items-center justify-between mb-4">
          <span
            class="text-xs font-black text-stone-700 uppercase tracking-wider flex items-center gap-2"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"
            ></span>
            Vista Abierta en Detalle (1A: Tipografía Limpia):
          </span>
          <span class="text-xs text-stone-500 font-medium"
            >Ancho completo: 640px</span
          >
        </div>

        <div
          class="max-w-2xl mx-auto bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl border border-stone-200/90 p-5 sm:p-6 text-stone-900"
        >
          <div
            class="flex items-center justify-between pb-3 mb-4 border-b border-stone-100"
          >
            <div>
              <h4 class="text-sm font-black text-stone-900 leading-tight">
                Mundo Perros
              </h4>
              <p class="text-[11px] text-stone-400 font-medium">
                Nutrición premium, accesorios de paseo y confort
              </p>
            </div>
            <a
              href="/categoria/perros"
              class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline flex items-center gap-1 group"
            >
              Ver todo en Perros <span
                class="group-hover:translate-x-0.5 transition-transform">→</span
              >
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <div class="sm:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
              {
                subcatsPerros.map((col) => (
                  <div class="space-y-2">
                    <div class="flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider text-rose-600 pl-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500" />
                      {col.grupo}
                    </div>
                    <div class="space-y-1">
                      {col.items.map((it) => (
                        <a
                          href={it.href}
                          class="p-2.5 rounded-xl hover:bg-rose-50/90 border border-transparent hover:border-rose-100 transition-all group flex items-center justify-between block"
                        >
                          <div class="min-w-0 pr-2">
                            <span class="block text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors leading-tight truncate">
                              {it.label}
                            </span>
                            <span class="block text-[10px] text-stone-400 group-hover:text-stone-600 transition-colors leading-tight truncate mt-0.5">
                              {it.desc}
                            </span>
                          </div>
                          <span class="text-xs font-bold text-rose-500 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all shrink-0">
                            →
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>

            <aside
              class="rounded-2xl bg-gradient-to-br from-rose-50 via-white to-amber-50/50 p-4 border border-rose-100 flex flex-col justify-between shadow-xs"
            >
              <div class="space-y-2.5">
                <div
                  class="relative overflow-hidden rounded-xl h-24 w-full bg-stone-100 shadow-inner"
                >
                  <Image
                    src={packCachorro}
                    alt="Pack Destacado"
                    width={200}
                    height={150}
                    format="webp"
                    class="w-full h-full object-cover"
                  />
                  <span
                    class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-rose-600 text-white font-black text-[9px] uppercase tracking-wider shadow"
                  >
                    Hasta 32% OFF
                  </span>
                </div>
                <div>
                  <h5 class="text-xs font-black text-stone-900 leading-tight">
                    Pack Bienvenida Cachorro
                  </h5>
                  <p class="text-[11px] text-stone-600 leading-snug mt-1">
                    Alimento super premium, plato antivoracidad y manta de
                    apego.
                  </p>
                </div>
              </div>
              <div class="pt-3 border-t border-rose-100/80 mt-2">
                <a
                  href="/categoria/packs-promocionales"
                  class="w-full py-2 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-all shadow-xs cursor-pointer"
                >
                  <span>Explorar Packs</span>
                  <span class="text-xs">→</span>
                </a>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- OPCIÓN 1B: CON MICRO-SVGS LINEALES SUTILES (MONOCROMÁTICOS) -->
    <!-- ========================================================================= -->
    <section
      id="opcion-1b"
      class="scroll-mt-24 space-y-6 pt-6 border-t border-stone-200"
    >
      <div class="border-l-4 border-stone-900 pl-4 py-1">
        <div class="flex items-center gap-2">
          <span
            class="px-2.5 py-0.5 rounded-md bg-stone-900 text-white text-[11px] font-black uppercase tracking-wider"
          >
            Opción 1B · Alternativa
          </span>
          <span class="text-xs font-semibold text-stone-500">
            Micro-SVGs Lineales Monocromáticos (Estilo Chewy / Petco)
          </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-stone-900 mt-1">
          Píldoras con Iconos Vectoriales SVG Lineales (Sin Colores Infantiles)
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 mt-1 max-w-4xl">
          <strong>Concepto:</strong> Mantiene la misma estructura de vitrina split,
          pero añade un **pequeño icono SVG lineal monocromático** (trazo fino de
          1.75px en tono café/rosa sobrio), aportando anclaje visual rápido sin parecer
          emojis ni caricaturas.
        </p>
      </div>

      <!-- Vista Estática Abierta de Opción 1B -->
      <div
        class="bg-gradient-to-b from-stone-50 to-stone-100/70 p-6 sm:p-8 rounded-3xl border border-stone-200"
      >
        <div class="flex items-center justify-between mb-4">
          <span
            class="text-xs font-black text-stone-700 uppercase tracking-wider flex items-center gap-2"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-stone-800"></span>
            Vista Abierta en Detalle (1B: Con Micro-SVGs):
          </span>
          <span class="text-xs text-stone-500 font-medium"
            >Ancho completo: 640px</span
          >
        </div>

        <div
          class="max-w-2xl mx-auto bg-white rounded-3xl shadow-2xl border border-stone-200/90 p-5 sm:p-6 text-stone-900"
        >
          <div
            class="flex items-center justify-between pb-3 mb-4 border-b border-stone-100"
          >
            <div>
              <h4 class="text-sm font-black text-stone-900 leading-tight">
                Mundo Perros
              </h4>
              <p class="text-[11px] text-stone-400 font-medium">
                Nutrición premium, accesorios de paseo y confort
              </p>
            </div>
            <a
              href="/categoria/perros"
              class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline flex items-center gap-1 group"
            >
              Ver todo en Perros <span
                class="group-hover:translate-x-0.5 transition-transform">→</span
              >
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <div class="sm:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Columna 1 -->
              <div class="space-y-2">
                <div
                  class="flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider text-rose-600 pl-1"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                  Alimentos & Nutrición
                </div>
                <div class="space-y-1">
                  <!-- Item con SVG Bowl -->
                  <a
                    href="/categoria/alimentos-perro"
                    class="p-2 rounded-xl hover:bg-rose-50/90 border border-transparent hover:border-rose-100 transition-all group flex items-start gap-2.5"
                  >
                    <div
                      class="w-7 h-7 rounded-lg bg-stone-100 group-hover:bg-rose-100 text-stone-600 group-hover:text-rose-600 flex items-center justify-center shrink-0 transition-colors mt-0.5"
                    >
                      <svg
                        class="w-3.5 h-3.5 stroke-current stroke-[1.75]"
                        fill="none"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                        ></path>
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <span
                        class="block text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors leading-tight"
                      >
                        Alimento Seco Premium
                      </span>
                      <span
                        class="block text-[10px] text-stone-400 group-hover:text-stone-600 transition-colors leading-tight mt-0.5"
                      >
                        Salmón, Pollo y Fórmulas 7+
                      </span>
                    </div>
                  </a>

                  <!-- Item con SVG Bone -->
                  <a
                    href="/categoria/snacks-premios"
                    class="p-2 rounded-xl hover:bg-rose-50/90 border border-transparent hover:border-rose-100 transition-all group flex items-start gap-2.5"
                  >
                    <div
                      class="w-7 h-7 rounded-lg bg-stone-100 group-hover:bg-rose-100 text-stone-600 group-hover:text-rose-600 flex items-center justify-center shrink-0 transition-colors mt-0.5"
                    >
                      <svg
                        class="w-3.5 h-3.5 stroke-current stroke-[1.75]"
                        fill="none"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"
                        ></path>
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <span
                        class="block text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors leading-tight"
                      >
                        Snacks Dentales & Premios
                      </span>
                      <span
                        class="block text-[10px] text-stone-400 group-hover:text-stone-600 transition-colors leading-tight mt-0.5"
                      >
                        Higiene bucal y clorofila
                      </span>
                    </div>
                  </a>

                  <!-- Item Puppy -->
                  <a
                    href="/categoria/cachorros"
                    class="p-2 rounded-xl hover:bg-rose-50/90 border border-transparent hover:border-rose-100 transition-all group flex items-start gap-2.5"
                  >
                    <div
