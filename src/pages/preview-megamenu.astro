---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import packCachorro from '../assets/products/pack-cachorro.jpg';
import packDescanso from '../assets/products/pack-descanso.jpg';
import alimentoPerro from '../assets/products/alimento-perro.jpg';

// Datos de ejemplo para la comparativa
const subcatsPerros = [
  {
    grupo: 'Alimentos & Nutrición',
    items: [
      { label: 'Alimento Seco Premium', desc: 'Salmón, Pollo y Fórmulas 7+', href: '/categoria/alimentos-perro', icon: '🍖' },
      { label: 'Snacks Dentales & Premios', desc: 'Higiene bucal y clorofila', href: '/categoria/snacks-premios', icon: '🦴' },
      { label: 'Fórmulas Cachorros Puppy', desc: 'Crecimiento y defensas', href: '/categoria/cachorros', icon: '🍼' },
      { label: 'Nutrición Senior Articular 7+', desc: 'Glucosamina y movilidad', href: '/categoria/seniors', icon: '🧓' },
    ],
  },
  {
    grupo: 'Paseo, Confort & Higiene',
    items: [
      { label: 'Arneses Antitirones', desc: 'Ergonómicos y reflectantes', href: '/categoria/paseo-seguridad', icon: '🦮' },
      { label: 'Collares Reflectantes', desc: 'Alta visibilidad nocturna', href: '/categoria/paseo-seguridad', icon: '✨' },
      { label: 'Camas Ortopédicas', desc: 'Memory foam viscoelástico', href: '/categoria/camas-confort', icon: '🛏️' },
      { label: 'Shampoos Dermoprotectores', desc: 'Avena y extractos naturales', href: '/categoria/higiene-cuidados', icon: '🧼' },
    ],
  },
];

const subcatsMascotas = [
  {
    grupo: 'Por Etapa de Vida',
    items: [
      { label: 'Especial Cachorritos & Gatitos', desc: 'Primeros pasos y apego', href: '/categoria/cachorros', icon: '🍼' },
      { label: 'Compañeros Adultos', desc: 'Energía y nutrición diaria', href: '/categoria/adultos', icon: '🐕' },
      { label: 'Fiel Amigo Senior (7+)', desc: 'Bienestar y movilidad', href: '/categoria/seniors', icon: '🧓' },
    ],
  },
  {
    grupo: 'Colecciones Especiales',
    items: [
      { label: 'Packs Bienvenida & Ahorro', desc: 'Kits listos con hasta 32% OFF', href: '/categoria/packs-promocionales', icon: '🎁' },
      { label: 'Smart Pet & Tecnología', desc: 'Comederos y fuentes WiFi', href: '/categoria/smart-pet', icon: '📱' },
      { label: 'Mantas Térmicas & Felpa', desc: 'Calidez sherpa para el hogar', href: '/categoria/camas-confort', icon: '🧣' },
    ],
  },
];
---

<BaseLayout
  title="Laboratorio de Mega-Menús | Market-Pet"
  description="Comparativa de diseño para el Mega-Menú de subcategorías: Vitrina Híbrida Split vs Grilla Modular de Píldoras."
  hideHeader={true}
>
  <!-- Barra de control superior fija -->
  <aside class="sticky top-0 z-50 bg-stone-900 text-white border-b border-stone-800 shadow-xl backdrop-blur-md bg-opacity-95">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-rose-600 text-white font-black text-xs">
          UX
        </span>
        <div>
          <h1 class="text-xs sm:text-sm font-bold tracking-tight text-white flex items-center gap-2">
            Laboratorio de Diseño: Comparativa de Mega-Menús
            <span class="text-[10px] bg-rose-950 text-rose-300 border border-rose-800/80 px-2 py-0.5 rounded-full font-semibold">
              Fase 2
            </span>
          </h1>
          <p class="text-[11px] text-stone-400">
            Evalúa la composición visual de las dos opciones para las subcategorías.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="#opcion-1"
          class="px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-xs font-semibold text-stone-200 transition-colors"
        >
          Opción 1: Vitrina Split
        </a>
        <a
          href="#opcion-2"
          class="px-3 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-xs font-semibold text-stone-200 transition-colors"
        >
          Opción 2: Grilla Modular
        </a>
        <a
          href="/"
          class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-xs font-bold text-white transition-colors"
        >
          Volver a la Home
        </a>
      </div>
    </div>
  </aside>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    <!-- Intro informativa -->
    <header class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-bold">
        <span>✨</span> Propuestas de Dirección de Arte Frontend
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tight">
        ¿Cómo modernizar la presentación de las subcategorías?
      </h2>
      <p class="text-sm text-stone-600 leading-relaxed">
        Las tiendas tradicionales muestran listas planas de enlaces. Las tiendas de alta conversión
        estructuran el menú con <strong>tarjetas táctiles, micro-iconos, jerarquía tipográfica y elementos promocionales</strong>.
        A continuación puedes ver ambas alternativas en vista abierta y probarlas al hacer hover.
      </p>
    </header>

    <!-- ========================================================================= -->
    <!-- OPCIÓN 1: VITRINA HÍBRIDA SPLIT SHOWCASE (RECOMENDADA) -->
    <!-- ========================================================================= -->
    <section id="opcion-1" class="scroll-mt-24 space-y-6">
      <div class="border-l-4 border-rose-600 pl-4 py-1">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-md bg-rose-600 text-white text-[11px] font-black uppercase tracking-wider">
            Opción 1 · Recomendada
          </span>
          <span class="text-xs font-semibold text-stone-500">
            Estilo Retail Moderno (Chewy / Apple / BarkBox)
          </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-stone-900 mt-1">
          Vitrina Híbrida Split Showcase (Navegación + Tarjeta Destacada)
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 mt-1 max-w-4xl">
          <strong>Composición:</strong> Divide el menú en 2 áreas: a la izquierda, 2 columnas con píldoras interactivas,
          micro-iconos y descripciones que se iluminan al pasar el cursor; a la derecha, una <strong>Mini-Tarjeta Promocional</strong>
          con fotografía de producto, badge y llamada a la acción hacia las mejores ofertas.
        </p>
      </div>

      <!-- Barra de navegación simulada con hover funcional para Opción 1 -->
      <div class="bg-[#FAF7F2] p-4 rounded-2xl border border-stone-200/80 shadow-sm">
        <div class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mb-2 flex items-center justify-between">
          <span>Prueba interactiva (Pasa el cursor por "🐶 Perros" o "🐾 Mascotas"):</span>
          <span class="text-rose-600 text-[10px]">Hover activo ↓</span>
        </div>
        <nav class="bg-white/80 backdrop-blur rounded-xl border border-stone-200 px-4 py-2 flex items-center gap-4">
          <div class="relative nav-demo-item">
            <button class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-stone-800 hover:text-rose-600 rounded-lg hover:bg-stone-50">
              <span>🐾</span> Mascotas <span class="text-[10px] text-stone-400">▾</span>
            </button>
            <div class="nav-demo-dropdown absolute top-full left-0 pt-2 z-30 hidden">
              <div class="w-[620px] bg-white rounded-3xl shadow-2xl border border-stone-200/90 p-5 grid grid-cols-3 gap-5">
                <div class="col-span-2 space-y-4">
                  <div class="flex items-center justify-between pb-2 border-b border-stone-100">
                    <span class="text-xs font-black text-stone-900">🐾 Por Etapa de Vida</span>
                    <a href="/categoria/perros" class="text-xs font-bold text-rose-600 hover:underline">Ver todo →</a>
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    {subcatsMascotas[0].items.map((item) => (
                      <a href={item.href} class="p-2 rounded-xl hover:bg-rose-50/80 group transition-all block">
                        <div class="flex items-center gap-2">
                          <span class="text-base">{item.icon}</span>
                          <div>
                            <span class="block text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors leading-tight">
                              {item.label}
                            </span>
                            <span class="text-[10px] text-stone-400 group-hover:text-stone-600 transition-colors">
                              {item.desc}
                            </span>
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
                <div class="bg-gradient-to-br from-rose-50 to-amber-50/60 rounded-2xl p-4 border border-rose-100 flex flex-col justify-between">
                  <div>
                    <span class="inline-block px-2 py-0.5 rounded-full bg-rose-600 text-white font-black text-[9px] uppercase tracking-wider mb-2">
                      ⭐ Recomendado
                    </span>
                    <h4 class="text-xs font-black text-stone-900 leading-tight">
                      Packs de Ahorro Mensual
                    </h4>
                    <p class="text-[11px] text-stone-600 mt-1">
                      Combos de bienvenida con hasta 32% de descuento.
                    </p>
                  </div>
                  <a href="/categoria/packs-promocionales" class="mt-3 inline-flex items-center justify-center gap-1 w-full py-1.5 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs transition-colors">
                    Ver Packs <span>→</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="relative nav-demo-item">
            <button class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-rose-600 bg-rose-50 rounded-lg">
              <span>🐶</span> Perros <span class="text-[10px] text-rose-500">▾</span>
            </button>
            <div class="nav-demo-dropdown absolute top-full left-0 pt-2 z-30 hidden">
              <!-- El mismo menú que abajo -->
            </div>
          </div>

          <span class="text-xs text-stone-400">🐱 Gatos</span>
          <span class="text-xs text-stone-400">🎾 Accesorios</span>
          <span class="text-xs text-stone-400">🩺 Farmacia</span>
          <span class="text-xs text-stone-400">🔥 Ofertas Flash</span>
        </nav>
      </div>

      <!-- Vista Estática Abierta de Opción 1 (Para estudiar el diseño a detalle) -->
      <div class="bg-gradient-to-b from-stone-50 to-stone-100/70 p-6 sm:p-8 rounded-3xl border border-stone-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-black text-stone-700 uppercase tracking-wider flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Vista Abierta en Detalle (Ejemplo para "🐶 Perros"):
          </span>
          <span class="text-xs text-stone-500 font-medium">Ancho completo de la tarjeta: 640px</span>
        </div>

        <!-- Tarjeta de Dropdown Opción 1 -->
        <div class="max-w-2xl mx-auto bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl border border-stone-200/90 p-5 sm:p-6 text-stone-900">
          <!-- Cabecera del Dropdown -->
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-stone-100">
            <div class="flex items-center gap-2.5">
              <span class="text-2xl p-1.5 rounded-xl bg-amber-50 border border-amber-100">🐶</span>
              <div>
                <h4 class="text-sm font-black text-stone-900 leading-tight">
                  Mundo Perros
                </h4>
                <p class="text-[11px] text-stone-400 font-medium">
                  Nutrición premium, accesorios de paseo y descanso
                </p>
              </div>
            </div>
            <a
              href="/categoria/perros"
              class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline flex items-center gap-1 group"
            >
              Ver todo en Perros <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </div>

          <!-- Grilla Split: 2 columnas de navegación + 1 columna de vitrina promocional -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <!-- 2 Columnas de Navegación con Píldoras Interactivas -->
            <div class="sm:col-span-2 space-y-4">
              {subcatsPerros.map((col) => (
                <div class="space-y-1.5">
                  <div class="flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider text-rose-600 pl-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                    {col.grupo}
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                    {col.items.map((it) => (
                      <a
                        href={it.href}
                        class="p-2 rounded-xl hover:bg-rose-50/90 border border-transparent hover:border-rose-100 transition-all group block"
                      >
                        <div class="flex items-start gap-2">
                          <span class="text-sm p-1 rounded-lg bg-stone-100 group-hover:bg-white text-stone-700 transition-colors shrink-0">
                            {it.icon}
                          </span>
                          <div class="min-w-0">
                            <span class="block text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors leading-snug truncate">
                              {it.label}
                            </span>
                            <span class="block text-[10px] text-stone-400 group-hover:text-stone-600 transition-colors leading-tight truncate">
                              {it.desc}
                            </span>
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            <!-- Columna Derecha: Tarjeta Promocional / Colección Estrella -->
            <aside class="rounded-2xl bg-gradient-to-br from-rose-50 via-white to-amber-50/50 p-4 border border-rose-100 flex flex-col justify-between shadow-xs">
              <div class="space-y-2.5">
                <div class="relative overflow-hidden rounded-xl h-24 w-full bg-stone-100 shadow-inner">
                  <Image
                    src={packCachorro}
                    alt="Pack Destacado Perros"
                    width={200}
                    height={150}
                    format="webp"
                    class="w-full h-full object-cover"
                  />
                  <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-rose-600 text-white font-black text-[9px] uppercase tracking-wider shadow">
                    🔥 Hasta 32% OFF
                  </span>
                </div>
                <div>
                  <h5 class="text-xs font-black text-stone-900 leading-tight">
                    Pack Bienvenida Cachorro
                  </h5>
                  <p class="text-[11px] text-stone-600 leading-snug mt-1">
                    Incluye alimento super premium, plato antivoracidad y manta de apego.
                  </p>
                </div>
              </div>

              <div class="pt-3 border-t border-rose-100/80 mt-2">
                <a
                  href="/categoria/packs-promocionales"
                  class="w-full py-2 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-all shadow-xs cursor-pointer"
                >
                  <span>Explorar Packs</span>
                  <span class="text-xs">→</span>
                </a>
              </div>
            </aside>
          </div>
        </div>
      </div>

      <!-- Ventajas de la Opción 1 -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-white border border-stone-200">
          <span class="font-bold text-rose-600 block mb-1">🎯 Mayor Conversión</span>
          Aprovecha el espacio del menú no solo para enlaces pasivos, sino para destacar ofertas reales y packs con foto.
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-stone-200">
          <span class="font-bold text-stone-900 block mb-1">✨ Micro-interacciones Claras</span>
          Las píldoras con iconos y descripciones cortas evitan adivinar qué contiene cada sección.
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-stone-200">
          <span class="font-bold text-stone-900 block mb-1">🏷️ Identidad de Marca</span>
          Sensación de ecommerce moderno de alta gama (estilo tienda oficial).
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- OPCIÓN 2: GRILLA MODULAR DE PÍLDORAS VISUALES (BOUTIQUE MINIMALISTA) -->
    <!-- ========================================================================= -->
    <section id="opcion-2" class="scroll-mt-24 space-y-6 pt-6 border-t border-stone-200">
      <div class="border-l-4 border-stone-900 pl-4 py-1">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-md bg-stone-900 text-white text-[11px] font-black uppercase tracking-wider">
            Opción 2 · Alternativa
          </span>
          <span class="text-xs font-semibold text-stone-500">
            Estilo Boutique Minimalista (Simétrica & Rápida)
          </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-stone-900 mt-1">
          Grilla Modular de Píldoras Visuales (3 Columnas Equilibradas)
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 mt-1 max-w-4xl">
          <strong>Composición:</strong> Prescinde del banner promocional lateral y utiliza todo el ancho para una grilla
          simétrica de 3 columnas con **tarjetas/píldoras táctiles con iconos grandes y subtítulos explicativos**. Ideal para un
          escaneo visual ultrarrápido y ordenado.
        </p>
      </div>

      <!-- Vista Estática Abierta de Opción 2 -->
      <div class="bg-gradient-to-b from-stone-50 to-stone-100/70 p-6 sm:p-8 rounded-3xl border border-stone-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-black text-stone-700 uppercase tracking-wider flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-stone-800"></span>
            Vista Abierta en Detalle (Ejemplo para "🐶 Perros"):
          </span>
          <span class="text-xs text-stone-500 font-medium">Ancho simétrico: 580px</span>
        </div>

        <!-- Tarjeta de Dropdown Opción 2 -->
        <div class="max-w-2xl mx-auto bg-white rounded-3xl shadow-2xl border border-stone-200/90 p-5 sm:p-6 text-stone-900">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-stone-100">
            <div class="flex items-center gap-2">
              <span class="text-xl">🐶</span>
              <span class="text-sm font-black text-stone-900">Categorías de Perros</span>
            </div>
            <a href="/categoria/perros" class="text-xs font-bold text-rose-600 hover:underline">
              Ver todo el catálogo →
            </a>
          </div>

          <!-- Grilla de 3 Columnas Simétricas -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <a
              href="/categoria/alimentos-perro"
              class="p-3 rounded-2xl border border-stone-200/80 hover:border-rose-300 hover:bg-rose-50/60 transition-all group flex flex-col justify-between"
            >
              <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg mb-2">
                🍖
              </div>
              <div>
                <span class="block text-xs font-black text-stone-900 group-hover:text-rose-600 transition-colors">
                  Alimentos Secos
                </span>
                <span class="block text-[10px] text-stone-400 mt-0.5 leading-tight">
                  Salmón, Pollo & Fórmulas
                </span>
              </div>
            </a>

            <a
              href="/categoria/snacks-premios"
              class="p-3 rounded-2xl border border-stone-200/80 hover:border-rose-300 hover:bg-rose-50/60 transition-all group flex flex-col justify-between"
            >
              <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg mb-2">
                🦴
              </div>
              <div>
                <span class="block text-xs font-black text-stone-900 group-hover:text-rose-600 transition-colors">
                  Snacks & Huesos
                </span>
                <span class="block text-[10px] text-stone-400 mt-0.5 leading-tight">
                  Premios dentales naturales
                </span>
              </div>
            </a>

            <a
              href="/categoria/cachorros"
              class="p-3 rounded-2xl border border-stone-200/80 hover:border-rose-300 hover:bg-rose-50/60 transition-all group flex flex-col justify-between"
            >
              <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg mb-2">
                🍼
              </div>
              <div>
                <span class="block text-xs font-black text-stone-900 group-hover:text-rose-600 transition-colors">
                  Cachorritos Puppy
                </span>
                <span class="block text-[10px] text-stone-400 mt-0.5 leading-tight">
                  Crecimiento y apego
                </span>
              </div>
            </a>

            <a
              href="/categoria/seniors"
              class="p-3 rounded-2xl border border-stone-200/80 hover:border-rose-300 hover:bg-rose-50/60 transition-all group flex flex-col justify-between"
            >
              <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg mb-2">
                🧓
              </div>
              <div>
                <span class="block text-xs font-black text-stone-900 group-hover:text-rose-600 transition-colors">
                  Nutrición Senior 7+
                </span>
                <span class="block text-[10px] text-stone-400 mt-0.5 leading-tight">
                  Cuidado articular suave
                </span>
              </div>
            </a>

            <a
              href="/categoria/paseo-seguridad"
              class="p-3 rounded-2xl border border-stone-200/80 hover:border-rose-300 hover:bg-rose-50/60 transition-all group flex flex-col justify-between"
            >
              <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg mb-2">
                🦮
              </div>
              <div>
                <span class="block text-xs font-black text-stone-900 group-hover:text-rose-600 transition-colors">
                  Arneses & Correas
                </span>
                <span class="block text-[10px] text-stone-400 mt-0.5 leading-tight">
                  Antitirones reflectantes
                </span>
              </div>
            </a>

            <a
              href="/categoria/camas-confort"
              class="p-3 rounded-2xl border border-stone-200/80 hover:border-rose-300 hover:bg-rose-50/60 transition-all group flex flex-col justify-between"
            >
              <div class="w-9 h-9 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center text-lg mb-2">
                🛏️
              </div>
              <div>
                <span class="block text-xs font-black text-stone-900 group-hover:text-rose-600 transition-colors">
                  Camas Ortopédicas
                </span>
                <span class="block text-[10px] text-stone-400 mt-0.5 leading-tight">
                  Memory foam y descanso
                </span>
              </div>
            </a>
          </div>

          <!-- Barra de pie rápida -->
          <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
            <span>¿Buscas promociones especiales?</span>
