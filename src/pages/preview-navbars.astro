---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

// Metadatos para la página de vista previa
const pageTitle = 'Laboratorio de Navbars | Market-Pet';
const pageDescription = 'Comparador visual simultáneo de las 3 alternativas cromáticas de Navbar para Market-Pet.';
---

<BaseLayout title={pageTitle} description={pageDescription} hideHeader={true}>
  <!-- Barra Superior de Navegación del Laboratorio -->
  <div class="bg-stone-900 text-white border-b border-stone-800 sticky top-0 z-50 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded-md bg-rose-600 text-white text-xs font-black tracking-wider uppercase">
          LABORATORIO UX/UI
        </span>
        <h1 class="text-sm sm:text-base font-bold text-stone-100">
          Comparativa de Alternativas de Navbar & Modo Nocturno
        </h1>
      </div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-200 text-xs font-semibold transition-colors"
      >
        ← Volver a la Tienda
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    <!-- Introducción y Explicación de la Evaluación -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <h2 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight">
        Evalúa las 3 Alternativas de Cabecera
      </h2>
      <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
        Cada propuesta ha sido diseñada para optimizar la jerarquía visual del ecommerce, resaltar el buscador central y preparar una transición armoniosa hacia el futuro modo nocturno.
      </p>
    </div>

    <!-- ALTERNATIVA 1 -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs">
              1
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-stone-900">
              Retail Pizarra / Dark Navy ⭐
            </h3>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">
              Recomendada por UX/UI
            </span>
          </div>
          <p class="text-xs sm:text-sm text-stone-500 mt-1">
            Inspirada en los líderes mundiales de mascotas (Chewy, Amazon Pets, Tiendapet).
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="font-semibold text-stone-700">Compatibilidad Nocturna:</span>
          <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold border border-emerald-200">
            Excelente (10/10)
          </span>
        </div>
      </div>

      <!-- Renderizado en Vivo del Navbar 1 -->
      <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-300 ring-4 ring-slate-100">
        <Header variant="dark-navy" isSticky={false} />
      </div>

      <!-- Ficha Técnica y Razones de Diseño -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 text-xs">
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <p class="font-bold text-slate-900 mb-1">🔍 Máximo Foco de Búsqueda</p>
          <p class="text-slate-600 leading-relaxed">
            El buscador blanco puro contrasta con enorme fuerza sobre el fondo pizarra, guiando la mirada de inmediato al acto de compra.
          </p>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <p class="font-bold text-slate-900 mb-1">🛒 Tracción Visual del Carrito</p>
          <p class="text-slate-600 leading-relaxed">
            El botón rojo carmín de carrito y los badges de notificación resaltan con mayor luminosidad sobre azul pizarra que sobre blanco.
          </p>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <p class="font-bold text-slate-900 mb-1">🌙 Transición Cero Fricción al Modo Noche</p>
          <p class="text-slate-600 leading-relaxed">
            Al ser oscuro por defecto, la cabecera no sufre cambios bruscos al cambiar de tema, aportando una identidad institucional de alto nivel.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-end pt-1">
        <a
          href="/?navbar=dark-navy"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 shadow-md transition-all"
        >
          <span>👁️ Ver la Home completa con este Navbar</span>
          <span>→</span>
        </a>
      </div>
    </section>

    <!-- ALTERNATIVA 2 -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-amber-800 text-white flex items-center justify-center font-bold text-xs">
              2
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-stone-900">
              Cálido Natural / Warm Biscuit
            </h3>
            <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 text-xs font-bold">
              Estilo Boutique & Orgánico
            </span>
          </div>
          <p class="text-xs sm:text-sm text-stone-500 mt-1">
            Estilo acogedor enfocado en nutrición natural, cuidado holístico y ternura animal.
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="font-semibold text-stone-700">Compatibilidad Nocturna:</span>
          <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-bold border border-blue-200">
            Buena (8/10)
          </span>
        </div>
      </div>

      <!-- Renderizado en Vivo del Navbar 2 -->
      <div class="rounded-2xl overflow-hidden shadow-lg border border-[#E0D9CE] ring-4 ring-amber-50/50">
        <Header variant="warm-biscuit" isSticky={false} />
      </div>

      <!-- Ficha Técnica y Razones de Diseño -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 text-xs">
        <div class="p-3.5 rounded-xl bg-amber-50/40 border border-amber-200/60">
          <p class="font-bold text-stone-900 mb-1">🐾 Conexión Emocional & Ternura</p>
          <p class="text-stone-600 leading-relaxed">
            Los tonos arena marfil (`#FAF7F2`) suavizan el brillo de la pantalla y transmiten afecto, artesanía y cuidado respetuoso.
          </p>
        </div>
        <div class="p-3.5 rounded-xl bg-amber-50/40 border border-amber-200/60">
          <p class="font-bold text-stone-900 mb-1">🌾 Diferenciación de Marca</p>
          <p class="text-stone-600 leading-relaxed">
            Se aleja del típico retail blanco frío o corporativo azul, ideal si la tienda busca destacar por alimentos naturales y snacks saludables.
          </p>
        </div>
        <div class="p-3.5 rounded-xl bg-amber-50/40 border border-amber-200/60">
          <p class="font-bold text-stone-900 mb-1">🌙 Adaptación a Modo Noche</p>
          <p class="text-stone-600 leading-relaxed">
            En modo nocturno muta a un gris carbón cálido (`#18181B`) manteniendo una atmósfera serena y acogedora.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-end pt-1">
        <a
          href="/?navbar=warm-biscuit"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FAF7F2] text-stone-900 border border-[#D0C7B8] font-bold text-xs hover:bg-[#F1ECE3] shadow-xs transition-all"
        >
          <span>👁️ Ver la Home completa con este Navbar</span>
          <span>→</span>
        </a>
      </div>
    </section>

    <!-- ALTERNATIVA 3 -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-xs">
              3
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-stone-900">
              Brand Carmín / Retail Masivo
            </h3>
            <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800 text-xs font-bold">
              Máxima Energía Comercial
            </span>
          </div>
          <p class="text-xs sm:text-sm text-stone-500 mt-1">
            Inspirada en el retail masivo chileno (Lider, Falabella, Sodimac).
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="font-semibold text-stone-700">Compatibilidad Nocturna:</span>
          <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-700 font-bold border border-amber-200">
            Media (7/10)
          </span>
        </div>
      </div>

      <!-- Renderizado en Vivo del Navbar 3 -->
      <div class="rounded-2xl overflow-hidden shadow-lg border border-rose-300 ring-4 ring-rose-50">
        <Header variant="brand-carmin" isSticky={false} />
      </div>

      <!-- Ficha Técnica y Razones de Diseño -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 text-xs">
        <div class="p-3.5 rounded-xl bg-rose-50/60 border border-rose-200">
          <p class="font-bold text-rose-950 mb-1">🔥 Presencia Inmediata</p>
          <p class="text-rose-900/80 leading-relaxed">
            El color corporativo llena toda la banda superior, haciendo la marca sumamente reconocible y destacando ofertas flash.
          </p>
        </div>
        <div class="p-3.5 rounded-xl bg-rose-50/60 border border-rose-200">
          <p class="font-bold text-rose-950 mb-1">🏷️ Estilo Retail Chileno</p>
          <p class="text-rose-900/80 leading-relaxed">
            Sigue el modelo de las grandes cadenas de supermercados y farmacias chilenas que usan una franja vibrante superior.
          </p>
        </div>
        <div class="p-3.5 rounded-xl bg-rose-50/60 border border-rose-200">
          <p class="font-bold text-rose-950 mb-1">🌙 Adaptación a Modo Noche</p>
          <p class="text-rose-900/80 leading-relaxed">
            En modo nocturno la franja roja debe bajar de saturación (`#9F1239`) para no encandilar en habitaciones con poca luz.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-end pt-1">
        <a
          href="/?navbar=brand-carmin"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-rose-600 text-white font-bold text-xs hover:bg-rose-700 shadow-md transition-all"
        >
          <span>👁️ Ver la Home completa con este Navbar</span>
          <span>→</span>
        </a>
      </div>
    </section>

    <!-- ALTERNATIVA ACTUAL (BLANCO) -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-stone-300 text-stone-800 flex items-center justify-center font-bold text-xs">
              4
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-stone-900">
              Blanco Minimalista (Versión Actual)
            </h3>
            <span class="px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-700 text-xs font-bold">
              Limpio & Neutro
            </span>
          </div>
          <p class="text-xs sm:text-sm text-stone-500 mt-1">
            La cabecera actual sobre lienzo blanco y barra gris clara.
          </p>
        </div>
      </div>

      <!-- Renderizado en Vivo del Navbar Actual -->
      <div class="rounded-2xl overflow-hidden shadow-sm border border-stone-200 ring-4 ring-stone-50">
        <Header variant="default" isSticky={false} />
      </div>

      <div class="flex items-center justify-end pt-1">
        <a
          href="/?navbar=default"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-stone-200 text-stone-800 font-bold text-xs hover:bg-stone-300 transition-all"
        >
          <span>👁️ Ver la Home completa con este Navbar</span>
          <span>→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
