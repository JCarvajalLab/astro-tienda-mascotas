---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Metadatos para la página de vista previa
const pageTitle = 'Laboratorio de Diseño (Navbars & Footers) | Market-Pet';
const pageDescription = 'Comparador visual simultáneo de las alternativas cromáticas de Header y Footer para Market-Pet.';
---

<BaseLayout title={pageTitle} description={pageDescription} hideHeader={true} hideFooter={true}>
  <!-- Barra Superior de Navegación del Laboratorio -->
  <div class="bg-stone-900 text-white border-b border-stone-800 sticky top-0 z-50 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded-md bg-rose-600 text-white text-xs font-black tracking-wider uppercase">
          LABORATORIO UX/UI
        </span>
        <h1 class="text-sm sm:text-base font-bold text-stone-100">
          Laboratorio de Diseño: Cabeceras (Navbars) y Pies de Página (Footers)
        </h1>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="#navbars"
          class="px-3 py-1 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-300 text-xs font-semibold transition-colors"
        >
          Navbars ↑
        </a>
        <a
          href="#footers"
          class="px-3 py-1 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-300 text-xs font-semibold transition-colors"
        >
          Footers ↓
        </a>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition-colors"
        >
          ← Volver a la Tienda
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-24">
    <!-- ==========================================
         SECCIÓN 1: CABECERAS (NAVBARS)
         ========================================== -->
    <div id="navbars" class="space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-900 text-xs font-bold border border-amber-200">
          <span>✨</span>
          <span>NAVBAR PREDETERMINADO ACTUALIZADO A: WARM BISCUIT</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight">
          1. Alternativas de Cabecera (Navbar)
        </h2>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
          Compara cómo se comporta cada encabezado y su interacción con el buscador, el carrito y el futuro modo nocturno.
        </p>
      </div>

      <!-- NAVBAR OPCIÓN 2 (ACTUAL PREDETERMINADO) -->
      <section class="space-y-4 p-6 rounded-3xl bg-amber-50/30 border-2 border-amber-300 shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-amber-200 pb-3">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-amber-800 text-white flex items-center justify-center font-bold text-xs">
                ★
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-stone-900">
                Cálido Natural / Warm Biscuit
              </h3>
              <span class="px-3 py-1 rounded-full bg-emerald-600 text-white text-xs font-black shadow-xs">
                ✓ PREDETERMINADO ACTIVO
              </span>
              <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 text-xs font-bold">
                Boutique Orgánica
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-600 mt-1">
              Estilo acogedor enfocado en nutrición natural, cuidado holístico y calidez artesanal.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="font-semibold text-stone-700">Compatibilidad Nocturna:</span>
            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-bold border border-emerald-200">
              Buena (8/10)
            </span>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-lg border border-[#E0D9CE] ring-4 ring-amber-100">
          <Header variant="warm-biscuit" isSticky={false} />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 text-xs">
          <div class="p-3.5 rounded-xl bg-white border border-amber-200/80 shadow-2xs">
            <p class="font-bold text-stone-900 mb-1">🐾 Conexión Emocional & Ternura</p>
            <p class="text-stone-600 leading-relaxed">
              Los tonos arena marfil (`#FAF7F2`) suavizan el brillo de pantalla y transmiten afecto y bienestar.
            </p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-amber-200/80 shadow-2xs">
            <p class="font-bold text-stone-900 mb-1">🌾 Diferenciación de Marca</p>
            <p class="text-stone-600 leading-relaxed">
              Se aleja del retail frío corporativo; evoca alimentos frescos, descanso cómodo y marcas premium.
            </p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-amber-200/80 shadow-2xs">
            <p class="font-bold text-stone-900 mb-1">🌙 Adaptación a Modo Noche</p>
            <p class="text-stone-600 leading-relaxed">
              En modo nocturno muta a un gris carbón cálido (`#18181B`) manteniendo una atmósfera serena.
            </p>
          </div>
        </div>

        <div class="flex items-center justify-end pt-1">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-stone-900 text-white font-bold text-xs hover:bg-black shadow-md transition-all"
          >
            <span>👁️ Ver la Tienda con este Navbar Predeterminado</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- NAVBAR OPCIÓN 1 (DARK NAVY) -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs">
                1
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-stone-900">
                Retail Pizarra / Dark Navy
              </h3>
              <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-800 text-xs font-bold">
                Inspirado en Chewy / Amazon Pets
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-500 mt-1">
              Fondo azul pizarra oscuro con buscador de alto contraste y carrito llamativo.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="font-semibold text-stone-700">Compatibilidad Nocturna:</span>
            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold border border-emerald-200">
              Excelente (10/10)
            </span>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-300 ring-4 ring-slate-100">
          <Header variant="dark-navy" isSticky={false} />
        </div>

        <div class="flex items-center justify-end pt-1">
          <a
            href="/?navbar=dark-navy"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 shadow-md transition-all"
          >
            <span>👁️ Probar Dark Navy en la Home</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- NAVBAR OPCIÓN 3 (BRAND CARMÍN) -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-xs">
                3
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-stone-900">
                Brand Carmín / Retail Masivo
              </h3>
              <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800 text-xs font-bold">
                Estilo Retail Chileno
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-500 mt-1">
              Banda superior roja con gran energía comercial e impacto de marca inmediato.
            </p>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-lg border border-rose-300 ring-4 ring-rose-50">
          <Header variant="brand-carmin" isSticky={false} />
        </div>

        <div class="flex items-center justify-end pt-1">
          <a
            href="/?navbar=brand-carmin"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-rose-600 text-white font-bold text-xs hover:bg-rose-700 shadow-md transition-all"
          >
            <span>👁️ Probar Brand Carmín en la Home</span>
            <span>→</span>
          </a>
        </div>
      </section>
    </div>

    <!-- ==========================================
         SECCIÓN 2: PIES DE PÁGINA (FOOTERS)
         ========================================== -->
    <div id="footers" class="space-y-12 pt-8 border-t-2 border-stone-200">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="px-3 py-1 rounded-full bg-stone-900 text-white text-xs font-black tracking-wider uppercase">
          EVALUACIÓN DE FOOTERS
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight">
          2. Alternativas de Pie de Página (Footer)
        </h2>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
          Elige cómo deseas cerrar visualmente la tienda: en armonía cálida con el nuevo Navbar, con un fondo oscuro de anclaje firme, o con tonos tecnológicos.
        </p>
      </div>

      <!-- FOOTER ALTERNATIVA 1: WARM BISCUIT (COORDINADO CON NAVBAR) -->
      <section class="space-y-4 p-6 rounded-3xl bg-[#FAF7F2]/60 border-2 border-[#DCD5C8] shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#E0D9CE] pb-3">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-amber-800 text-white flex items-center justify-center font-bold text-xs">
                F1
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-stone-900">
                Cálido Natural / Warm Biscuit ⭐
              </h3>
              <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 text-xs font-bold">
                Coordinado con el nuevo Navbar
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-600 mt-1">
              Fondo marfil cálido (`#FAF7F2`) con botones de redes en blanco relieve y sellos de pago sobre arena suave.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="font-semibold text-stone-700">Armonía Visual:</span>
            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-bold border border-emerald-200">
              Simetría Perfecta (10/10)
            </span>
          </div>
        </div>

        <!-- Renderizado en Vivo del Footer Warm Biscuit -->
        <div class="rounded-2xl overflow-hidden shadow-md border border-[#E0D9CE]">
          <Footer variant="warm-biscuit" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 text-xs">
          <div class="p-3.5 rounded-xl bg-white border border-[#E0D9CE]">
            <p class="font-bold text-stone-900 mb-1">🤝 Coherencia Extremo a Extremo</p>
            <p class="text-stone-600 leading-relaxed">
              El inicio (Navbar) y el final (Footer) comparten exactamente la misma gama cálida, creando una identidad de marca 100% cohesionada.
            </p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-[#E0D9CE]">
            <p class="font-bold text-stone-900 mb-1">🌿 Atmósfera Amigable</p>
            <p class="text-stone-600 leading-relaxed">
              Evita el "corte brusco" negro al final de la página; el usuario siente que navega por una tienda acogedora y luminosa.
            </p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-[#E0D9CE]">
            <p class="font-bold text-stone-900 mb-1">🌙 En Modo Nocturno</p>
            <p class="text-stone-600 leading-relaxed">
              Tanto el Header como el Footer pasarán en bloque al modo nocturno con el mismo gris carbón cálido (`#18181B`).
            </p>
          </div>
        </div>

        <div class="flex items-center justify-end pt-1">
          <a
            href="/?footer=warm-biscuit"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-stone-900 text-white font-bold text-xs hover:bg-black shadow-md transition-all"
          >
            <span>👁️ Probar este Footer Warm Biscuit en la Home</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- FOOTER ALTERNATIVA 2: DARK STONE (ACTUAL) -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-stone-900 text-white flex items-center justify-center font-bold text-xs">
                F2
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-stone-900">
                Dark Stone / Carbón Profundo (Opción Actual)
              </h3>
              <span class="px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-800 text-xs font-bold">
                Anclaje Clásico
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-500 mt-1">
              Fondo oscuro (`bg-stone-900`) que actúa como "peso visual" firme al pie de la página.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="font-semibold text-stone-700">Contraste de Cierre:</span>
            <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-800 font-bold border border-blue-200">
              Muy Fuerte (9/10)
            </span>
          </div>
        </div>

        <!-- Renderizado en Vivo del Footer Dark Stone -->
        <div class="rounded-2xl overflow-hidden shadow-xl border border-stone-800">
          <Footer variant="default" />
        </div>

        <div class="flex items-center justify-end pt-1">
          <a
            href="/?footer=default"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-stone-900 text-white font-bold text-xs hover:bg-stone-800 shadow-md transition-all"
          >
            <span>👁️ Probar Footer Dark Stone en la Home</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- FOOTER ALTERNATIVA 3: DEEP SLATE -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-slate-950 text-white flex items-center justify-center font-bold text-xs">
                F3
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-stone-900">
                Deep Slate / Azul Pizarra Tecnológico
              </h3>
              <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-800 text-xs font-bold">
                Elegante & Seguro
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-500 mt-1">
              Azul pizarra profundo (`bg-slate-950`) que transmite máxima seguridad bancaria e institucional.
            </p>
          </div>
        </div>

        <!-- Renderizado en Vivo del Footer Deep Slate -->
        <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-900">
          <Footer variant="deep-slate" />
        </div>

        <div class="flex items-center justify-end pt-1">
          <a
            href="/?footer=deep-slate"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-950 text-white font-bold text-xs hover:bg-slate-900 shadow-md transition-all"
          >
            <span>👁️ Probar Footer Deep Slate en la Home</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- FOOTER ALTERNATIVA 4: SOFT GREIGE -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 pb-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-stone-300 text-stone-800 flex items-center justify-center font-bold text-xs">
                F4
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-stone-900">
                Soft Greige / Gris Cálido Luminoso
              </h3>
              <span class="px-2.5 py-0.5 rounded-full bg-stone-200 text-stone-700 text-xs font-bold">
                Minimalista Claro
              </span>
            </div>
            <p class="text-xs sm:text-sm text-stone-500 mt-1">
              Fondo gris neutro suave (`bg-stone-100`) para una apariencia ligera y poco invasiva.
            </p>
          </div>
        </div>

        <!-- Renderizado en Vivo del Footer Soft Greige -->
        <div class="rounded-2xl overflow-hidden shadow-sm border border-stone-200">
          <Footer variant="soft-greige" />
        </div>

        <div class="flex items-center justify-end pt-1">
          <a
            href="/?footer=soft-greige"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-stone-200 text-stone-800 font-bold text-xs hover:bg-stone-300 transition-all"
          >
            <span>👁️ Probar Footer Soft Greige en la Home</span>
            <span>→</span>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
